function Tacho:Update(stats)
	if type(stats) ~= "table" then
		return
	end
	if not ready() then
		return
	end

	local st = state

	if not visible then
		st.lastclock = nil
		st.lastvel = nil
		return
	end

	local now = os.clock()
	local dt = st.lastclock and (now - st.lastclock) or 1 / 60
	if dt < 0.002 then
		return
	end
	dt = math.min(dt, maxdt)
	st.lastclock = now

	st.rpm = num(stats.RPM, st.rpm)
	st.maxrpm = math.max(num(stats.MaxRPM, st.maxrpm), 1)
	st.redlinerpm = num(stats.RedlineRPM, st.redlinerpm)
	st.speedtarget = num(stats.KMH, st.speedtarget)

	local throttle = math.clamp(num(stats.Throttle, 0), 0, 1)
	local brake = math.clamp(num(stats.Brake, 0), 0, 1)

	updateneedle(dt)
	updateredline(dt)
	updaterev(dt, throttle, brake)
	updatemotion(dt, stats.Velocity)
	updatespeed(dt, st.speedtarget)
	updategear(dt, stats.Gear)
end

function Tacho:Visability(show)
	visible = show == true
	if gui then
		gui.Enabled = visible
	end
end

function Tacho:Clear()
	local target = gui or Tacho.Gui
	if target then
		target:Destroy()
	end

	release()
	state = newstate()
	Tacho.Gui = nil
	visible = true
	nextbind = 0
end

return Tacho
