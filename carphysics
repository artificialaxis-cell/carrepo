local function smoothing(rate, dt)
	return 1 - math.exp(-rate * dt)
end

local function smooth01(x)
	x = math.clamp(x, 0, 1)
	return x * x * (3 - 2 * x)
end

local function lerp(a, b, t)
	return a + (b - a) * t
end

------------------------------------------------------------------------------------------
-- Engine
------------------------------------------------------------------------------------------

local Engine = {}
Engine.__index = Engine

function Engine.new(cfg)
	local self = setmetatable({}, Engine)
	self.omega = (cfg.idleRPM or 900) / TO_RPM
	self.stalled = false
	self.limiting = false
	self.lastcomb = 0
	self.lastnet = 0
	self:configure(cfg)
	return self
end

function Engine:configure(cfg)
	self.idlerpm = cfg.idleRPM or 900
	self.redline = cfg.redlineRPM or 7000
	self.inertia = cfg.inertia or 0.15

	local rpms = {}
	for rpm in pairs(cfg.torqueCurve) do
		table.insert(rpms, rpm)
	end
	table.sort(rpms)
	assert(#rpms >= 2, "Engine requires at least 2 torqueCurve points")
	local values = {}
	for i, rpm in ipairs(rpms) do
		values[i] = cfg.torqueCurve[rpm]
	end
	self.points = rpms
	self.values = values
	self.segment = 1

	local fr = cfg.friction or {}
	self.staticfric = fr.static or 12
	self.viscous = fr.viscous or 0.010
	self.pumping = fr.pumpingLossCoefficient or 0.0009
	self.accessory = cfg.accessoryTorque or 6

	local idle = cfg.idleControl or {}
	self.idleenabled = idle.enabled ~= false
	self.idletarget = idle.targetRPM or self.idlerpm
	self.idleauthority = idle.authority or 0.55
	self.stallrpm = idle.stallRPM or (self.idlerpm * 0.35)

	local limiter = cfg.revLimiter or {}
	self.limitrpm = limiter.rpm or self.redline
	self.limitcut = limiter.cut or 1
	self.limithyst = limiter.hysteresis or 120
end

function Engine:torqueAt(rpm)
	local pts, vals = self.points, self.values
	local n = #pts
	if rpm <= pts[1] then
		return vals[1]
	elseif rpm >= pts[n] then
		return vals[n]
	end
	local i = self.segment
	if not (i < n and pts[i] <= rpm and rpm <= pts[i + 1]) then
		local lo, hi = 1, n - 1
		while lo < hi do
			local mid = (lo + hi + 1) // 2
			if pts[mid] <= rpm then
				lo = mid
			else
				hi = mid - 1
			end
		end
		i = lo
		self.segment = i
	end
	local a, b = pts[i], pts[i + 1]
	return vals[i] + (vals[i + 1] - vals[i]) * ((rpm - a) / (b - a))
end

function Engine:update(dt, throttle, load)
	local rpm = self.omega * TO_RPM

	-- idle control: feedforward that exactly covers the losses at the target speed (so the
	-- target is an equilibrium), faded out just above it, plus proportional correction
	local idlethrottle = 0
	local target = self.idletarget
	if self.idleenabled and rpm < target * 1.05 then
		local w = target / TO_RPM
		local losses = self.staticfric + self.viscous * w + self.accessory
		local pump = self.pumping * w * w
		local feed = (losses + pump) / math.max(self:torqueAt(target) + pump, 1)
		local fade = math.clamp((target * 1.05 - rpm) / (target * 0.05), 0, 1)
		local p = math.max(target - rpm, 0) / target * self.idleauthority * 2
		idlethrottle = math.clamp(feed * fade + p, 0, 1)
	end
	local thr = math.max(math.clamp(throttle, 0, 1), idlethrottle)

	if rpm >= self.limitrpm then
		self.limiting = true
	elseif rpm < self.limitrpm - self.limithyst then
		self.limiting = false
	end
	if self.limiting then
		thr *= 1 - self.limitcut
	end

	local comb = self.stalled and 0 or self:torqueAt(rpm) * thr
	local fric = self.staticfric + self.viscous * self.omega
	local pump = self.pumping * (1 - thr) * self.omega * self.omega
	local net = comb - fric - pump - self.accessory - load

	if not self.stalled and rpm < self.stallrpm and net < 0 then
		self.stalled = true
		comb = 0
		net = -fric - pump - load
	end

	self.omega = math.max(self.omega + net / self.inertia * dt, 0)
	self.lastcomb = comb
	self.lastnet = net
end

function Engine:restart()
	if self.omega < self.stallrpm / TO_RPM then
		self.omega = self.idlerpm / TO_RPM
	end
	self.stalled = false
end

------------------------------------------------------------------------------------------
-- Clutch: transmits whatever torque synchronises engine and driveline this step, up to
-- its capacity.
------------------------------------------------------------------------------------------

local Clutch = {}
Clutch.__index = Clutch

function Clutch.new(cfg)
	local self = setmetatable({ slip = 0 }, Clutch)
	self:configure(cfg)
	return self
end

function Clutch:configure(cfg)
	self.maxtorque = cfg.maxTorque or 380
end

function Clutch:update(dt, eomega, einertia, tomega, reflected, pedal)
	local cap = self.maxtorque * math.clamp(1 - pedal, 0, 1)
	self.slip = eomega - tomega
	if cap <= 0.001 or reflected <= 0 or einertia <= 0 then
		return 0
	end
	local combined = (einertia * reflected) / (einertia + reflected)
	return math.clamp(self.slip * combined / dt, -cap, cap)
end

------------------------------------------------------------------------------------------
-- Gearbox
------------------------------------------------------------------------------------------

local Gearbox = {}
Gearbox.__index = Gearbox

function Gearbox.new(cfg)
	local self = setmetatable({ gear = 0, pending = 0, shifting = false, timer = 0 }, Gearbox)
	self:configure(cfg)
	return self
end

function Gearbox:configure(cfg)
	self.gears = cfg.gears
	self.finaldrive = cfg.finalDrive or 3.9
	self.eff = cfg.efficiency or 0.94
	self.shifttime = cfg.shiftTime or 0.18
	self.mingear, self.maxgear = 0, 0
	for g in pairs(self.gears) do
		if type(g) == "number" then
			self.mingear = math.min(self.mingear, g)
			self.maxgear = math.max(self.maxgear, g)
		end
	end
	if self.gears[self.gear] == nil then
		self.gear = math.clamp(self.gear, self.mingear, self.maxgear)
	end
	if self.shifting and self.gears[self.pending] == nil then
		self.shifting = false
	end
end

function Gearbox:ratio(gear)
	return self.gears[gear or self.gear] or 0
end

function Gearbox:request(gear)
	if self.gears[gear] == nil or self.shifting or gear == self.gear then
		return false
	end
	self.pending = gear
	self.shifting = true
	self.timer = self.shifttime
	return true
end

function Gearbox:update(dt)
	if self.shifting then
		self.timer -= dt
		if self.timer <= 0 then
			self.gear = self.pending
			self.shifting = false
		end
	end
end

function Gearbox:outtorque(input)
	if self.shifting then
		return 0
	end
	return input * self:ratio() * self.finaldrive * self.eff
end

function Gearbox:totalratio()
	return self:ratio() * self.finaldrive
end

------------------------------------------------------------------------------------------
-- Differential. `bias` is the static share sent to side A (0.5 for axle diffs, the AWD
-- front share for centre diffs); locking terms act on top of it.
------------------------------------------------------------------------------------------

local Diff = {}
Diff.__index = Diff

function Diff.new(cfg)
	local self = setmetatable({}, Diff)
	self:configure(cfg)
	return self
end

function Diff:configure(cfg)
	self.kind = tostring(cfg.type or "OPEN"):upper()
	self.preload = cfg.preload or 15
	self.powerlock = cfg.powerLock or 0.35
	self.coastlock = cfg.coastLock or 0.15
	self.maxbias = cfg.maxBias or 3
end

function Diff:split(dt, input, wa, wb, ia, ib, bias)
	bias = bias or 0.5
	local a, b = input * bias, input * (1 - bias)
	if self.kind == "OPEN" then
		return a, b
	end

	local wdiff = wa - wb
	local biascap = math.abs(input) * (self.maxbias - 1) * 0.5

	if self.kind == "LOCKED" or self.kind == "WELDED" then
		local x = math.max(ia or 1, 0.01)
		local y = math.max(ib or 1, 0.01)
		local combined = (x * y) / (x + y)
		local lock = math.clamp(wdiff * combined / dt, -biascap, biascap)
		return a - lock, b + lock
	end

	local lockfrac = input >= 0 and self.powerlock or self.coastlock
	local speedterm = math.clamp(wdiff * 6, -1, 1)
	local lock = math.clamp((math.abs(input) * lockfrac + self.preload) * speedterm, -biascap, biascap)
	return a - lock, b + lock
end

