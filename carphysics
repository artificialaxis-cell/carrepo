local function pacejkaCoeffs(axis, roadMu, Fz)
	local loadRatio = Fz / axis.Fz0

	local mu = roadMu * (1 - axis.muLoadSensitivity * (loadRatio - 1))
	local D = math.max(mu, 0) * Fz

	local stiffnessPerNewton = axis.stiffnessPerNewton * (1 - axis.stiffnessLoadSensitivity * (loadRatio - 1))
	local BCD = math.max(stiffnessPerNewton, 0) * Fz

	local C = axis.C
	local B = BCD / math.max(C * D, 1e-6)

	return B, C, D, axis.E
end

local function pacejkaForce(slip, axis, B, C, D, E)
	local clampedSlip = math.clamp(slip, -axis.maxSlip, axis.maxSlip)
	local Bx = B * clampedSlip
	return D * math.sin(C * math.atan(Bx - E * (Bx - math.atan(Bx))))
end

local RELAX_FLOOR_MPS = 0.6 

local function relaxedSlip(lagState, key, targetSlip, speedMps, relaxationLength, dt)
	local rate = math.max(math.abs(speedMps), RELAX_FLOOR_MPS) / relaxationLength
	lagState[key] = smoothTo(lagState[key] or 0, targetSlip, rate, dt)
	return lagState[key]
end

local function tireCurve(slip, params)
	local clampedSlip = math.clamp(slip, -params.maxSlip, params.maxSlip)
	local bx = params.B * clampedSlip
	return math.sin(params.C * math.atan(bx - params.E * (bx - math.atan(bx))))
end

function Grip.Update(tireInfo, surfaceSpeedStuds, smoothedLoad, dt, axleLoadDeltaNewtons)
	local tire = tireInfo.tire
	local car = tireInfo.car
	local folder = tireInfo.folder
	local contactPosition = tireInfo.CPos
	local groundMaterial = tireInfo.grM

	local forwardDir = tire.CFrame.LookVector
	forwardDir = Vector3.new(forwardDir.X, 0, forwardDir.Z).Unit
	local rightDir = tire.CFrame.RightVector
	rightDir = Vector3.new(rightDir.X, 0, rightDir.Z).Unit

	local staticLoadNewtons = ((car.Mass.AssemblyMass) * workspace.Gravity / Units.ForceScale) / 4
	local targetLoadNewtons = math.max(staticLoadNewtons + (axleLoadDeltaNewtons or 0), 0)

	local wheelName = folder.Name
	smoothedLoad[wheelName] = smoothTo(smoothedLoad[wheelName], targetLoadNewtons, 12, dt)
	local verticalLoadNewtons = smoothedLoad[wheelName]

	local roadMu = MU_LOOKUP[groundMaterial] or 0.6

	local contactOffset = contactPosition - tire.Position
	local velocityAtContact = tire.AssemblyLinearVelocity + tire.AssemblyAngularVelocity:Cross(contactOffset)

	local longitudinalVelStuds = velocityAtContact:Dot(forwardDir)
	local lateralVelStuds = velocityAtContact:Dot(rightDir)

	local referenceSpeed = math.max(
		math.abs(longitudinalVelStuds),
		math.abs(surfaceSpeedStuds),
		LOW_SPEED_REFERENCE
	)

	local slipRatio = (surfaceSpeedStuds - longitudinalVelStuds) / referenceSpeed
	local slipAngle = math.atan2(
		lateralVelStuds,
		math.max(math.abs(longitudinalVelStuds), LOW_SPEED_REFERENCE)
	)

	slipRatio = math.clamp(slipRatio, -LONGITUDINAL.maxSlip, LONGITUDINAL.maxSlip)
	slipAngle = math.clamp(slipAngle, -LATERAL.maxSlip, LATERAL.maxSlip)

	local isStationary = math.abs(longitudinalVelStuds) < STATIONARY_THRESHOLD
		and math.abs(surfaceSpeedStuds) < STATIONARY_THRESHOLD
		and math.abs(lateralVelStuds) < STATIONARY_THRESHOLD

	local longitudinalSpeedMps = Units.StudsPerSecToMps(longitudinalVelStuds)

	local Bx, Cx, Dx, Ex = pacejkaCoeffs(LONGITUDINAL, roadMu, verticalLoadNewtons)
	local By, Cy, Dy, Ey = pacejkaCoeffs(LATERAL, roadMu, verticalLoadNewtons)

	if Dx <= 0 or Dy <= 0 then
		tire.FrictionForce.Force = Vector3.zero
		return 0, 0, 0
	end

	local frictionForceNewtons

	if isStationary then
		local driveSlip = math.clamp(surfaceSpeedStuds / LOW_SPEED_REFERENCE, -1, 1)

		local driveFx = pacejkaForce(driveSlip, LONGITUDINAL, Bx, Cx, Dx, Ex)
		local holdFx = -longitudinalVelStuds * roadMu * STATIC_DAMPING
		local holdFy = -lateralVelStuds * roadMu * STATIC_DAMPING

		local totalFx = driveFx + holdFx
		local totalFy = holdFy

		local ellipse = math.sqrt((totalFx / Dx)^2 + (totalFy / Dy)^2)
		if ellipse > 1 then
			totalFx /= ellipse
			totalFy /= ellipse
		end

		frictionForceNewtons = forwardDir * totalFx + rightDir * totalFy
	else
		tireSlipLag[wheelName] = tireSlipLag[wheelName] or { x = 0, y = 0 }

		local lagX = relaxedSlip(
			tireSlipLag[wheelName],
			"x",
			slipRatio,
			longitudinalSpeedMps,
			LONGITUDINAL.relaxationLength,
			dt
		)

		local lagY = relaxedSlip(
			tireSlipLag[wheelName],
			"y",
			slipAngle,
			longitudinalSpeedMps,
			LATERAL.relaxationLength,
			dt
		)

		local Fx = pacejkaForce(lagX, LONGITUDINAL, Bx, Cx, Dx, Ex)
		local Fy = pacejkaForce(lagY, LATERAL, By, Cy, Dy, Ey)

		local ellipse = math.sqrt((Fx / Dx)^2 + (Fy / Dy)^2)
		if ellipse > 1 then
			Fx /= ellipse
			Fy /= ellipse
		end

		frictionForceNewtons = forwardDir * Fx - rightDir * Fy
	end

	tire.FrictionForce.Force = frictionForceNewtons * Units.ForceScale

	local normalizedSlipAngle = math.abs(slipAngle) / LATERAL.maxSlip
	local totalSlip = math.sqrt(slipRatio * slipRatio + normalizedSlipAngle * normalizedSlipAngle)

	local forceAttachment = tire:FindFirstChild("ForceAtt")
	if forceAttachment then
		local smoke = forceAttachment:FindFirstChild("TireSmoke")
		local skid = forceAttachment:FindFirstChild("Skid")
		local slipping = totalSlip > SLIP_SMOKE_START and tire.AssemblyLinearVelocity.Magnitude > 1

		if smoke then
			smoke.Rate = slipping and (50 * math.min(totalSlip, 2)) or 0
		end

		if skid then
			skid.Volume = slipping and (0.5 * totalSlip) or 0
			skid.PlaybackSpeed = slipping and (0.85 + 0.4 * totalSlip) or 0
		end
	end

	car:SetAttribute(wheelName .. "totalSlip", totalSlip)

	local stiffnessReference = isStationary and LOW_SPEED_REFERENCE or referenceSpeed
	local longitudinalStiffness = Dx * (Bx * Cx) / math.max(stiffnessReference, 0.01)

	local forwardForceNewtons = frictionForceNewtons:Dot(forwardDir)

	return forwardForceNewtons, verticalLoadNewtons, longitudinalStiffness
end

local RenameTable = {
	["ForceAtt"] = { "ForceAtt_2", "ForceAtt_3", "ForceAtt_4" },
	["SteerSlide"] = { "SteerSlide_2" },
	["TIREEND"] = { "TIREEND_2", "TIREEND_3", "TIREEND_4" },
	["TIRESTART"] = { "TIRESTART_2", "TIRESTART_3", "TIRESTART_4" },
	["SpinAtt"] = { "SpinAtt_2", "SpinAtt_3", "SpinAtt_4" },
}

local function RenameClones(parent)
	for originalName, clones in pairs(RenameTable) do
		for _, cloneName in ipairs(clones) do
			local child = parent:FindFirstChild(cloneName, true)
			if child then
				child.Name = originalName
			end
		end
	end
end

local function validateCar(car)
	for _, name in ipairs(REQUIRED_CHILDREN) do
		if not car:FindFirstChild(name) then
			warn(string.format("CarController: %s is missing '%s'", car:GetFullName(), name))
			return nil
		end
	end

	for _, name in ipairs(REQUIRED_ATTRIBUTES) do
		if typeof(car:GetAttribute(name)) ~= "number" then
			warn(string.format("CarController: %s is missing numeric attribute '%s'", car:GetFullName(), name))
			return nil
		end
	end

	RenameClones(car)

	local mass = car.Mass
	local primary = car.Primary

	if not (mass:IsA("BasePart") and primary:IsA("BasePart")) then
		warn(string.format("CarController: %s has Mass or Primary of the wrong type", car:GetFullName()))
		return nil
	end

	local driverMass = car:FindFirstChild("DriverMass")
	if driverMass and not driverMass:IsA("BasePart") then
		driverMass = nil
	end

	local drag = mass:FindFirstChild("Drag")
	if drag and not drag:IsA("VectorForce") then
		drag = nil
	end

	local steerSlide = primary:FindFirstChild("SteerSlide")
	if steerSlide and not steerSlide:IsA("Attachment") then
		steerSlide = nil
	end

	return {
		wheels = car.Wheels,
		mass = mass,
		primary = primary,
		throttleValue = car.Throttle,
		brakeValue = car.Brake,
		clutchValue = car.Clutch,
		steerValue = car.Steer,
		driverMass = driverMass,
		drag = drag,
		steerSlide = steerSlide,
	}
end

local function toggleCollisions(targetCharacter, enabled, cache)
	if not targetCharacter then
		return
	end

	if enabled then
		for part, originalValue in pairs(cache) do
			if part.Parent then
				part.CanCollide = originalValue
			end
		end
		table.clear(cache)
	else
		for _, part in ipairs(targetCharacter:GetDescendants()) do
			if part:IsA("BasePart") then
				cache[part] = part.CanCollide
				part.CanCollide = false
			end
		end
	end
end

local function findLimbJoint(character, limbName)
	local torso = character:FindFirstChild("Torso")
	if not torso then
		return nil
	end
	for _, joint in ipairs(torso:GetChildren()) do
		if joint:IsA("Motor6D") and joint.Part1 and joint.Part1.Name == limbName then
			return joint
		end
	end
	return nil
end

local function findRootJoint(character)
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return nil
	end
	for _, joint in ipairs(hrp:GetChildren()) do
		if joint:IsA("Motor6D") then
			return joint
		end
	end
	return nil
end

