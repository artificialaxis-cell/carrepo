local function grab(url)
	local ok, src = pcall(game.HttpGet, game, url)
	if not ok then error("couldn't fetch " .. url .. ": " .. tostring(src)) end

	local chunk, err = loadstring(src)
	if not chunk then error("bad chunk from " .. url .. ": " .. tostring(err)) end

	local ok2, mod = pcall(chunk)
	if not ok2 then error("module blew up (" .. url .. "): " .. tostring(mod)) end
	return mod
end

