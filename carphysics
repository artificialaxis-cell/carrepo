local Units = {}
Units.StudsToMeters = 0.28
Units.MetersToStuds = 1 / Units.StudsToMeters

Units.MassScale = 2853 / 1500
Units.ForceScale = Units.MassScale / Units.StudsToMeters

function Units.RobloxForceToNewtons(robloxForce)
	return robloxForce / Units.ForceScale
end

function Units.RadPerSecToRPM(omega)
	return omega * 60 / (2 * math.pi)
end

function Units.RPMToRadPerSec(rpm)
	return rpm * 2 * math.pi / 60
end

function Units.MpsToStudsPerSec(mps)
	return mps * Units.MetersToStuds
end

function Units.StudsPerSecToMps(sps)
	return sps * Units.StudsToMeters
end

local function lerp(a, b, t)
	return a + (b - a) * math.clamp(t, 0, 1)
end

local function smoothTo(current, target, rate, dt)
	local alpha = 1 - math.exp(-math.max(rate, 0) * dt)
	return current + (target - current) * alpha
end

local function flatten(vector, fallback)
	local flat = Vector3.new(vector.X, 0, vector.Z)
	if flat.Magnitude < 0.01 then
		return fallback
	end
	return flat.Unit
end

local function approach(current, target, speed, dt)
	if current < target then
		return math.min(current + speed * dt, target)
	elseif current > target then
		return math.max(current - speed * dt, target)
	end
	return current
end

local Engine = {}
Engine.__index = Engine

function Engine.new(config)
	local self = setmetatable({}, Engine)

	self.idleRPM = config.idleRPM or 900
	self.redlineRPM = config.redlineRPM or 7000
	self.inertia = config.inertia or 0.15

	self.torqueCurve = config.torqueCurve
	self.torquePoints = {}
	for rpm in pairs(self.torqueCurve) do
		table.insert(self.torquePoints, rpm)
	end
	table.sort(self.torquePoints)
	assert(#self.torquePoints >= 2, "Engine requires at least 2 torqueCurve points")

	local friction = config.friction or {}

	self.staticFriction = friction.static or 12

	self.viscous = friction.viscous or 0.010

	self.pumpingLossCoefficient = friction.pumpingLossCoefficient or 0.0009

	self.accessoryTorque = config.accessoryTorque or 6

	self.idleControl = config.idleControl or {}
	if self.idleControl.enabled == nil then
		self.idleControl.enabled = true
	end
	self.idleControl.targetRPM = self.idleControl.targetRPM or self.idleRPM
	self.idleControl.authority = self.idleControl.authority or 0.55
	self.idleControl.stallRPM = self.idleControl.stallRPM or (self.idleRPM * 0.35)

	self.revLimiter = config.revLimiter or {}
	self.revLimiter.rpm = self.revLimiter.rpm or self.redlineRPM
	self.revLimiter.cut = self.revLimiter.cut or 1.0
	self.revLimiter.hysteresis = self.revLimiter.hysteresis or 120

	self.omega = Units.RPMToRadPerSec(self.idleRPM)
	self.stalled = false
	self.limiterActive = false
	self.lastCombustionTorque = 0
	self.lastNetTorque = 0

	return self
end

function Engine:_combustionTorqueAt(rpm, throttle)
	local points = self.torquePoints
	local curve = self.torqueCurve
	local maxTorque

	if rpm <= points[1] then
		maxTorque = curve[points[1]]
	elseif rpm >= points[#points] then
		maxTorque = curve[points[#points]]
	else
		maxTorque = curve[points[#points]]
		for i = 1, #points - 1 do
			local lo, hi = points[i], points[i + 1]
			if rpm >= lo and rpm <= hi then
				local alpha = (rpm - lo) / (hi - lo)
				maxTorque = curve[lo] + (curve[hi] - curve[lo]) * alpha
				break
			end
		end
	end

	return maxTorque * math.clamp(throttle, 0, 1)
end

function Engine:Update(dt, throttle, loadTorque)
	loadTorque = loadTorque or 0
	local rpm = self:GetRPM()

	local idleThrottle = 0
	if self.idleControl.enabled and rpm < self.idleControl.targetRPM * 1.05 then
		local deficit = (self.idleControl.targetRPM - rpm) / self.idleControl.targetRPM
		idleThrottle = math.clamp(deficit * self.idleControl.authority, 0, 1)
	end
	local effectiveThrottle = math.max(math.clamp(throttle, 0, 1), idleThrottle)

	if rpm >= self.revLimiter.rpm then
		self.limiterActive = true
	elseif rpm < self.revLimiter.rpm - self.revLimiter.hysteresis then
		self.limiterActive = false
	end
	if self.limiterActive then
		effectiveThrottle = effectiveThrottle * (1 - self.revLimiter.cut)
	end

	local combustionTorque = self:_combustionTorqueAt(rpm, effectiveThrottle)
	local frictionTorque = self.staticFriction + self.viscous * self.omega
	local throttleRestriction = 1 - effectiveThrottle
	local pumpingLoss = self.pumpingLossCoefficient * throttleRestriction * self.omega * self.omega

	if self.stalled then
		combustionTorque = 0
	end

	local netTorque = combustionTorque - frictionTorque - pumpingLoss - self.accessoryTorque - loadTorque

	if not self.stalled and rpm < self.idleControl.stallRPM and netTorque < 0 then
		self.stalled = true
		combustionTorque = 0
		netTorque = -frictionTorque - pumpingLoss - loadTorque
	end

	local angularAcceleration = netTorque / self.inertia
	self.omega = math.max(self.omega + angularAcceleration * dt, 0)

	self.lastCombustionTorque = combustionTorque
	self.lastNetTorque = netTorque

	return self.omega
end

function Engine:Restart()
	if self.omega < Units.RPMToRadPerSec(self.idleControl.stallRPM) then
		self.omega = Units.RPMToRadPerSec(self.idleRPM)
	end
	self.stalled = false
end

function Engine:GetRPM()
	return Units.RadPerSecToRPM(self.omega)
end

function Engine:GetAngularVelocity()
	return self.omega
end

function Engine:IsStalled()
	return self.stalled
end

local Clutch = {}
Clutch.__index = Clutch

function Clutch.new(config)
	local self = setmetatable({}, Clutch)
	self.maxTorque = config.maxTorque or 380
	self.slip = 0
	self.lastTorque = 0
	return self
end

function Clutch:Update(dt, engineOmega, engineInertia, transInputOmega, reflectedInertia, pedal)
	local capacity = self.maxTorque * math.clamp(1 - pedal, 0, 1)
	self.slip = engineOmega - transInputOmega

	if capacity <= 0.001 or reflectedInertia <= 0 or engineInertia <= 0 then
		self.lastTorque = 0
		return 0
	end

	local combinedInertia = (engineInertia * reflectedInertia) / (engineInertia + reflectedInertia)
	local syncTorque = self.slip * combinedInertia / math.max(dt, 1 / 480)

	local torque = math.clamp(syncTorque, -capacity, capacity)

	self.lastTorque = torque
	return torque
end

function Clutch:GetSlip()
	return self.slip
end

local Gearbox = {}
Gearbox.__index = Gearbox

function Gearbox.new(config)
	local self = setmetatable({}, Gearbox)
	self.gears = config.gears
	self.finalDrive = config.finalDrive or 3.9
	self.efficiency = config.efficiency or 0.94
	self.shiftTime = config.shiftTime or 0.18
	self.currentGear = 0
	self.pendingGear = 0
	self.shifting = false
	self.shiftTimer = 0
	return self
end

function Gearbox:GetGear()
	return self.currentGear
end

function Gearbox:GetRatio(gear)
	return self.gears[gear or self.currentGear] or 0
end

function Gearbox:IsShifting()
	return self.shifting
end

function Gearbox:RequestShift(gear)
	if self.gears[gear] == nil or self.shifting or gear == self.currentGear then
		return false
	end
	self.pendingGear = gear
	self.shifting = true
	self.shiftTimer = self.shiftTime
	return true
end

function Gearbox:Update(dt)
	if self.shifting then
		self.shiftTimer -= dt
		if self.shiftTimer <= 0 then
			self.currentGear = self.pendingGear
			self.shifting = false
		end
	end
end

function Gearbox:GetOutputTorque(inputTorque)
	if self.shifting then
		return 0
	end
	return inputTorque * self:GetRatio() * self.finalDrive * self.efficiency
end

function Gearbox:GetTotalRatio()
	return self:GetRatio() * self.finalDrive
end

function Gearbox:RequiredInputOmega(driveshaftOmega)
	local totalRatio = self:GetTotalRatio()
	if totalRatio == 0 then
		return 0
	end
	return driveshaftOmega * totalRatio
end

local Diff = {}
Diff.__index = Diff

function Diff.new(config)
	local self = setmetatable({}, Diff)
	self.type = (config.type or "OPEN"):upper()
	self.preload = config.preload or 15
	self.powerLock = config.powerLock or 0.35
	self.coastLock = config.coastLock or 0.15
	self.maxBias = config.maxBias or 3
	return self
end

function Diff:Distribute(dt, inputTorque, omegaA, omegaB, inertiaA, inertiaB)
	local half = inputTorque * 0.5

	if self.type == "OPEN" then
		return half, half
	end

	local omegaDiff = omegaA - omegaB
	local biasCap = math.abs(inputTorque) * (self.maxBias - 1) * 0.5

	if self.type == "LOCKED" or self.type == "WELDED" then
		local Ia = math.max(inertiaA or 1, 0.01)
		local Ib = math.max(inertiaB or 1, 0.01)
		local combinedInertia = (Ia * Ib) / (Ia + Ib)
		local syncTorque = omegaDiff * combinedInertia / math.max(dt, 1 / 480)
		local lockTorque = math.clamp(syncTorque, -biasCap, biasCap)
		return half - lockTorque, half + lockTorque
	end

	if self.type == "LIMITED" or self.type == "TORSEN" or self.type == "CLUTCH_LSD" then
		local underPower = inputTorque >= 0
		local lockFraction = underPower and self.powerLock or self.coastLock
		local speedTerm = math.clamp(omegaDiff * 6, -1, 1)
		local biasTorque = (math.abs(inputTorque) * lockFraction + self.preload) * speedTerm
		biasTorque = math.clamp(biasTorque, -biasCap, biasCap)
		return half - biasTorque, half + biasTorque
	end

	return half, half
end

local WheelPhysics = {}
WheelPhysics.__index = WheelPhysics

function WheelPhysics.new(config)
	local self = setmetatable({}, WheelPhysics)
	self.inertia = config.inertia or 1.1
	self.radius = config.radius or 0.32
	self.rollingResistanceCoefficient = config.rollingResistanceCoefficient or 0.015
	self.omega = 0
	return self
end

function WheelPhysics:Update(dt, driveTorque, brakeTorque, tireForceNewtons, tireStiffness, normalLoadNewtons, grounded)
	dt = math.max(dt, 1 / 480)
	driveTorque = driveTorque or 0
	brakeTorque = math.max(brakeTorque or 0, 0)

	local reactionTorqueAtCurrentOmega = grounded and (tireForceNewtons * self.radius) or 0

	local reactionDampingNmPerOmega = 0
	if grounded and tireStiffness and tireStiffness > 0 then
		local dForceDOmega = tireStiffness * self.radius * Units.MetersToStuds
		reactionDampingNmPerOmega = dForceDOmega * self.radius
	end

	local rollingResistanceTorque = 0
	if grounded and math.abs(self.omega) > 0.01 then
		local sign = self.omega > 0 and 1 or -1
		rollingResistanceTorque = self.rollingResistanceCoefficient * normalLoadNewtons * self.radius * sign
	end

	local netOtherTorque = driveTorque - reactionTorqueAtCurrentOmega - rollingResistanceTorque
	local denom = self.inertia / dt + reactionDampingNmPerOmega

	if brakeTorque > 0.01 then
		local requiredHoldTorque = -(netOtherTorque + self.omega * denom)
		if math.abs(requiredHoldTorque) <= brakeTorque then
			self.omega = 0
			return self.omega
		end

		local sign = requiredHoldTorque >= 0 and 1 or -1
		netOtherTorque += sign * brakeTorque
	end

	self.omega += netOtherTorque / denom

	return self.omega
end

function WheelPhysics:GetSurfaceSpeed()
	return self.omega * self.radius
end

function WheelPhysics:GetRPM()
	return Units.RadPerSecToRPM(self.omega)
end

local function aeroDragForce(speedMps, aero)
	return 0.5 * aero.rho * aero.Cd * aero.area * speedMps * math.abs(speedMps)
end

