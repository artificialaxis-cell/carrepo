		drivenWheels = { FL = true, FR = true }
	elseif stats.transmission.type == "RWD" then
		drivenWheels = { RL = true, RR = true }
	elseif stats.transmission.type == "AWD" then
		drivenWheels = { FL = true, FR = true, RL = true, RR = true }
	end

	local alive = true
	local driving = false
	local enteredAt = 0
	local entryCFrame = mass.CFrame

	local replicationActive = false
	local replicationLimbs = {}
	local replicationJoints = {}
	local replicationRoot = nil
	local mouseSteer = false
	local handbrakeEngaged = false

	local camera = workspace.CurrentCamera
	local cameraActive = false
	local cameraBindName = "OrbitCamera_" .. tostring(car)
	local cameraOrbitAlpha = 0
	local cameraOrbitBeta = 0.32
	local cameraDistance = 20
	local cameraRightMouseDown = false
	local cameraPreviousVelocity = Vector3.zero
	local cameraCurrentFov = camera.FieldOfView
	local cameraSmoothPosition = nil
	local cameraSmoothFocus = nil
	local cameraSmoothAccel = 0
	local cameraShakeSeed = math.random(0, 10000)

	local character, humanoid, rootPart, diedConnection
	local connections = {}
	local activeTweens = {}
	local collisionCache = {}

	local handbrakeValue = Instance.new("NumberValue")
	handbrakeValue.Value = 0

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "EnterCarPrompt"
	prompt.ActionText = CONFIG.PromptActionText
	prompt.ObjectText = car.Name
	prompt.KeyboardKeyCode = CONFIG.EnterKey
	prompt.GamepadKeyCode = CONFIG.EnterGamepadKey
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = CONFIG.PromptDistance
	prompt.RequiresLineOfSight = false
	prompt.Enabled = false
	prompt.Parent = driverMass or mass

	local function track(connection)
		table.insert(connections, connection)
		return connection
	end

	local function tweenValue(value, target, duration)
		local previous = activeTweens[value]
		if previous then
			previous:Cancel()
		end
		local tween = TweenService:Create(value, TweenInfo.new(duration), { Value = target })
		activeTweens[value] = tween
		tween:Play()
	end

	local function releaseControls(parked)
		for value, tween in activeTweens do
			tween:Cancel()
			activeTweens[value] = nil
		end
		throttleValue.Value = 0
		clutchValue.Value = 0
		brakeValue.Value = if parked then 1 else 0
		if parked then
			handbrakeEngaged = true
			handbrakeValue.Value = 1
		end
	end

	local function computeExitCFrame()
		if not (car:IsDescendantOf(workspace) and mass:IsDescendantOf(car)) then
			return entryCFrame
		end

		local massCFrame = mass.CFrame
		local side = -1
		if driverMass then
			side = if massCFrame:PointToObjectSpace(driverMass.Position).X < 0 then -1 else 1
		end

		local halfWidth = car:GetExtentsSize().X * 0.5
		local rightVector = flatten(massCFrame.RightVector, Vector3.xAxis)
		local lookVector = flatten(massCFrame.LookVector, -Vector3.zAxis)

		local position = massCFrame.Position
			+ rightVector * side * (halfWidth + CONFIG.ExitSideClearance)
			+ Vector3.yAxis * CONFIG.ExitHeight

		return CFrame.lookAt(position, position + lookVector)
	end

	local function startCamera()
		if cameraActive then
			return
		end
		cameraActive = true
		cameraPreviousVelocity = mass.AssemblyLinearVelocity
		cameraCurrentFov = camera.FieldOfView
		cameraSmoothPosition = nil
		cameraSmoothFocus = nil
		camera.CameraType = Enum.CameraType.Scriptable

		RunService:BindToRenderStep(cameraBindName, Enum.RenderPriority.Camera.Value + 1, function(dt)
			if not (car:IsDescendantOf(workspace) and mass.Parent) then
				cameraActive = false
				RunService:UnbindFromRenderStep(cameraBindName)
				return
			end

			if not cameraRightMouseDown then
				local lookVector = mass.CFrame.LookVector
				local flatLook = Vector3.new(lookVector.X, 0, lookVector.Z)
				if flatLook.Magnitude > 0.02 then
					local targetAlpha = math.atan2(-flatLook.X, -flatLook.Z)
					local diff = math.atan2(math.sin(targetAlpha - cameraOrbitAlpha), math.cos(targetAlpha - cameraOrbitAlpha))
					cameraOrbitAlpha += diff * (1 - math.exp(-1.4 * dt))
				end
			end

			local velocity = mass.AssemblyLinearVelocity
			local rawAccel = (velocity - cameraPreviousVelocity) / math.max(dt, 1 / 240)
			cameraPreviousVelocity = velocity

			local rawForwardAccel = math.clamp(rawAccel:Dot(mass.CFrame.LookVector), -60, 60)
			cameraSmoothAccel += (rawForwardAccel - cameraSmoothAccel) * (1 - math.exp(-3 * dt))
			local forwardAccel = cameraSmoothAccel

			local speedKmh = velocity.Magnitude * Units.StudsToMeters * 3.6

			local slip = (car:GetAttribute("FRtotalSlip") or 0)
				+ (car:GetAttribute("FLtotalSlip") or 0)
				+ (car:GetAttribute("RRtotalSlip") or 0)
				+ (car:GetAttribute("RLtotalSlip") or 0)

			local targetFov = 68 + math.clamp(speedKmh / 260, 0, 1) * 10 + math.clamp(forwardAccel / 35, 0, 1) * 4
			cameraCurrentFov += (targetFov - cameraCurrentFov) * (1 - math.exp(-3 * dt))
			camera.FieldOfView = cameraCurrentFov

			local dynamicDistance = cameraDistance + math.clamp(speedKmh / 300, 0, 1) * 6
			local focus = mass.Position + Vector3.new(0, 2.6, 0)
			local orbitCFrame = CFrame.new(focus) * CFrame.Angles(0, cameraOrbitAlpha, 0) * CFrame.Angles(cameraOrbitBeta, 0, 0)
			local desiredPosition = orbitCFrame * CFrame.new(0, 0, dynamicDistance)

			local pullback = math.clamp(-forwardAccel / 30, -1, 1) * 1.2
			desiredPosition += orbitCFrame.LookVector * pullback

			local shakeInput = math.max(math.clamp(slip, 0, 4) - 1.2, 0)
			local shakeMagnitude = math.clamp(shakeInput * 0.25, 0, 1) * 0.12
			local t = os.clock()
			local shakeOffset = camera.CFrame.RightVector * math.noise(t * 7, cameraShakeSeed) * shakeMagnitude
				+ camera.CFrame.UpVector * math.noise(t * 8, cameraShakeSeed + 40) * shakeMagnitude

			cameraSmoothPosition = cameraSmoothPosition or desiredPosition.Position
			cameraSmoothFocus = cameraSmoothFocus or focus

			cameraSmoothPosition = cameraSmoothPosition:Lerp(desiredPosition.Position, 1 - math.exp(-6 * dt))
			cameraSmoothFocus = cameraSmoothFocus:Lerp(focus, 1 - math.exp(-8 * dt))

			camera.CFrame = CFrame.lookAt(cameraSmoothPosition + shakeOffset, cameraSmoothFocus)
		end)
	end

	local function stopCamera()
		if not cameraActive then
			return
		end
		cameraActive = false
		RunService:UnbindFromRenderStep(cameraBindName)
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		if camera and camera.Parent then
			camera.CameraType = Enum.CameraType.Custom
			camera.FieldOfView = 70
		end
	end

	local idleSnd, revSnd, whineSnd
	local idleOk, revOk, whineOk = false, false, false
	local sndWarned = {}

	local aRpm = engine:GetRPM()
	local aThr = 0
	local aLoad = 0
	local aWhineSpd = 0
	local idleVol, revVol, whineVol = 0, 0, 0
	local prevSpd = 0
	local prevStepSpeedMps = 0
	local prevGear = transmission:GetGear()
	local shiftTimer = 0
	local fadeTimer = 0
	local fadingOut = false
	local sndStopped = true
	local frontLoadDeltaPerWheel = 0
	local rearLoadDeltaPerWheel = 0

	local function warnMissingSnd(layerName)
		if not sndWarned[layerName] then
			sndWarned[layerName] = true
			warn(string.format("CarController: %s is missing or invalid Sound 'Primary.%s' -- that audio layer will be disabled", car:GetFullName(), layerName))
		end
	end

	local function initSnd()
		local idleInst = primary:FindFirstChild("idle")
		local revInst = primary:FindFirstChild("rev")
		local whineInst = nil

		if idleInst and idleInst:IsA("Sound") then
			idleSnd = idleInst
			idleOk = true
			idleSnd.Looped = true
			idleSnd.Volume = 0
		else
			warnMissingSnd("Idle")
		end

		if revInst and revInst:IsA("Sound") then
			revSnd = revInst
			revOk = true
			revSnd.Looped = true
			revSnd.Volume = 0
			revSnd.PlaybackSpeed = SND_CFG.Rev.minPlayback
		else
			warnMissingSnd("Rev")
		end

		if whineInst and whineInst:IsA("Sound") then
			whineSnd = whineInst
			whineOk = true
			whineSnd.Looped = true
			whineSnd.Volume = 0
			whineSnd.PlaybackSpeed = SND_CFG.Whine.minPlayback
		else
			warnMissingSnd("Whine")
		end
	end

	local function startSnd()
		fadingOut = false
		fadeTimer = 0
		sndStopped = false

		aRpm = engine:GetRPM()
		aThr = throttleValue.Value
		aLoad = 0
		aWhineSpd = 0
		prevSpd = 0
		prevGear = transmission:GetGear()
		shiftTimer = 0

		if idleOk and not idleSnd.IsPlaying then
			idleSnd.Volume = 0
			idleSnd:Play()
		end
		if revOk and not revSnd.IsPlaying then
			revSnd.Volume = 0
			revSnd:Play()
		end
		if whineOk and not whineSnd.IsPlaying then
			whineSnd.Volume = 0
			whineSnd:Play()
		end
	end

	local function beginFade()
		if sndStopped then
			return
		end
		fadingOut = true
		fadeTimer = SND_CFG.FadeOutTime
	end

	local function stopSndNow()
		fadingOut = false
		fadeTimer = 0
		sndStopped = true

		if idleOk then
			idleSnd:Stop()
			idleSnd.Volume = 0
		end
		if revOk then
			revSnd:Stop()
			revSnd.Volume = 0
		end
		if whineOk then
			whineSnd:Stop()
			whineSnd.Volume = 0
		end
	end

	local function updateSnd(dt, throttle, clutchPedal, currentGear, gearRatio, finalDrive, carSpeedFrontStuds, wheelRadiusMeters)
		if sndStopped and not driving then
			return
		end
		if not driving and not fadingOut and not sndStopped then
			beginFade()
		end

		if currentGear ~= prevGear then
			shiftTimer = SND_CFG.ShiftReactionTime
			prevGear = currentGear
		elseif shiftTimer > 0 then
			shiftTimer = math.max(0, shiftTimer - dt)
		end

		local targetRpm = engine:GetRPM()
		aRpm = smoothTo(aRpm, targetRpm, SND_CFG.Rev.rpmSmoothing, dt)
		aThr = smoothTo(aThr, math.clamp(throttle, 0, 1), SND_CFG.Throttle.smoothing, dt)

		local couplingFactor = 1 - math.clamp(clutchPedal, 0, 1)
		local neutralFactor = if currentGear == 0 then 0.3 else 1
		local rawLoad = math.clamp(throttle, 0, 1) * couplingFactor * neutralFactor
		aLoad = smoothTo(aLoad, rawLoad, SND_CFG.Load.smoothing, dt)

		local carSpeedFrontMps = Units.StudsPerSecToMps(carSpeedFrontStuds)
		local cgHeightMeters = stats.cgHeightMeters or stats.defaultCgHeightMeters
		local wheelbaseMeters = stats.wheelbaseMeters or stats.defaultWheelbaseMeters

		local longitudinalAccelMps2 = (carSpeedFrontMps - prevStepSpeedMps) / math.max(dt, 1 / 240)
		prevStepSpeedMps = carSpeedFrontMps

		local axleTransferNewtons = (massKg * longitudinalAccelMps2 * cgHeightMeters) / wheelbaseMeters

		frontLoadDeltaPerWheel = -axleTransferNewtons * 0.5
		rearLoadDeltaPerWheel = axleTransferNewtons * 0.5
		local wheelAngularSpeed = math.abs(carSpeedFrontMps) / math.max(wheelRadiusMeters, 0.05)
		local ratioForWhine = if gearRatio ~= 0 then math.abs(gearRatio) else 1
		local rawDriveSpeed = wheelAngularSpeed * ratioForWhine * finalDrive * SND_CFG.Whine.driveSpeedScale
		aWhineSpd = smoothTo(aWhineSpd, rawDriveSpeed, SND_CFG.Whine.smoothing, dt)

		local carAccel = (carSpeedFrontStuds - prevSpd) / math.max(dt, 1 / 240)
		prevSpd = carSpeedFrontStuds
		local accelFactor = math.clamp(carAccel / 25, -1, 1)

		if not driving then
			aThr = smoothTo(aThr, 0, SND_CFG.Throttle.smoothing, dt)
			aLoad = smoothTo(aLoad, 0, SND_CFG.Load.smoothing, dt)
		end

		local idleCfg = SND_CFG.Idle
		local idleFadeAlpha = math.clamp((aRpm - idleCfg.minRPM) / math.max(idleCfg.maxRPM - idleCfg.minRPM, 1), 0, 1)
		local idleTargetVolume = lerp(idleCfg.maxVolume, idleCfg.minVolume, idleFadeAlpha)
		if not driving then
			idleTargetVolume = 0
		end
		idleVol = smoothTo(idleVol, idleTargetVolume, idleCfg.smoothing, dt)

		local revCfg = SND_CFG.Rev
		local span = math.max(revCfg.maxRPM - revCfg.minRPM, 1)
		local t = math.clamp((aRpm - revCfg.minRPM) / span, 0, 1) ^ revCfg.playbackCurve
		local revPlayback = lerp(revCfg.minPlayback, revCfg.maxPlayback, t)
		revPlayback *= (1 + math.max(accelFactor, 0) * aLoad * revCfg.accelPlaybackBoost)

		local rpmPresence = math.clamp((aRpm - revCfg.minRPM) / span, 0, 1)
		local throttleLoadPresence = math.clamp(aThr * 0.45 + aLoad * 0.55, 0, 1)
		local revTargetVolume = lerp(revCfg.baseVolume, revCfg.maxVolume, math.clamp(rpmPresence * 0.7 + throttleLoadPresence * 0.75, 0, 1))
		revTargetVolume += aLoad * revCfg.loadVolumeBoost
		revTargetVolume = math.clamp(revTargetVolume, 0, revCfg.maxVolume)

		if shiftTimer > 0 then
			local dipAlpha = shiftTimer / SND_CFG.ShiftReactionTime
			revTargetVolume *= (1 - SND_CFG.ShiftDipStrength * dipAlpha)
		end
		if not driving then
			revTargetVolume = 0
		end
		revVol = smoothTo(revVol, revTargetVolume, revCfg.smoothing, dt)

		local whineCfg = SND_CFG.Whine
		local whineAlpha = math.clamp((aWhineSpd - whineCfg.minSpeed) / math.max(whineCfg.maxSpeed - whineCfg.minSpeed, 1), 0, 1)
		local whinePlayback = lerp(whineCfg.minPlayback, whineCfg.maxPlayback, whineAlpha)
		local whineTargetVolume = lerp(whineCfg.baseVolume, whineCfg.maxVolume, whineAlpha)
		whineTargetVolume += aLoad * whineCfg.loadVolume
		whineTargetVolume *= (1 - math.clamp(clutchPedal, 0, 1) * whineCfg.clutchRelease)
		whineTargetVolume = math.clamp(whineTargetVolume, 0, whineCfg.maxVolume)
		if not driving then
			whineTargetVolume = 0
		end
		whineVol = smoothTo(whineVol, whineTargetVolume, whineCfg.smoothing, dt)

		if idleOk then
			idleSnd.Volume = idleVol
		end
		if revOk then
			revSnd.Volume = revVol
			revSnd.PlaybackSpeed = revPlayback
		end
		if whineOk then
			whineSnd.Volume = whineVol
			whineSnd.PlaybackSpeed = whinePlayback
		end

		if fadingOut then
			fadeTimer -= dt
			local allSilent = idleVol < 0.01 and revVol < 0.01 and whineVol < 0.01
			if fadeTimer <= 0 or allSilent then
				stopSndNow()
			end
		end
	end

	local function buildRigConstraints(part)
		local attachment = Instance.new("Attachment")
		attachment.Name = "ChassisReplicationAttachment"
		attachment.Parent = part

		local alignPosition = Instance.new("AlignPosition")
		alignPosition.Attachment0 = attachment
		alignPosition.Mode = Enum.PositionAlignmentMode.OneAttachment
		alignPosition.MaxForce = math.huge
		alignPosition.MaxVelocity = math.huge
		alignPosition.Responsiveness = 200
		alignPosition.Parent = part

		local alignOrientation = Instance.new("AlignOrientation")
		alignOrientation.Attachment0 = attachment
		alignOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
		alignOrientation.MaxTorque = math.huge
		alignOrientation.Responsiveness = 200
		alignOrientation.Parent = part

		return attachment, alignPosition, alignOrientation
	end

	local function setupChassisReplication()
		if not CHASSIS_REPLICATION.Enabled or not character then
			return
		end
		table.clear(replicationLimbs)
		table.clear(replicationJoints)

		humanoid.PlatformStand = true

		for wheelName, limbName in pairs(CHASSIS_REPLICATION.WheelToLimb) do
			local limb = character:FindFirstChild(limbName)
			local wheelFolder = wheels:FindFirstChild(wheelName)
			local tire = wheelFolder and wheelFolder:FindFirstChild("Bounds")

			if limb and tire then
				local spinAtt = tire:FindFirstChild("SpinAtt")
				if not spinAtt then
					warn(string.format("CarController: wheel '%s' has no SpinAtt -- limb '%s' will not show wheel roll", wheelName, limbName))
				end

				local joint = findLimbJoint(character, limbName)
				if joint then
					joint:Destroy()
					table.insert(replicationJoints, joint)
				else
					warn(string.format("CarController: no Motor6D found for limb '%s' -- it may fight the replicated CFrame", limbName))
				end

				limb.CanCollide = false
				local attachment, alignPosition, alignOrientation = buildRigConstraints(limb)
				replicationLimbs[limbName] = {
					limb = limb,
					tire = tire,
					spinAtt = spinAtt,
					attachment = attachment,
					alignPosition = alignPosition,
					alignOrientation = alignOrientation,
				}
			else
				warn(string.format("CarController: chassis replication could not find limb '%s' or wheel '%s'", limbName, wheelName))
			end
		end

		local rootJoint = findRootJoint(character)
		if rootJoint then
			rootJoint.Enabled = false
			table.insert(replicationJoints, rootJoint)
		end

		if rootPart then
			rootPart.CanCollide = false
			local rootAttachment, rootAlignPosition, rootAlignOrientation = buildRigConstraints(rootPart)
			replicationRoot = { attachment = rootAttachment, alignPosition = rootAlignPosition, alignOrientation = rootAlignOrientation }
		end

		replicationActive = true
	end

	local function teardownChassisReplication()
		replicationActive = false
		for _, joint in ipairs(replicationJoints) do
			if joint then
				joint.Enabled = true
			end
		end
		table.clear(replicationJoints)

		if humanoid and humanoid.Parent then
			humanoid.PlatformStand = false
		end

		for _, entry in pairs(replicationLimbs) do
			if entry.alignPosition then
				entry.alignPosition:Destroy()
			end
			if entry.alignOrientation then
				entry.alignOrientation:Destroy()
			end
			if entry.attachment then
				entry.attachment:Destroy()
			end
		end
		table.clear(replicationLimbs)

		if replicationRoot then
			replicationRoot.alignPosition:Destroy()
			replicationRoot.alignOrientation:Destroy()
			replicationRoot.attachment:Destroy()
			replicationRoot = nil
		end
	end

	local function updateChassisReplication()
		if not replicationActive or not rootPart or not rootPart.Parent then
			return
		end

		local chassisCFrame = mass.CFrame
		local rootTarget = chassisCFrame * CHASSIS_REPLICATION.BodyOffset:Inverse()

		if replicationRoot then
			replicationRoot.alignPosition.Position = rootTarget.Position
			replicationRoot.alignOrientation.CFrame = rootTarget
		end

		for _, entry in pairs(replicationLimbs) do
			local limb, tire, spinAtt = entry.limb, entry.tire, entry.spinAtt
			if limb.Parent and tire.Parent and entry.alignPosition and entry.alignOrientation then
				local target = (spinAtt and spinAtt.Parent) and spinAtt.WorldCFrame or tire.CFrame
				entry.alignPosition.Position = target.Position
				entry.alignOrientation.CFrame = target
			end
		end
	end

	local function leaveCar()
		if not driving then
			return
		end
		driving = false
		Hud.SetVisible(false)
		stopCamera()

		local exitCFrame = computeExitCFrame()
		releaseControls(true)

		if diedConnection then
			diedConnection:Disconnect()
			diedConnection = nil
		end

		toggleCollisions(character, true, collisionCache)
		teardownChassisReplication()

		if rootPart and rootPart.Parent then
			rootPart.Anchored = false
			rootPart.AssemblyLinearVelocity = Vector3.zero
			rootPart.AssemblyAngularVelocity = Vector3.zero
			rootPart.CFrame = exitCFrame
		end

		character, humanoid, rootPart = nil, nil, nil
		beginFade()

		if alive and prompt.Parent then
			prompt.Enabled = true
		end
	end

	local function destroy()
		if not alive then
			return
		end
		if driving then
			leaveCar()
		end
		alive = false
		stopSndNow()
		stopCamera()

		for _, connection in connections do
			connection:Disconnect()
		end
		table.clear(connections)

		for value, tween in activeTweens do
			tween:Cancel()
			activeTweens[value] = nil
		end

		prompt:Destroy()
		handbrakeValue:Destroy()
		handledCars[car] = nil
	end

	local function onDriverDied()
		if not driving then
			return
		end
		if diedConnection then
			diedConnection:Disconnect()
			diedConnection = nil
		end

		driving = false
		alive = false
		teardownChassisReplication()
		stopSndNow()
		stopCamera()

		for _, connection in connections do
			connection:Disconnect()
		end
		table.clear(connections)

		for value, tween in activeTweens do
			tween:Cancel()
			activeTweens[value] = nil
		end

		character, humanoid, rootPart = nil, nil, nil
		handledCars[car] = nil

		if car:IsDescendantOf(workspace) then
			car:Destroy()
		end
	end

	local function enterCar()
		if driving or not alive then
			return
		end

		local currentCharacter = player.Character
		local currentHumanoid = currentCharacter and currentCharacter:FindFirstChildOfClass("Humanoid")
		local currentRoot = currentCharacter and currentCharacter:FindFirstChild("HumanoidRootPart")

		if not currentHumanoid or not currentRoot or currentHumanoid.Health <= 0 then
			return
		end

		toggleCollisions(currentCharacter, false, collisionCache)

		driving = true
		enteredAt = os.clock()
		character = currentCharacter
		humanoid = currentHumanoid
		rootPart = currentRoot
		entryCFrame = currentRoot.CFrame

		setupChassisReplication()

		if CONFIG.AutoFirstGearOnEnter and transmission:GetGear() == 0 then
			transmission:RequestShift(1)
		end

		prompt.Enabled = false
		releaseControls(false)
		handbrakeEngaged = false
		handbrakeValue.Value = 0

		Hud.SetVisible(true)
		startSnd()
		startCamera()

		diedConnection = currentHumanoid.Died:Connect(onDriverDied)
	end

	local function shiftGear(direction)
		if not driving then
			return
		end
		local nextGear = transmission:GetGear() + direction
		transmission:RequestShift(nextGear)
	end

	local function isCarIntact()
		return car:IsDescendantOf(workspace) and mass.Parent ~= nil and primary.Parent ~= nil
	end

	local FIXED_SUBSTEP = 1 / 120
	local MAX_SUBSTEPS = 8
	local MAX_TOTAL_DT = 0.25

	local function step(dt)
		if not isCarIntact() then
			destroy()
			return
		end
		dt = math.min(dt, MAX_TOTAL_DT)

		handbrakeEngaged = UserInputService:IsKeyDown(Enum.KeyCode.Space)
		tweenValue(handbrakeValue, handbrakeEngaged and 1 or 0, 0.12)


		if driving and rootPart and rootPart.Parent and not CHASSIS_REPLICATION.Enabled then
			rootPart.CFrame = mass.CFrame
		end

		local steerTime = stats.steerResponseTimeInactive
		local targetSteer = 0
		local mouseControlled = false

		if driving and not UserInputService:GetFocusedTextBox() then
			if mouseSteer then
				local viewportWidth = math.max(workspace.CurrentCamera.ViewportSize.X, 1)
				steerValue.Value = math.clamp((UserInputService:GetMouseLocation().X / viewportWidth) * 2 - 1, -1, 1)
				mouseControlled = true
			else
				local left = UserInputService:IsKeyDown(CONFIG.SteerLeftKey)
				local right = UserInputService:IsKeyDown(CONFIG.SteerRightKey)
				if left ~= right then
					targetSteer = if left then -1 else 1
					steerTime = stats.steerResponseTimeActive
				end
			end
		end

		if not mouseControlled then
			steerValue.Value = approach(steerValue.Value, targetSteer, steerTime, dt)
		end

		if steerSlide then
			steerSlide.Position = Vector3.new(steerValue.Value * -0.34, -1.17, -7.216)
		end

		local velocity = mass.AssemblyLinearVelocity
		local carSpeedObjectSpace = mass.CFrame:VectorToObjectSpace(velocity)
		local carSpeedFrontStuds = carSpeedObjectSpace.Z
		local carSpeedFrontMps = Units.StudsPerSecToMps(carSpeedFrontStuds)

		local longitudinalAccelMps2 = (carSpeedFrontMps - prevStepSpeedMps) / dt
		local transferNewtons = (massKg * longitudinalAccelMps2 * stats.cgHeightMeters) / stats.wheelbaseMeters

		if drag then
			local dragForce = Vector3.zero
			if velocity.Magnitude > 0.01 then
				local dragNewtons = aeroDragForce(carSpeedFrontMps, stats.aero)
				dragForce = -velocity.Unit * Vector3.new(1, 0.5, 1) * (dragNewtons * Units.ForceScale)
			end
			drag.Force = dragForce
		end

		local throttlePedal = throttleValue.Value
		local brakePedal = brakeValue.Value
		local clutchPedal = clutchValue.Value

		local tireInfos = {}
		for _, wheel in ipairs(wheels:GetChildren()) do
			if wheelUnits[wheel.Name] then
				local tireInfo = TireContact.Update(car, wheel, raycastParams)
				tireInfos[wheel.Name] = tireInfo
				if not tireInfo then
					wheel.Bounds.FrictionForce.Force = Vector3.zero
				end
			end
		end

		local steps = math.clamp(math.ceil(dt / FIXED_SUBSTEP), 1, MAX_SUBSTEPS)
		local subDt = dt / steps

		local lastClutchTorque, lastDriveshaftTorque, lastDriveshaftOmega = 0, 0, 0

		for _ = 1, steps do
			transmission:Update(subDt)
			local totalRatio = transmission:GetTotalRatio()

			local driveshaftOmega = 0
			local drivenCount = 0
			for name, isDriven in pairs(drivenWheels) do
				if isDriven then
					driveshaftOmega += wheelUnits[name].omega
					drivenCount += 1
				end
			end
			if drivenCount > 0 then
				driveshaftOmega /= drivenCount
			end

			local clutchTorque
			if totalRatio ~= 0 then
				local requiredInputOmega = driveshaftOmega * totalRatio
				local wheelInertiaSum = massKg * stats.wheelRadiusMeters * stats.wheelRadiusMeters
				for name, isDriven in pairs(drivenWheels) do
					if isDriven then
						wheelInertiaSum += wheelUnits[name].inertia
					end
				end
				local reflectedInertia = wheelInertiaSum / (totalRatio * totalRatio)
				clutchTorque = clutch:Update(subDt, engine:GetAngularVelocity(), engine.inertia, requiredInputOmega, reflectedInertia, clutchPedal)
			else

				clutch:Update(subDt, engine:GetAngularVelocity(), engine.inertia, engine:GetAngularVelocity(), 0, clutchPedal)
				clutchTorque = 0
			end

			engine:Update(subDt, throttlePedal, clutchTorque)
			local driveshaftTorque = transmission:GetOutputTorque(clutchTorque)

			local frontAxleTorque, rearAxleTorque = 0, 0
			if stats.transmission.type == "AWD" then
				local frontOmega = (wheelUnits.FL.omega + wheelUnits.FR.omega) * 0.5
				local rearOmega = (wheelUnits.RL.omega + wheelUnits.RR.omega) * 0.5
				local frontInertia = wheelUnits.FL.inertia + wheelUnits.FR.inertia
				local rearInertia = wheelUnits.RL.inertia + wheelUnits.RR.inertia
				if centerDiff then
					frontAxleTorque, rearAxleTorque = centerDiff:Distribute(subDt, driveshaftTorque, frontOmega, rearOmega, frontInertia, rearInertia)
				else
					frontAxleTorque = driveshaftTorque * (stats.transmission.awd.frontBias or 0.5)
					rearAxleTorque = driveshaftTorque * (stats.transmission.awd.rearBias or 0.5)
				end
			elseif stats.transmission.type == "FWD" then
				frontAxleTorque = driveshaftTorque
			else
				rearAxleTorque = driveshaftTorque
			end

			local wheelDriveTorque = { FL = 0, FR = 0, RL = 0, RR = 0 }
			if drivenWheels.FL or drivenWheels.FR then
				wheelDriveTorque.FL, wheelDriveTorque.FR = axleDiff:Distribute(subDt, frontAxleTorque, wheelUnits.FL.omega, wheelUnits.FR.omega, wheelUnits.FL.inertia, wheelUnits.FR.inertia)
			end
			if drivenWheels.RL or drivenWheels.RR then
				wheelDriveTorque.RL, wheelDriveTorque.RR = axleDiff:Distribute(subDt, rearAxleTorque, wheelUnits.RL.omega, wheelUnits.RR.omega, wheelUnits.RL.inertia, wheelUnits.RR.inertia)
			end

			local frontBrakeTorque = brakePedal * stats.brakes.maxTorqueFront
			local rearBrakeTorque = brakePedal * stats.brakes.maxTorqueRear
				+ handbrakeValue.Value * stats.brakes.handbrakeTorque
			local wheelBrakeTorque = { FL = frontBrakeTorque, FR = frontBrakeTorque, RL = rearBrakeTorque, RR = rearBrakeTorque }

			for name, wheelUnit in pairs(wheelUnits) do
				local tireInfo = tireInfos[name]
				local forwardForceNewtons, normalLoadNewtons, tireStiffness = 0, 0, 0
				local grounded = tireInfo ~= nil
				if tireInfo then
					local surfaceSpeedStuds = Units.MpsToStudsPerSec(wheelUnit:GetSurfaceSpeed())
					local isFrontWheel = (name == "FL" or name == "FR")
					local loadDeltaNewtons = isFrontWheel and frontLoadDeltaPerWheel or rearLoadDeltaPerWheel
					forwardForceNewtons, normalLoadNewtons, tireStiffness = Grip.Update(tireInfo, surfaceSpeedStuds, smoothedLoad, subDt, loadDeltaNewtons)
				end
				wheelUnit:Update(subDt, wheelDriveTorque[name], wheelBrakeTorque[name], forwardForceNewtons, tireStiffness, normalLoadNewtons, grounded)
			end

			lastClutchTorque = clutchTorque
			lastDriveshaftTorque = driveshaftTorque
			lastDriveshaftOmega = driveshaftOmega
		end

		for _, wheel in ipairs(wheels:GetChildren()) do
			local wheelUnit = wheelUnits[wheel.Name]
			if wheelUnit then
				local speedAttribute = WHEEL_SPEED_ATTRIBUTES[wheel.Name]
				if speedAttribute then
					car:SetAttribute(speedAttribute, Units.MpsToStudsPerSec(wheelUnit:GetSurfaceSpeed()))
				end

				local roll = wheel.Roll
				roll.Value = (roll.Value + math.deg(wheelUnit.omega) * dt) % 360
				wheel.Bounds.SpinAtt.CFrame = CFrame.fromOrientation(math.rad(-roll.Value), 0, 0)
			end
		end

		local currentGear = transmission:GetGear()
		car:SetAttribute("RPM", engine:GetRPM())
		car:SetAttribute("EngineStalled", engine:IsStalled())
		car:SetAttribute("Gear", currentGear)
		car:SetAttribute("Handbrake", handbrakeEngaged)

		if driving then
			local speedKmh = math.abs(carSpeedFrontMps) * 3.6
			Hud.Update({
				gear = currentGear,
				speedKmh = speedKmh,
				rpm = engine:GetRPM(),
				redlineRpm = stats.engine.redlineRPM,
				redlineWarnRpm = stats.engine.redlineRPM * 0.9,
				throttle = throttlePedal,
				brake = brakePedal,
				clutch = clutchPedal,
				handbrake = handbrakeEngaged,
			})
		end

		updateSnd(dt, throttlePedal, clutchPedal, currentGear, transmission:GetRatio(), stats.transmission.finalDrive, carSpeedFrontStuds, stats.wheelRadiusMeters)

		if stats.debug.enabled then
			car:SetAttribute("Debug_ClutchSlipRadPerSec", clutch:GetSlip())
			car:SetAttribute("Debug_ClutchTorque", lastClutchTorque)
			car:SetAttribute("Debug_DriveshaftTorque", lastDriveshaftTorque)
			car:SetAttribute("Debug_DriveshaftOmega", lastDriveshaftOmega)
			car:SetAttribute("Debug_EngineNetTorque", engine.lastNetTorque)
			car:SetAttribute("Debug_EngineCombustionTorque", engine.lastCombustionTorque)
		end

		if driving then
			updateChassisReplication()
		end
	end

	track(UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not driving then
			return
		end
		local key = input.KeyCode

		if key == CONFIG.ThrottleKey then
			tweenValue(throttleValue, 1, stats.throttleResponseTime)
		elseif key == CONFIG.BrakeKey then
			tweenValue(brakeValue, 1, stats.brakeResponseTime)
		elseif key == CONFIG.ClutchKey then
			tweenValue(clutchValue, 1, stats.clutchResponseTime)
		elseif key == CONFIG.GearUpKey then
			if os.clock() - enteredAt > CONFIG.EnterInputGuard then
				shiftGear(1)
			end
		elseif key == CONFIG.GearDownKey then
			shiftGear(-1)
		elseif key == CONFIG.MouseSteerKey then
			mouseSteer = not mouseSteer
		elseif key == CONFIG.RestartEngineKey then
			if engine:IsStalled() then
				engine:Restart()
			end			
		elseif key == CONFIG.ExitKey then
			leaveCar()
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
			cameraRightMouseDown = true
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		end
	end))

	track(UserInputService.InputEnded:Connect(function(input)
		if not driving then
			return
		end
		local key = input.KeyCode

		if key == CONFIG.ThrottleKey then
			tweenValue(throttleValue, 0, stats.throttleResponseTime / 2)
		elseif key == CONFIG.BrakeKey then
			tweenValue(brakeValue, 0, stats.brakeResponseTime / 2)
		elseif key == CONFIG.ClutchKey then
			tweenValue(clutchValue, 0, stats.clutchResponseTime / 2)
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
			cameraRightMouseDown = false
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		end
	end))

	track(UserInputService.InputChanged:Connect(function(input)
		if not driving then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseMovement and cameraRightMouseDown then
			cameraOrbitAlpha -= input.Delta.X * 0.0085
			cameraOrbitBeta = math.clamp(cameraOrbitBeta - input.Delta.Y * 0.0085, -1.1, 1.3)
		elseif input.UserInputType == Enum.UserInputType.MouseWheel then
			cameraDistance = math.clamp(cameraDistance - input.Position.Z * 3, 7, 45)
		end
	end))

	track(prompt.Triggered:Connect(enterCar))

	track(player.CharacterRemoving:Connect(function()
		if driving then
			leaveCar()
		end
	end))

	track(car.AncestryChanged:Connect(function()
		if not car:IsDescendantOf(workspace) then
			destroy()
		end
	end))

	track(car.Destroying:Connect(destroy))

	initSnd()

	task.delay(CONFIG.StartDelay, function()
		if not alive then
			return
		end

		mass.Anchored = false
		releaseControls(true)

		track(RunService.RenderStepped:Connect(step))

		if player.Character then
			player.Character:WaitForChild("Humanoid", 5)
			player.Character:WaitForChild("HumanoidRootPart", 5)
			enterCar()
		else
			local characterConnection
			characterConnection = player.CharacterAdded:Connect(function(newCharacter)
				if characterConnection then
					characterConnection:Disconnect()
				end
				newCharacter:WaitForChild("Humanoid", 5)
				newCharacter:WaitForChild("HumanoidRootPart", 5)
				enterCar()
			end)
			track(characterConnection)
		end
	end)
end

return CarController
