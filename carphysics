local longtire = {
	fz0 = 3000, muload = 0.15, stiffper = 12.5, stiffload = 0.25,
	C = 1.7, E = -0.1, relax = 0.35, maxslip = 1.0,
}

local lattire = {
	fz0 = 3000, muload = 0.22, stiffper = 16.0, stiffload = 0.30,
	C = 1.38, E = -0.35, relax = 0.4, maxslip = math.rad(32),
}

local function coeffs(axis, mu, fz, gripmult, stiffmult)
	gripmult = gripmult or 1
	stiffmult = stiffmult or 1
	local ratio = fz / axis.fz0
	local D = math.max(mu * (1 - axis.muload * (ratio - 1)), 0) * fz * gripmult
	local bcd = math.max(axis.stiffper * (1 - axis.stiffload * (ratio - 1)), 0) * fz * stiffmult
	return bcd / math.max(axis.C * D, 1e-6), axis.C, D, axis.E
end

local function pacejka(slip, axis, B, C, D, E)
	local bx = B * math.clamp(slip, -axis.maxslip, axis.maxslip)
	return D * math.sin(C * math.atan(bx - E * (bx - math.atan(bx))))
end

local function tirecontact(car, wheel, rayparams)
	local spring = car:GetAttribute("psi") * 300
	local damper = car:GetAttribute("damper")
	local tstart = car:GetAttribute("tirestart")
	local tend = car:GetAttribute("tireend")
	local contactradius = tend + 0.35 - tstart

	local tire = wheel.Bounds
	local up = tire.CFrame.UpVector
	local startpos = tire.Position - up * tstart
	tire.TIRESTART.WorldPosition = startpos
	tire.TIREEND.WorldPosition = tire.Position - up * tend

	local tireforce = tire.TireForce
	local fricforce = tire.FrictionForce

	local cf = tire.CFrame
	local right = cf.RightVector
	local fwd = cf.LookVector
	local dir = -cf.UpVector * contactradius

	local hits, normals, matcounts, count = {}, {}, {}, 0
	for i = 0, #sampleoffsets do
		local origin = startpos
		if i > 0 then
			local o = sampleoffsets[i]
			origin = startpos + right * o[1] + fwd * o[2]
		end
		local res = workspace:Raycast(origin, dir, rayparams)
		if res then
			count += 1
			hits[count] = res.Position
			normals[count] = res.Normal
			matcounts[res.Material] = (matcounts[res.Material] or 0) + 1
		end
	end

	if count == 0 then
		tireforce.Force = Vector3.zero
		fricforce.Force = Vector3.zero
		return nil
	end

	local highest = -math.huge
	for i = 1, count do
		highest = math.max(highest, hits[i].Y)
	end

	local possum = Vector3.zero
	local normsum = Vector3.zero
	local kept = 0
	for i = 1, count do
		if highest - hits[i].Y <= 0.05 then
			possum += hits[i]
			normsum += normals[i]
			kept += 1
		end
	end

	local contactpos = possum / kept
	local groundnormal = if normsum.Magnitude > 1e-6 then normsum.Unit else Vector3.yAxis

	local groundmat
	local topcount = 0
	for mat, c in pairs(matcounts) do
		if c > topcount then
			groundmat = mat
			topcount = c
		end
	end

	tire.ForceAtt.WorldPosition = contactpos

	local length = (startpos - contactpos):Dot(up)
	local compression = length - contactradius
	local normalforce = -spring * compression + -damper * tire.AssemblyLinearVelocity:Dot(up)
	tireforce.Force = groundnormal * normalforce

	return {
		folder = wheel,
		tire = tire,
		cpos = contactpos,
		car = car,
		mat = groundmat,
	}
end

local function gripupdate(info, surfacespeed, dt, loaddelta, stats)
	local tire = info.tire
	local car = info.car
	local name = info.folder.Name

	local fwd = tire.CFrame.LookVector
	fwd = Vector3.new(fwd.X, 0, fwd.Z).Unit
	local right = tire.CFrame.RightVector
	right = Vector3.new(right.X, 0, right.Z).Unit

	local staticload = ((car.Mass.AssemblyMass * workspace.Gravity) / (2853 / 1500 / 0.28)) / 4
	local targetload = math.max(staticload + (loaddelta or 0), 0)
	smoothedload[name] = smoothedload[name] + (targetload - smoothedload[name]) * (1 - math.exp(-12 * dt))
	local fz = smoothedload[name]

	local roadmu = mutable[info.mat] or 0.6

	local offset = info.cpos - tire.AssemblyCenterOfMass
	local vel = tire.AssemblyLinearVelocity + tire.AssemblyAngularVelocity:Cross(offset)
	local longvel = vel:Dot(fwd)
	local latvel = vel:Dot(right)

	local refspeed = math.max(math.abs(longvel), math.abs(surfacespeed), 2.5)
	local slipratio = math.clamp((surfacespeed - longvel) / refspeed, -longtire.maxslip, longtire.maxslip)
	local slipangle = math.clamp(math.atan2(latvel, math.max(math.abs(longvel), 2.5)), -lattire.maxslip, lattire.maxslip)

	local stationary = math.abs(longvel) < 0.75 and math.abs(surfacespeed) < 0.75 and math.abs(latvel) < 0.75

	local longmps = longvel * 0.28

	local isfront = name == "FL" or name == "FR"

	local Bx, Cx, Dx, Ex = coeffs(longtire, roadmu, fz)

	local By, Cy, Dy, Ey = coeffs(
		lattire, roadmu, fz,
		isfront and stats.frictconfig.latGripFront or stats.frictconfig.latGripRear,
		isfront and stats.frictconfig.latStiffFront or stats.frictconfig.latStiffRear
	)

	if Dx <= 0 or Dy <= 0 then
		tire.FrictionForce.Force = Vector3.zero
		return 0, 0, 0
	end

	local force

	if stationary then
		local driveslip = math.clamp(surfacespeed / 2.5, -1, 1)
		local drivefx = pacejka(driveslip, longtire, Bx, Cx, Dx, Ex)
		local totalfx = drivefx + -longvel * roadmu * 220
		local totalfy = -latvel * roadmu * 220

		local ellipse = math.sqrt((totalfx / Dx) ^ 2 + (totalfy / Dy) ^ 2)
		if ellipse > 1 then
			totalfx /= ellipse
			totalfy /= ellipse
		end
		force = fwd * totalfx + right * totalfy
	else
		local lag = slaglag[name]
		local rate = math.max(math.abs(longmps), 0.6) / longtire.relax
		lag.x = lag.x + (slipratio - lag.x) * (1 - math.exp(-rate * dt))
		rate = math.max(math.abs(longmps), 0.6) / lattire.relax
		lag.y = lag.y + (slipangle - lag.y) * (1 - math.exp(-rate * dt))

		local fx = pacejka(lag.x, longtire, Bx, Cx, Dx, Ex)
		local fy = pacejka(lag.y, lattire, By, Cy, Dy, Ey)

		local ellipse = math.sqrt((fx / Dx) ^ 2 + (fy / Dy) ^ 2)
		if ellipse > 1 then
			fx /= ellipse
			fy /= ellipse
		end
		force = fwd * fx - right * fy
	end

	tire.FrictionForce.Force = force * (2853 / 1500 / 0.28)

	local nslip = math.abs(slipangle) / lattire.maxslip
	local totalslip = math.sqrt(slipratio * slipratio + nslip * nslip)

	local att = tire:FindFirstChild("ForceAtt")
	if att then
		local smoke = att:FindFirstChild("TireSmoke")
		if smoke then
			local slipping = totalslip > 0.6 and (totalslip >= 0.7 or tire.AssemblyLinearVelocity.Magnitude > 2)
			smoke.Rate = slipping and 50 * math.min(totalslip, 2) or 0
		end
	end

	car:SetAttribute(name .. "totalSlip", totalslip)

	local stiffref = stationary and 2.5 or refspeed
	local stiffness = Dx * (Bx * Cx) / math.max(stiffref, 0.01)

	return force:Dot(fwd), fz, stiffness
end

