-- B*slip at which the magic formula peaks; depends only on C and E.
local function peakArgument(C, E)
	local target = math.tan(math.pi / (2 * C))
	local u = target
	for _ = 1, 12 do
		local f = u - E * (u - math.atan(u)) - target
		local df = 1 - E * (1 - 1 / (1 + u * u))
		u -= f / df
	end
	return u
end
LONG.peak = peakArgument(LONG.C, LONG.E)
LAT.peak = peakArgument(LAT.C, LAT.E)

