	local function updatepedals(released)
		if not driving then
			return
		end
		local w = released ~= Enum.KeyCode.W and uis:IsKeyDown(Enum.KeyCode.W)
		local s = released ~= Enum.KeyCode.S and uis:IsKeyDown(Enum.KeyCode.S)
		local thrtarget = ((autoreverse and s) or (not autoreverse and w)) and 1 or 0
		local brktarget = ((autoreverse and w) or (not autoreverse and s)) and 1 or 0
		if thrtarget ~= lastthr then
			lastthr = thrtarget
			tweenval(thrval, thrtarget, thrtarget == 1 and stats.throttleResponseTime or stats.throttleResponseTime / 2)
		end
		if brktarget ~= lastbrk then
			lastbrk = brktarget
			tweenval(brkval, brktarget, brktarget == 1 and stats.brakeResponseTime or stats.brakeResponseTime / 2)
		end
	end

