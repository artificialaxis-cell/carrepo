local function validatecar(car)
	for _, n in ipairs(reqchildren) do
		if not car:FindFirstChild(n) then
			warn(string.format("CarController: %s is missing '%s'", car:GetFullName(), n))
			return nil
		end
	end
	for _, n in ipairs(reqattrs) do
		if typeof(car:GetAttribute(n)) ~= "number" then
			warn(string.format("CarController: %s is missing numeric attribute '%s'", car:GetFullName(), n))
			return nil
		end
	end

	for orig, clones in pairs(renames) do
		for _, cname in ipairs(clones) do
			local child = car:FindFirstChild(cname, true)
			if child then
				child.Name = orig
			end
		end
	end

	local mass = car.Mass
	local primary = car.Primary
	if not (mass:IsA("BasePart") and primary:IsA("BasePart")) then
		warn(string.format("CarController: %s has Mass or Primary of the wrong type", car:GetFullName()))
		return nil
	end

	local drivermass = car:FindFirstChild("DriverMass")
	if drivermass and not drivermass:IsA("BasePart") then
		drivermass = nil
	end
	local drag = mass:FindFirstChild("Drag")
	if drag and not drag:IsA("VectorForce") then
		drag = nil
	end
	local steerslide = primary:FindFirstChild("SteerSlide")
	if steerslide and not steerslide:IsA("Attachment") then
		steerslide = nil
	end

	return {
		wheels = car.Wheels,
		mass = mass,
		primary = primary,
		throttle = car.Throttle,
		brake = car.Brake,
		clutch = car.Clutch,
		steer = car.Steer,
		drivermass = drivermass,
		drag = drag,
		steerslide = steerslide,
	}
end

local function togglecollide(char, enabled, cache)
	if not char then
		return
	end
	if enabled then
		for part, orig in pairs(cache) do
			if part.Parent then
				part.CanCollide = orig
			end
		end
		table.clear(cache)
	else
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				cache[part] = part.CanCollide
				part.CanCollide = false
			end
		end
	end
end

local handled = setmetatable({}, { __mode = "k" })
local CarController = {}

function CarController:HandleCar(car)
	if typeof(car) ~= "Instance" or not car:IsA("Model") then
		warn("CarController:HandleCar expects a car Model")
		return
	end
	if handled[car] then
		return
	end

	local player = plrs.LocalPlayer
	if not player then
		warn("CarController:HandleCar must be called from a client script")
		return
	end

	local parts = validatecar(car)
	if not parts then
		return
	end
	handled[car] = true

	local wheels = parts.wheels
	local mass = parts.mass
	local primary = parts.primary
	local thrval = parts.throttle
	local brkval = parts.brake
	local cltval = parts.clutch
	local steerval = parts.steer
	local drivermass = parts.drivermass
	local drag = parts.drag
	local steerslide = parts.steerslide

	local rayparams = RaycastParams.new()
	rayparams.FilterType = Enum.RaycastFilterType.Include
	rayparams.FilterDescendantsInstances = { workspace.Map, workspace.Built }

	local stats = _G.ReturnStats(car, mass)
	local masskg = stats.massKg or (mass.AssemblyMass / (2853 / 1500 / 0.28))
	print(stats.wheelRadiusMeters .. "m")
	print(car.Mass.AssemblyMass .. " Mass")

	local engine = Engine.new(stats.engine)
	local clutch = Clutch.new(stats.clutch)
	local trans = Gearbox.new(stats.transmission)
	local axlediff = Diff.new(stats.transmission.differential)
	local centerdiff
	if stats.transmission.type == "AWD" then
		centerdiff = Diff.new({ type = stats.transmission.awd.centerDiff or "LIMITED" })
	end

