-- Contact patch sample pattern (fractions of REF_RADIUS): centre, 4 rings of 8.
local SAMPLES = { Vector2.zero }
for _, r in ipairs({ 0.1, 0.2, 0.3, 0.4 }) do
	table.insert(SAMPLES, Vector2.new(r, 0))
	table.insert(SAMPLES, Vector2.new(-r, 0))
	table.insert(SAMPLES, Vector2.new(0, r))
	table.insert(SAMPLES, Vector2.new(0, -r))
end
for _, r in ipairs({ 0.1, 0.2, 0.3, 0.4 }) do
	local d = r * math.sqrt(0.5)
	table.insert(SAMPLES, Vector2.new(d, d))
	table.insert(SAMPLES, Vector2.new(d, -d))
	table.insert(SAMPLES, Vector2.new(-d, d))
	table.insert(SAMPLES, Vector2.new(-d, -d))
end

-- scratch buffers reused by every probe (single-threaded)
local hitH, hitP, hitN, hitM, hitI = {}, {}, {}, {}, {}
local matVotes = {}

local function coeffs(axis, mu, fz, grip, stiff)
	local ratio = fz / axis.fz0
	local D = math.max(mu * (1 - axis.muload * (ratio - 1)), 0) * fz * grip
	local bcd = math.max(axis.stiffper * (1 - axis.stiffload * (ratio - 1)), 0) * fz * stiff
	return bcd / math.max(axis.C * D, 1e-6), D
end

local function pacejka(slip, axis, B, D)
	local bx = B * math.clamp(slip, -axis.maxslip, axis.maxslip)
	local E = axis.E
	return D * math.sin(axis.C * math.atan(bx - E * (bx - math.atan(bx))))
end

local function projectOnPlane(v, n)
	local p = v - n * v:Dot(n)
	local m = p.Magnitude
	if m < 1e-4 then
		return nil
	end
	return p / m
end

