local Engine = {}
Engine.__index = Engine

function Engine.new(cfg)
	local self = setmetatable({}, Engine)
	self.idlerpm = cfg.idleRPM or 900
	self.redline = cfg.redlineRPM or 7000
	self.inertia = cfg.inertia or 0.15
	self.curve = cfg.torqueCurve
	self.points = {}
	for rpm in pairs(self.curve) do
		table.insert(self.points, rpm)
	end
	table.sort(self.points)
	assert(#self.points >= 2, "Engine requires at least 2 torqueCurve points")

	local fr = cfg.friction or {}
	self.staticfric = fr.static or 12
	self.viscous = fr.viscous or 0.010
	self.pumping = fr.pumpingLossCoefficient or 0.0009
	self.accessory = cfg.accessoryTorque or 6

	self.idlectl = cfg.idleControl or {}
	if self.idlectl.enabled == nil then
		self.idlectl.enabled = true
	end
	self.idlectl.targetRPM = self.idlectl.targetRPM or self.idlerpm
	self.idlectl.authority = self.idlectl.authority or 0.55
	self.idlectl.stallRPM = self.idlectl.stallRPM or (self.idlerpm * 0.35)

	self.limiter = cfg.revLimiter or {}
	self.limiter.rpm = self.limiter.rpm or self.redline
	self.limiter.cut = self.limiter.cut or 1.0
	self.limiter.hysteresis = self.limiter.hysteresis or 120

	self.omega = self.idlerpm * math.pi / 30
	self.stalled = false
	self.limiting = false
	self.lastcomb = 0
	self.lastnet = 0
	return self
end

function Engine:update(dt, throttle, load)
	load = load or 0
	local rpm = self.omega * 30 / math.pi

	local idlethrottle = 0
	if self.idlectl.enabled and rpm < self.idlectl.targetRPM * 1.05 then
		local deficit = (self.idlectl.targetRPM - rpm) / self.idlectl.targetRPM
		idlethrottle = math.clamp(deficit * self.idlectl.authority, 0, 1)
	end
	local thr = math.max(math.clamp(throttle, 0, 1), idlethrottle)

	if rpm >= self.limiter.rpm then
		self.limiting = true
	elseif rpm < self.limiter.rpm - self.limiter.hysteresis then
		self.limiting = false
	end
	if self.limiting then
		thr = thr * (1 - self.limiter.cut)
	end

	local pts = self.points
	local maxtq
	if rpm <= pts[1] then
		maxtq = self.curve[pts[1]]
	elseif rpm >= pts[#pts] then
		maxtq = self.curve[pts[#pts]]
	else
		maxtq = self.curve[pts[#pts]]
		for i = 1, #pts - 1 do
			local lo, hi = pts[i], pts[i + 1]
			if rpm >= lo and rpm <= hi then
				maxtq = self.curve[lo] + (self.curve[hi] - self.curve[lo]) * ((rpm - lo) / (hi - lo))
				break
			end
		end
	end
	local comb = maxtq * math.clamp(thr, 0, 1)

	local fric = self.staticfric + self.viscous * self.omega
	local pump = self.pumping * (1 - thr) * self.omega * self.omega

	if self.stalled then
		comb = 0
	end

	local net = comb - fric - pump - self.accessory - load

	if not self.stalled and rpm < self.idlectl.stallRPM and net < 0 then
		self.stalled = true
		comb = 0
		net = -fric - pump - load
	end

	self.omega = math.max(self.omega + net / self.inertia * dt, 0)
	self.lastcomb = comb
	self.lastnet = net
end

function Engine:restart()
	if self.omega < self.idlectl.stallRPM * math.pi / 30 then
		self.omega = self.idlerpm * math.pi / 30
	end
	self.stalled = false
end

local Clutch = {}
Clutch.__index = Clutch

function Clutch.new(cfg)
	local self = setmetatable({}, Clutch)
	self.maxtorque = cfg.maxTorque or 380
	self.slip = 0
	return self
end

function Clutch:update(dt, eomega, einertia, tomega, reflected, pedal)
	local cap = self.maxtorque * math.clamp(1 - pedal, 0, 1)
	self.slip = eomega - tomega

	if cap <= 0.001 or reflected <= 0 or einertia <= 0 then
		return 0
	end

	local combined = (einertia * reflected) / (einertia + reflected)
	local sync = self.slip * combined / math.max(dt, 1 / 480)
	return math.clamp(sync, -cap, cap)
end

local function smooth(x)
	x = math.clamp(x, 0, 1)
	return x * x * (3 - 2 * x)
end

local Gearbox = {}
Gearbox.__index = Gearbox

function Gearbox.new(cfg)
	local self = setmetatable({}, Gearbox)
	self.gears = cfg.gears
	self.finaldrive = cfg.finalDrive or 3.9
	self.eff = cfg.efficiency or 0.94
	self.shifttime = cfg.shiftTime or 0.18
	self.gear = 0
	self.pending = 0
	self.shifting = false
	self.timer = 0
	self.mingear = 0
	for g in pairs(self.gears) do
		if type(g) == "number" and g < self.mingear then
			self.mingear = g
		end
	end
	return self
end

function Gearbox:ratio(gear)
	return self.gears[gear or self.gear] or 0
end

function Gearbox:request(gear)
	if self.gears[gear] == nil or self.shifting or gear == self.gear then
		return false
	end
	self.pending = gear
	self.shifting = true
	self.timer = self.shifttime
	return true
end

function Gearbox:update(dt)
	if self.shifting then
		self.timer -= dt
		if self.timer <= 0 then
			self.gear = self.pending
			self.shifting = false
		end
	end
end

function Gearbox:outtorque(input)
	if self.shifting then
		return 0
	end
	return input * self:ratio() * self.finaldrive * self.eff
end

function Gearbox:totalratio()
	return self:ratio() * self.finaldrive
end

local Diff = {}
Diff.__index = Diff

function Diff.new(cfg)
	local self = setmetatable({}, Diff)
	self.kind = (cfg.type or "OPEN"):upper()
	self.preload = cfg.preload or 15
	self.powerlock = cfg.powerLock or 0.35
	self.coastlock = cfg.coastLock or 0.15
	self.maxbias = cfg.maxBias or 3
	return self
end

function Diff:split(dt, input, wa, wb, ia, ib)
	local half = input * 0.5

	if self.kind == "OPEN" then
		return half, half
	end

	local wdiff = wa - wb
	local biascap = math.abs(input) * (self.maxbias - 1) * 0.5

	if self.kind == "LOCKED" or self.kind == "WELDED" then
		local a = math.max(ia or 1, 0.01)
		local b = math.max(ib or 1, 0.01)
		local combined = (a * b) / (a + b)
		local lock = math.clamp(wdiff * combined / math.max(dt, 1 / 480), -biascap, biascap)
		return half - lock, half + lock
	end

	if self.kind == "LIMITED" or self.kind == "TORSEN" or self.kind == "CLUTCH_LSD" then
		local lockfrac = input >= 0 and self.powerlock or self.coastlock
		local speedterm = math.clamp(wdiff * 6, -1, 1)
		local bias = (math.abs(input) * lockfrac + self.preload) * speedterm
		bias = math.clamp(bias, -biascap, biascap)
		return half - bias, half + bias
	end

	return half, half
end

local Wheel = {}
Wheel.__index = Wheel

function Wheel.new(cfg)
	local self = setmetatable({}, Wheel)
	self.inertia = cfg.inertia or 1.1
	self.radius = cfg.radius or 0.32
	self.rollres = cfg.rollingResistanceCoefficient or 0.015
	self.omega = 0
	return self
end

function Wheel:update(dt, drive, brake, tireforce, stiffness, normalload, grounded)
	dt = math.max(dt, 1 / 480)
	drive = drive or 0
	brake = math.max(brake or 0, 0)

	local reaction = grounded and (tireforce * self.radius) or 0

	local damping = 0
	if grounded and stiffness and stiffness > 0 then
		damping = stiffness * self.radius * (1 / 0.28) * self.radius
	end

	local rolling = 0
	if grounded and math.abs(self.omega) > 0.01 then
		rolling = self.rollres * normalload * self.radius * (self.omega > 0 and 1 or -1)
	end

	local other = drive - reaction - rolling
	local denom = self.inertia / dt + damping

	if brake > 0.01 then
		local hold = -(other + self.omega * denom)
		if math.abs(hold) <= brake then
			self.omega = 0
			return
		end
		other += (hold >= 0 and 1 or -1) * brake
	end

	self.omega += other / denom
end

local sampleoffsets = {}
local smoothedload = { FR = 0, FL = 0, RR = 0, RL = 0 }
local slaglag = { FR = { x = 0, y = 0 }, FL = { x = 0, y = 0 }, RR = { x = 0, y = 0 }, RL = { x = 0, y = 0 } }
local radii = { 0.1, 0.2, 0.3, 0.4 }

for _, r in ipairs(radii) do
	table.insert(sampleoffsets, { r, 0 })
	table.insert(sampleoffsets, { -r, 0 })
	table.insert(sampleoffsets, { 0, r })
	table.insert(sampleoffsets, { 0, -r })
end
for _, r in ipairs(radii) do
	local d = r * math.sqrt(0.5)
	table.insert(sampleoffsets, { d, d })
	table.insert(sampleoffsets, { d, -d })
	table.insert(sampleoffsets, { -d, d })
	table.insert(sampleoffsets, { -d, -d })
end

local mutable = {
	[Enum.Material.Asphalt] = 1.3, [Enum.Material.Concrete] = 1.3, [Enum.Material.Pavement] = 1.1,
	[Enum.Material.Grass] = 0.7, [Enum.Material.Mud] = 0.25, [Enum.Material.Sand] = 0.4,
	[Enum.Material.Snow] = 0.2, [Enum.Material.Ice] = 0.08, [Enum.Material.Ground] = 1.0,
	[Enum.Material.Rock] = 0.9, [Enum.Material.Salt] = 0.7, [Enum.Material.Basalt] = 0.95,
	[Enum.Material.LeafyGrass] = 0.35, [Enum.Material.CrackedLava] = 0.15, [Enum.Material.Glacier] = 0.1,
	[Enum.Material.Plastic] = 0.7, [Enum.Material.SmoothPlastic] = 0.6, [Enum.Material.Granite] = 0.95,
	[Enum.Material.Slate] = 0.9, [Enum.Material.Wood] = 0.6, [Enum.Material.WoodPlanks] = 0.65,
	[Enum.Material.CorrodedMetal] = 0.9, [Enum.Material.DiamondPlate] = 1.0, [Enum.Material.Metal] = 0.65,
	[Enum.Material.Foil] = 0.15, [Enum.Material.Marble] = 0.45, [Enum.Material.Glass] = 0.05,
	[Enum.Material.Pebble] = 0.5, [Enum.Material.Fabric] = 0.7, [Enum.Material.Neon] = 0.3,
