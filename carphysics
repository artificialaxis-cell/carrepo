	local function queueshift(gear)
		if trans.gears[gear] == nil or gear == trans.gear or trans.shifting then
			return
		end
		if gearmode == "MANUAL" then
			trans:request(gear)
		else
			queuedgear = gear
		end
	end

	local function shift(dir)
		if not driving or gearmode == "AUTOMATIC" then
			return
		end
		if gearmode == "ASSISTED" and (queuedgear or trans.shifting) then
			return
		end
		queueshift(trans.gear + dir)
	end

	local function drivenomega()
		local total = 0
		local count = 0
		for n, isdriven in pairs(driven) do
			if isdriven then
				total += wheelunits[n].omega
				count += 1
			end
		end
		return if count > 0 then total / count else 0
	end

	local function autoselect(dt, thr, brk, domega, erpm, wrpm)
		autocool = math.max(autocool - dt, 0)

		local speed = math.abs(domega) * stats.wheelRadiusMeters
		local typing = uis:GetFocusedTextBox() ~= nil
		local w = not typing and uis:IsKeyDown(Enum.KeyCode.W)
		local s = not typing and uis:IsKeyDown(Enum.KeyCode.S)

		if trans.mingear < 0 then
			if not autoreverse then
				if s and not w and speed < 1 then
					reversehold += dt
					if reversehold > 0.35 then
						reversehold = 0
						autoreverse = true
						updatepedals()
					end
				else
					reversehold = 0
				end
			elseif w and speed < 1.5 then
				autoreverse = false
				updatepedals()
			end
		end

		if trans.shifting or queuedgear then
			return
		end

		local want
		if autoreverse and trans.mingear < 0 then
			want = trans.mingear
		elseif trans.gear < 1 then
			want = 1
		end
		if want then
			if trans.gear ~= want then
				queueshift(want)
				autocool = 0.5
			end
			return
		end

		if autocool > 0 then
			return
		end

		local g = trans.gear
		local ratio = trans:ratio(g)
		if ratio <= 0 then
			return
		end

		local upat = engine.redline * (0.45 + 0.43 * thr)
		local downat = engine.redline * (0.18 + 0.27 * thr)

		local nextratio = trans:ratio(g + 1)
		if nextratio > 0 and brk < 0.5 and autoclutch < 0.35 then
			local after = wrpm * nextratio / ratio
			if math.max(erpm, wrpm) > upat and after > engine.idlerpm * 1.6 then
				queueshift(g + 1)
				autocool = 0.6
				return
			end
		end

		local prevratio = trans:ratio(g - 1)
		if g > 1 and prevratio > 0 then
			local after = wrpm * prevratio / ratio
			if wrpm < downat and after < upat * 0.92 then
				queueshift(g - 1)
				autocool = 0.6
			end
		end
	end

	local function autodrive(dt, thr, brk, domega)
		local idle = engine.idlerpm
		local erpm = engine.omega * 30 / math.pi
		local wrpm = math.abs(domega * trans:totalratio()) * 30 / math.pi

		if gearmode == "AUTOMATIC" and driving then
			autoselect(dt, thr, brk, domega, erpm, wrpm)
		end

		if queuedgear and not trans.shifting and autoclutch >= 0.95 then
			trans:request(queuedgear)
			queuedgear = nil
		end

		local shiftgear = queuedgear or (trans.shifting and trans.pending) or nil
		local enginethr = thr
		local target

		if shiftgear then
			target = 1
			local tr = math.abs(trans:ratio(shiftgear) * trans.finaldrive)
			local goal = if tr > 0 then math.abs(domega) * tr * 30 / math.pi else idle
			goal = math.clamp(goal, idle, engine.redline * 0.95)
			enginethr = math.clamp(0.1 + (goal - erpm) / 600, 0, 1)
		elseif trans.gear == 0 or engine.stalled then
			target = 1
		else
			local lo = idle * 1.1
			local hi = idle * 1.8 + (idle + (engine.redline - idle) * 0.3 - idle * 1.8) * thr
			local launch = smooth((erpm - lo) / math.max(hi - lo, 1))
			local rolling = smooth((wrpm - lo) / (idle * 0.4))
			local engage = math.max(launch, rolling)
			if gearmode == "AUTOMATIC" then
				local creep = 0.12 * (1 - brk) * smooth((erpm - idle * 0.75) / (idle * 0.2))
				engage = math.max(engage, creep)
			end
			target = 1 - engage
		end

		local rateout = 1 / math.max(stats.clutchResponseTime * 0.5, 0.04)
		local ratein = 1 / math.max(stats.clutchResponseTime, 0.12)
		if target > autoclutch then
			autoclutch = math.min(autoclutch + dt * rateout, target)
		else
			autoclutch = math.max(autoclutch - dt * ratein, target)
		end

		return autoclutch, enginethr
	end

	local function step(dt)
		if char then
			char:PivotTo(primary.CFrame)
		end
		
		if not (car:IsDescendantOf(workspace) and mass.Parent ~= nil and primary.Parent ~= nil) then
			destroy()
			return
		end
		dt = math.min(dt, 0.25)

		handbrake = uis:IsKeyDown(Enum.KeyCode.Space)
		tweenval(hbvalue, handbrake and 1 or 0, 0.12)

		local steertime = stats.steerResponseTimeInactive
		local targetsteer = 0
		local mousectl = false

		if driving and not uis:GetFocusedTextBox() then
			if mousesteer then
				local vw = math.max(workspace.CurrentCamera.ViewportSize.X, 1)
				steerval.Value = math.clamp((uis:GetMouseLocation().X / vw) * 2 - 1, -1, 1)
				mousectl = true
			else
				local left = uis:IsKeyDown(Enum.KeyCode.A)
				local right = uis:IsKeyDown(Enum.KeyCode.D)
				if left ~= right then
					targetsteer = if left then -1 else 1
					steertime = stats.steerResponseTimeActive
				end
			end
		end

		if not mousectl then
			local cur = steerval.Value
			if cur < targetsteer then
				steerval.Value = math.min(cur + steertime * dt, targetsteer)
			elseif cur > targetsteer then
				steerval.Value = math.max(cur - steertime * dt, targetsteer)
			end
		end

		if steerslide then
			local kmh = mass.AssemblyLinearVelocity.Magnitude * 0.28 * 3.6
			local steerscale = math.max(1 / (1 + (kmh / 110) ^ 2), 0.2)
			steerslide.Position = Vector3.new(steerval.Value * steerscale * -0.34, -1.17, -7.216)
		end

		local vel = mass.AssemblyLinearVelocity
		local frontstuds = mass.CFrame:VectorToObjectSpace(vel).Z
		local frontmps = frontstuds * 0.28

		updateloadtransfer(dt, frontstuds)

		if drag then
			local dragforce = Vector3.zero
			if vel.Magnitude > 0.01 then
				local newtons = 0.5 * stats.aero.rho * stats.aero.Cd * stats.aero.area * frontmps * math.abs(frontmps)
				dragforce = -vel.Unit * Vector3.new(1, 0.5, 1) * (newtons * (2853 / 1500 / 0.28))
			end
			drag.Force = dragforce
		end

		local thrpedal = thrval.Value
		local brkpedal = brkval.Value
		local cltpedal = cltval.Value
		local enginethr = thrpedal
		if gearmode ~= "MANUAL" then
			cltpedal, enginethr = autodrive(dt, thrpedal, brkpedal, drivenomega())
			cltval.Value = cltpedal
		end

		local tireinfos = {}
		for _, wheel in ipairs(wheels:GetChildren()) do
			if wheelunits[wheel.Name] then
				local info = tirecontact(car, wheel, rayparams)
				tireinfos[wheel.Name] = info
				if not info then
					wheel.Bounds.FrictionForce.Force = Vector3.zero
				end
			end
		end
		local kmh = mass.Velocity.Magnitude * 0.28 * 3.6

		Tacho:Update({
			RPM = car:GetAttribute("RPM"),
			MaxRPM = stats.engine.revLimiter.rpm,
			RedlineRPM = stats.engine.redlineRPM,
			Throttle = 1-cltpedal,
			Brake = brkpedal,
			KMH = kmh,
			Gear = car:GetAttribute("Gear"),
			Velocity = primary.Velocity,
		})

		local steps = math.clamp(math.ceil(dt / (1 / 120)), 1, 8)
		local subdt = dt / steps

		local lastclutch, lastdshaft, lastdomega = 0, 0, 0

		for _ = 1, steps do
			trans:update(subdt)
			local totalratio = trans:totalratio()

			local dshaftomega = 0
			local drivencount = 0
			for n, isdriven in pairs(driven) do
				if isdriven then
					dshaftomega += wheelunits[n].omega
					drivencount += 1
				end
			end
			if drivencount > 0 then
				dshaftomega /= drivencount
			end

			local clutchtorque
			if totalratio ~= 0 then
				local reqomega = dshaftomega * totalratio
				local inertiasum = masskg * stats.wheelRadiusMeters * stats.wheelRadiusMeters
				for n, isdriven in pairs(driven) do
					if isdriven then
						inertiasum += wheelunits[n].inertia
					end
				end
				local reflected = inertiasum / (totalratio * totalratio)
				clutchtorque = clutch:update(subdt, engine.omega, engine.inertia, reqomega, reflected, cltpedal)
			else
				clutch:update(subdt, engine.omega, engine.inertia, engine.omega, 0, cltpedal)
				clutchtorque = 0
			end

			engine:update(subdt, enginethr, clutchtorque)
			local dshafttorque = trans:outtorque(clutchtorque)

			local fronttorque, reartorque = 0, 0
			if stats.transmission.type == "AWD" then
				local fo = (wheelunits.FL.omega + wheelunits.FR.omega) * 0.5
				local ro = (wheelunits.RL.omega + wheelunits.RR.omega) * 0.5
				local fi = wheelunits.FL.inertia + wheelunits.FR.inertia
				local ri = wheelunits.RL.inertia + wheelunits.RR.inertia
				if centerdiff then
					fronttorque, reartorque = centerdiff:split(subdt, dshafttorque, fo, ro, fi, ri)
				else
					fronttorque = dshafttorque * (stats.transmission.awd.frontBias or 0.5)
					reartorque = dshafttorque * (stats.transmission.awd.rearBias or 0.5)
				end
			elseif stats.transmission.type == "FWD" then
				fronttorque = dshafttorque
			else
				reartorque = dshafttorque
			end

			local drivetorque = { FL = 0, FR = 0, RL = 0, RR = 0 }
			if driven.FL or driven.FR then
				drivetorque.FL, drivetorque.FR = axlediff:split(subdt, fronttorque, wheelunits.FL.omega, wheelunits.FR.omega, wheelunits.FL.inertia, wheelunits.FR.inertia)
			end
			if driven.RL or driven.RR then
				drivetorque.RL, drivetorque.RR = axlediff:split(subdt, reartorque, wheelunits.RL.omega, wheelunits.RR.omega, wheelunits.RL.inertia, wheelunits.RR.inertia)
			end

			local fbrake = brkpedal * stats.brakes.maxTorqueFront
			local rbrake = brkpedal * stats.brakes.maxTorqueRear + hbvalue.Value * stats.brakes.handbrakeTorque
			local braketorque = { FL = fbrake, FR = fbrake, RL = rbrake, RR = rbrake }

			for n, wu in pairs(wheelunits) do
				local info = tireinfos[n]
				local fforce, nload, stiff = 0, 0, 0
				if info then
					local surface = (wu.omega * wu.radius) * (1 / 0.28)
					local delta = (n == "FL" or n == "FR") and frontdelta or reardelta
					fforce, nload, stiff = gripupdate(info, surface, subdt, delta, stats)
				end
				wu:update(subdt, drivetorque[n], braketorque[n], fforce, stiff, nload, info ~= nil)
			end

			lastclutch = clutchtorque
			lastdshaft = dshafttorque
			lastdomega = dshaftomega
		end

		for _, wheel in ipairs(wheels:GetChildren()) do
			local wu = wheelunits[wheel.Name]
			if wu then
				local attr = wheelattrs[wheel.Name]
				if attr then
					car:SetAttribute(attr, (wu.omega * wu.radius) * (1 / 0.28))
				end

				local roll = wheel.Roll
				roll.Value = (roll.Value + math.deg(wu.omega) * dt) % 360
				wheel.Bounds.SpinAtt.CFrame = CFrame.fromOrientation(math.rad(-roll.Value), 0, 0)
				
			end
		end
		
		if tiredebug then
			if not dbgfolder then
				dbgfolder = Instance.new("Folder")
				dbgfolder.Name = "TireDebug"
			end
			dbgfolder.Parent = cam

			for name in pairs(wheelunits) do
				local tire = wheels[name].Bounds
				local info = tireinfos[name]
				local d = dbgparts[name]
				
				tire.Transparency = 0

				if not d then
					d = {}
					local hl = Instance.new("Highlight")
					hl.Adornee = tire
					hl.FillTransparency = 0.65
					hl.OutlineTransparency = 0
					hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
					hl.Parent = dbgfolder
					d.hl = hl

					for key, class in pairs({
						contact = "SphereHandleAdornment",
						comp = "CylinderHandleAdornment",
						facebody = "CylinderHandleAdornment",
						facehead = "ConeHandleAdornment",
						forcebody = "CylinderHandleAdornment",
						forcehead = "ConeHandleAdornment",
						}) do
						local a = Instance.new(class)
						a.Adornee = workspace.Terrain
						a.AlwaysOnTop = true
						a.ZIndex = 5
						a.Visible = false
						a.Parent = dbgfolder
						d[key] = a
					end

					d.contact.Radius = 0.12
					d.contact.Color3 = Color3.new(1, 1, 1)
					d.facebody.Radius = 0.05
					d.facebody.Color3 = Color3.fromRGB(60, 140, 255)
					d.facehead.Radius = 0.22
					d.facehead.Height = 0.6
					d.facehead.Color3 = Color3.fromRGB(60, 140, 255)
					d.forcebody.Radius = 0.06
					d.forcehead.Radius = 0.25
					d.forcehead.Height = 0.6

					dbgparts[name] = d
				end

				local slip = math.clamp(car:GetAttribute(name .. "totalSlip") or 0, 0, 1)

				if info then
					local cpos = info.cpos
					local tcf = tire.CFrame
					local up = tcf.UpVector
					local start = tire.TIRESTART.WorldPosition
					local contactradius = car:GetAttribute("tireend") + 0.35 - car:GetAttribute("tirestart")
					local compression = math.clamp(-((start - cpos):Dot(up) - contactradius) / contactradius, 0, 1)

					d.hl.FillColor = Color3.fromRGB(0, 255, 120):Lerp(Color3.fromRGB(255, 60, 60), slip)
					d.hl.OutlineColor = d.hl.FillColor

					d.contact.Visible = true
					d.contact.CFrame = CFrame.new(cpos)

					local side = tcf.RightVector * 0.5
					local ca = start + side
					local cb = cpos + side
					local clen = math.max((cb - ca).Magnitude, 0.01)
					d.comp.Visible = true
					d.comp.Height = clen
					d.comp.Radius = 0.04 + 0.12 * compression
					d.comp.Color3 = Color3.fromRGB(0, 255, 120):Lerp(Color3.fromRGB(255, 40, 40), compression)
					d.comp.CFrame = CFrame.lookAt(ca, cb) * CFrame.new(0, 0, -clen / 2)

					local flat = Vector3.new(tcf.LookVector.X, 0, tcf.LookVector.Z)
					flat = if flat.Magnitude > 0.01 then flat.Unit else Vector3.zAxis
					local ftail = cpos + Vector3.yAxis * 0.15
					local fhead = ftail + flat * 3
					d.facebody.Visible = true
					d.facebody.Height = 3
					d.facebody.CFrame = CFrame.lookAt(ftail, fhead) * CFrame.new(0, 0, -1.5)
					d.facehead.Visible = true
					d.facehead.CFrame = CFrame.lookAt(fhead, fhead + flat) * CFrame.Angles(0, math.pi, 0)

					local gforce = tire.FrictionForce.Force
					if gforce.Magnitude > 1 then
						local gdir = gforce.Unit
						local gcolor = Color3.fromRGB(255, 230, 0):Lerp(Color3.fromRGB(255, 40, 40), slip)
						local gtail = cpos + Vector3.yAxis * 0.3
						local ghead = gtail + gdir * 3.5
						d.forcebody.Visible = true
						d.forcebody.Height = 3.5
						d.forcebody.Color3 = gcolor
						d.forcebody.CFrame = CFrame.lookAt(gtail, ghead) * CFrame.new(0, 0, -1.75)
						d.forcehead.Visible = true
						d.forcehead.Color3 = gcolor
						d.forcehead.CFrame = CFrame.lookAt(ghead, ghead + gdir) * CFrame.Angles(0, math.pi, 0)
					else
						d.forcebody.Visible = false
						d.forcehead.Visible = false
					end
				else
					d.hl.FillColor = Color3.fromRGB(150, 150, 150)
					d.hl.OutlineColor = d.hl.FillColor
					d.contact.Visible = false
					d.comp.Visible = false
					d.facebody.Visible = false
					d.facehead.Visible = false
					d.forcebody.Visible = false
					d.forcehead.Visible = false
				end
			end
		elseif dbgfolder then
			dbgfolder.Parent = nil
			
			for name in pairs(wheelunits) do
				local tire = wheels[name].Bounds

				tire.Transparency = 1
			end
		end
		
		local gear = trans.gear
		local rpm = engine.omega * 30 / math.pi
		car:SetAttribute("RPM", rpm)
		car:SetAttribute("EngineStalled", engine.stalled)
		car:SetAttribute("Gear", gear)
		car:SetAttribute("Handbrake", handbrake)
		
		do
			for _, c in pairs(chans) do
				c.v = 0
			end

			local now = os.clock()
			local running = driving and not engine.stalled
			local wheelrpm = math.abs(drivenomega()) * 30 / math.pi
			local speed = kmh / 3.6
			local powered = trans.gear ~= 0 and not trans.shifting

			local inside = car:GetAttribute("CamInterior") == true or (cam.CFrame.Position - primary.Position).Magnitude < 6
			sv.interior += ((inside and 1 or 0) - sv.interior) * (1 - math.exp(-6 * dt))
			local ib = sv.interior
			local exl = 1 - (mix.exteriorLowpassHz or 20000) / 20000
			local inl = 1 - (mix.interiorLowpassHz or 2800) / 20000
			sv.eq.HighGain = math.clamp(-24 * (exl * (1 - ib) + inl * ib), -80, 10)
			sv.eq.MidGain = -4 * ib
			sv.eq.LowGain = 3 * ib
			sg.Volume = 1 + ((mix.interiorVolumeMult or 0.7) - 1) * ib

			if driving and not sv.wasdriving then
				sv.enteredat = now
				sv.runat = now + 0.9
				oneshot(cf.door.open, 0.6)
				task.delay(0.35, function()
					oneshot(cf.door.close, 0.7)
				end)
				task.delay(0.55, function()
					oneshot(cf.seatbelt.id, 0.5)
				end)
				task.delay(0.65, function()
					oneshot(cf.ignition.id, 0.7)
				end)
				task.delay(0.75, function()
					oneshot(cf.start.id, cf.start.volume or 1)
				end)
				local rv = mix.reverbType and Enum.ReverbType:FromName(mix.reverbType)
				if rv and not sv.reverbset then
					sv.prevreverb = sv.svc.AmbientReverb
					sv.svc.AmbientReverb = rv
					sv.reverbset = true
				end
			end
			if not driving and sv.wasdriving then
				oneshot(cf.door.open, 0.6)
				task.delay(0.5, function()
					oneshot(cf.door.close, 0.7)
				end)
				car:SetAttribute("Indicator", 0)
				if sv.reverbset and sv.prevreverb then
					sv.svc.AmbientReverb = sv.prevreverb
					sv.reverbset = false
				end
			end
			sv.wasdriving = driving

			if running and not sv.wasrunning and now - sv.enteredat > 0.2 then
				oneshot(cf.start.id, cf.start.volume or 1)
				sv.runat = now + 0.5
			end
			if not running and sv.wasrunning then
				oneshot(cf.stop.id, cf.stop.volume or 1)
			end
			sv.wasrunning = running

			local mtarget = (running and now >= sv.runat) and 1 or 0
			sv.master += (mtarget - sv.master) * (1 - math.exp(-(mtarget == 1 and 8 or 14) * dt))
			local master = sv.master

			local loadtarget = math.clamp(math.max(enginethr * 1.5, lastclutch / 150), 0, 1)
			sv.load += (loadtarget - sv.load) * (1 - math.exp(-dt / math.max(snd.engine.loadCrossfadeTime or 0.12, 0.01)))
			local ld = sv.load
			sv.power += ((thrpedal > 0.05 and 1 or 0) - sv.power) * (1 - math.exp(-8 * dt))

			local pmin = snd.engine.pitchMin or 0.6
			local pmax = snd.engine.pitchMax or 2.2
			local idlefade = chans.idle and math.clamp(1 - (rpm - engine.idlerpm) / 700, 0, 1) or 0

			for _, set in ipairs({ "on", "off" }) do
				for i, l in ipairs(snd.engine[set]) do
					local c = chans[set .. i]
					if c then
						local fin = 1
						if (l.fadeInEnd or 0) > (l.fadeInStart or 0) then
							fin = math.sin(math.clamp((rpm - l.fadeInStart) / (l.fadeInEnd - l.fadeInStart), 0, 1) * math.pi / 2)
						end
						local fout = 1
						if (l.fadeOutEnd or 99999) > (l.fadeOutStart or 99999) then
							fout = math.cos(math.clamp((rpm - l.fadeOutStart) / (l.fadeOutEnd - l.fadeOutStart), 0, 1) * math.pi / 2)
						end
						c.v = l.volume * fin * fout * (set == "on" and ld or (1 - ld)) * master * math.sqrt(1 - idlefade) * (1 - ib * 0.15)
						c.p = math.clamp(rpm / l.refRPM, pmin, pmax)
					end
				end
			end

			if chans.idle then
				chans.idle.v = cf.idle.volume * master * math.sqrt(idlefade)
				chans.idle.p = math.clamp(rpm / engine.idlerpm, cf.idle.pitchMin or 0.95, cf.idle.pitchMax or 1.05)
			end

			if chans.limiter then
				chans.limiter.v = (engine.limiting and thrpedal > 0.5) and cf.limiter.volume * master or 0
				chans.limiter.p = cf.limiter.pitchFollowsRPM and math.clamp(rpm / 6000, 0.7, 1.3) or 1
			end

			local thr = math.clamp(enginethr, 0, 1)

			if chans.intake then
				local vb = cf.intake.volumeByThrottle or { [0] = 1, [0.5] = 1, [1] = 1 }
				local iv = thr < 0.5 and vb[0] + (vb[0.5] - vb[0]) * (thr / 0.5) or vb[0.5] + (vb[1] - vb[0.5]) * ((thr - 0.5) / 0.5)
				chans.intake.v = (cf.intake.volume or 0.5) * iv * master * math.clamp(rpm / 1500, 0.2, 1) * (1 + ib * 0.5)
				chans.intake.p = math.clamp(rpm / cf.intake.refRPM, pmin, pmax)
			end

			if chans.exhaust then
				local vb = cf.exhaust.volumeByThrottle or { [0] = 1, [0.5] = 1, [1] = 1 }
				local ev = thr < 0.5 and vb[0] + (vb[0.5] - vb[0]) * (thr / 0.5) or vb[0.5] + (vb[1] - vb[0.5]) * ((thr - 0.5) / 0.5)
				chans.exhaust.v = (cf.exhaust.volume or 0.8) * ev * master * (1 - ib * 0.4)
				chans.exhaust.p = math.clamp(rpm / cf.exhaust.refRPM, pmin, pmax)
			end

			if thrpedal > 0.5 then
				sv.popsarmed = true
				sv.bovarmed = true
			end

			if sv.popsarmed and thrpedal < (cf.pops.throttleLiftBelow or 0.05) then
				sv.popsarmed = false
				local ids = cf.pops.ids or {}
				if running and rpm > (cf.pops.minRPM or 3500) and #ids > 0 and math.random() < (cf.pops.chance or 0.35) then
					for i = 1, math.random(1, 4) do
						task.delay((i - 1) * math.random(6, 16) / 100 + math.random() * 0.05, function()
							local pv = cf.pops.pitchVariation or 0.15
							oneshot(ids[math.random(#ids)], (cf.pops.volume or 0.7) * (0.6 + math.random() * 0.4), 1 + (math.random() * 2 - 1) * pv)
						end)
					end
				end
			end

			local boosttarget = math.clamp((rpm - 2000) / 2500, 0, 1) * math.clamp(thrpedal, 0, 1) * (running and 1 or 0)
			local spoolup = cf.spool.spoolUpTime or 0.6
			local spooldown = cf.spool.spoolDownTime or 1.2
			sv.boost += (boosttarget - sv.boost) * (1 - math.exp(-dt / (boosttarget > sv.boost and spoolup or spooldown)))
			car:SetAttribute("Boost", sv.boost)

			if chans.turbospool then
				local tf = sv.boost * math.clamp(rpm / engine.redline, 0.3, 1)
				chans.turbospool.v = (cf.spool.volumeMin + (cf.spool.volumeMax - cf.spool.volumeMin) * sv.boost) * master * (1 + ib * 0.6)
				chans.turbospool.p = cf.spool.pitchMin + (cf.spool.pitchMax - cf.spool.pitchMin) * tf
			end

			sv.bovcool = math.max(sv.bovcool - dt, 0)
			if sv.bovarmed and thrpedal < (cf.blowoff.throttleLiftBelow or 0.1) then
				sv.bovarmed = false
				if running and sv.boost >= (cf.blowoff.minBoost or 0.4) and sv.bovcool <= 0 then
					local fl = cf.flutter.ids or {}
					if #fl > 0 and math.random() < (cf.flutter.chance or 0.5) then
						oneshot(fl[math.random(#fl)], (cf.flutter.volume or 0.7) * sv.boost, 0.95 + math.random() * 0.1)
					else
						oneshot(cf.blowoff.id, (cf.blowoff.volume or 0.8) * sv.boost, 0.95 + math.random() * 0.1)
					end
					sv.boost *= 0.4
					sv.bovcool = cf.blowoff.cooldown or 0.5
				end
			end

			if chans.gearwhine then
				local gw = cf.whine
				local g = trans.gear
				local pm = 1
				local vm = 1
				if g < 0 then
					pm = gw.reverse and gw.reverse.pitchMult or 1
					vm = gw.reverse and gw.reverse.volumeMult or 1
				elseif g > 0 then
					pm = gw.perGearPitchMult and gw.perGearPitchMult[g] or 1
					vm = gw.perGearVolumeMult and gw.perGearVolumeMult[g] or 1
				end
				local wv = (gw.volumeOnCoast + (gw.volumeOnPower - gw.volumeOnCoast) * sv.power) * vm
				chans.gearwhine.v = wv * math.clamp(wheelrpm / 150, 0, 1) * (powered and 1 or 0) * (1 - cltpedal) * (1 + ib * 0.5)
				chans.gearwhine.p = math.clamp(wheelrpm / gw.refWheelRPM * pm, gw.pitchMin, gw.pitchMax)
			end

			if chans.diffwhine then
				chans.diffwhine.v = cf.diffwhine.volume * math.clamp(wheelrpm / 250, 0, 1) * (0.5 + 0.5 * sv.power) * (1 + ib * 0.3)
				chans.diffwhine.p = math.clamp(wheelrpm / cf.diffwhine.refWheelRPM, cf.diffwhine.pitchMin, cf.diffwhine.pitchMax)
			end

			if chans.driveshaft then
				local dsrpm = wheelrpm * math.abs(trans:totalratio())
				chans.driveshaft.v = cf.driveshaft.volume * math.clamp(dsrpm / 1500, 0, 1) * (0.4 + 0.6 * sv.power) * (powered and 1 or 0)
				chans.driveshaft.p = math.clamp(dsrpm / 3000, 0.5, 2)
			end

			if trans.gear ~= sv.lastgear then
				local cl = cf.clunk.ids or {}
				if driving and trans.gear ~= 0 and #cl > 0 then
					oneshot(cl[math.random(#cl)], cf.clunk.volume or 0.6, 0.95 + math.random() * 0.1)
				end
				sv.lastgear = trans.gear
			end

			if cltpedal < 0.4 and sv.lastclutch >= 0.4 and driving and trans.gear ~= 0 then
				oneshot(cf.clutchengage.id, cf.clutchengage.volume or 0.4, 0.95 + math.random() * 0.1)
			end
			sv.lastclutch = cltpedal

			local maxslip = 0
			local grounded = 0
			local mat = nil
			for n, info in pairs(tireinfos) do
				grounded += 1
				maxslip = math.max(maxslip, car:GetAttribute(n .. "totalSlip") or 0)
				mat = mat or info.mat
			end
			local surface = mat and surfacemap[mat] or "asphalt"

			if chans.squeal then
				local sq = cf.squeal
				local f = math.clamp((maxslip - sq.slipStart) / (sq.slipFull - sq.slipStart), 0, 1)
				chans.squeal.v = f * sq.volume * (surface == "asphalt" and 1 or 0.15)
				chans.squeal.p = sq.pitchMin + (sq.pitchMax - sq.pitchMin) * math.clamp(speed / 40, 0, 1)
			end

			if chans.skid then
				local f = math.clamp((maxslip - cf.skid.slipStart) / 0.5, 0, 1)
				chans.skid.v = f * cf.skid.volume * (surface == "asphalt" and 1 or 0.5)
				chans.skid.p = 0.85 + 0.3 * math.clamp(speed / 40, 0, 1)
			end

			for key, rc in pairs(cf.roll) do
				local c = chans["road" .. key]
				if c then
					c.v = (key == surface and grounded > 0) and rc.volume * math.clamp(speed / 6, 0, 1) * (grounded / 4) or 0
					c.p = math.clamp(speed / rc.refSpeed, rc.pitchMin, rc.pitchMax)
				end
			end

			if chans.kickup then
				local loose = surface ~= "asphalt" and grounded > 0
				local f = math.clamp((speed - cf.kickup.minSpeed) / 12, 0, 1)
				chans.kickup.v = loose and cf.kickup.volume * f * (0.4 + 0.6 * math.clamp(maxslip, 0, 1)) or 0
				chans.kickup.p = math.clamp(0.8 + speed / 60, 0.8, 1.4)
			end

			if chans.bsqueal then
				local bs = cf.bsqueal
				local f = math.clamp((brkpedal - bs.minBrake) / (1 - bs.minBrake), 0, 1)
					* math.clamp((speed - bs.minSpeed) / 2, 0, 1)
					* math.clamp((bs.maxSpeed - speed) / 4, 0, 1)
				chans.bsqueal.v = f * bs.volume
				chans.bsqueal.p = 0.9 + 0.4 * math.clamp(1 - speed / bs.maxSpeed, 0, 1)
			end

			if handbrake and not sv.hb then
				oneshot(cf.handbrake.id, cf.handbrake.volume or 0.6)
			end
			sv.hb = handbrake

			if chans.abs then
				chans.abs.v = (brkpedal > 0.8 and speed > 5 and maxslip > 0.35) and cf.abs.volume * math.clamp(speed / 15, 0, 1) or 0
				chans.abs.p = 1
			end

			if chans.wind then
				local wd = cf.wind
				local f = math.clamp(speed / wd.refSpeed, 0, 1.5)
				chans.wind.v = (wd.volumeMin + (wd.volumeMax - wd.volumeMin) * math.min(f * f, 1)) * (1 + ib * 0.4)
				chans.wind.p = math.clamp(speed / wd.refSpeed, wd.pitchMin, wd.pitchMax)
			end

			if chans.rattle then
				local rr = cf.rattle.refRPM or 2500
				chans.rattle.v = cf.rattle.volume * math.exp(-((rpm - rr) / 500) ^ 2) * master * (1 + ib)
				chans.rattle.p = 1
			end

			sv.bottomcool = math.max(sv.bottomcool - dt, 0)
			local cr = car:GetAttribute("tireend") + 0.35 - car:GetAttribute("tirestart")
			local bumps = cf.bump.ids or {}
			for n in pairs(sv.comp) do
				if not tireinfos[n] then
					sv.comp[n] = nil
				end
			end
			for n, info in pairs(tireinfos) do
				local comp = cr - (info.tire.TIRESTART.WorldPosition - info.cpos):Dot(info.tire.CFrame.UpVector)
				local prev = sv.comp[n] or 0
				sv.comp[n] = comp
				sv.wheelcool[n] = math.max((sv.wheelcool[n] or 0) - dt, 0)
				if driving and now - sv.enteredat > 1.5 then
					local cspeed = (comp - prev) / math.max(dt, 1 / 240) * 0.28
					if cspeed > (cf.bump.minCompressionSpeed or 0.6) and sv.wheelcool[n] <= 0 and #bumps > 0 then
						oneshot(bumps[math.random(#bumps)], (cf.bump.volume or 0.5) * math.clamp(cspeed / 3, 0.3, 1), 0.9 + math.random() * 0.2)
						sv.wheelcool[n] = 0.2
					end
					if comp / cr > 0.95 and sv.bottomcool <= 0 then
						oneshot(cf.bottom.id, cf.bottom.volume or 0.9, 0.95 + math.random() * 0.1)
						sv.bottomcool = 0.5
					end
				end
			end

			sv.impactcool = math.max(sv.impactcool - dt, 0)
			local accel = (vel - sv.prevvel).Magnitude * 0.28 / math.max(dt, 1 / 120)
			sv.prevvel = vel
			if driving and sv.impactcool <= 0 and now - sv.enteredat > 1.5 then
				local tier = (accel > 700 and "heavy") or (accel > 300 and "medium") or (accel > 120 and "light") or nil
				if tier then
					oneshot(cf.impacts[tier], 0.5 + math.min(accel / 1400, 0.5), 0.9 + math.random() * 0.2)
					sv.impactcool = 0.3
				end
			end

			local ind = car:GetAttribute("Indicator") or 0
			if ind ~= 0 and driving then
				sv.indtimer += dt
				if sv.indtimer >= 0.4 then
					sv.indtimer -= 0.4
					sv.indstate = not sv.indstate
					if sv.indstate then
						oneshot(cf.indicator.on, 0.4)
					else
						oneshot(cf.indicator.off, 0.4)
					end
				end
			else
				sv.indtimer = 0
				sv.indstate = false
			end

			for _, c in pairs(chans) do
				c.s.Volume += (c.v - c.s.Volume) * (1 - math.exp(-c.vk * dt))
				c.s.PlaybackSpeed += (c.p - c.s.PlaybackSpeed) * (1 - math.exp(-c.pk * dt))
				if c.v < 0.003 and c.s.Volume < 0.003 then
					if c.s.Playing then
						c.s:Pause()
					end
				elseif not c.s.Playing then
					c.s:Play()
				end
			end
		end

		if stats.debug.enabled then
			car:SetAttribute("Debug_ClutchSlipRadPerSec", clutch.slip)
			car:SetAttribute("Debug_ClutchTorque", lastclutch)
			car:SetAttribute("Debug_DriveshaftTorque", lastdshaft)
			car:SetAttribute("Debug_DriveshaftOmega", lastdomega)
			car:SetAttribute("Debug_EngineNetTorque", engine.lastnet)
			car:SetAttribute("Debug_EngineCombustionTorque", engine.lastcomb)
		end
	end

	table.insert(conns, uis.InputBegan:Connect(function(input, processed)
		if processed or not driving then
			return
		end
		local key = input.KeyCode

		if key == Enum.KeyCode.W or key == Enum.KeyCode.S then
			updatepedals()
		elseif key == Enum.KeyCode.LeftShift then
			if gearmode == "MANUAL" then
				tweenval(cltval, 1, stats.clutchResponseTime)
			end
		elseif key == Enum.KeyCode.V then
			local idx = table.find(gearmodes, gearmode) or 1
			setgearmode(gearmodes[idx % #gearmodes + 1])
		elseif key == Enum.KeyCode.E then
			if os.clock() - enteredat > 0.25 then
				shift(1)
			end
		elseif key == Enum.KeyCode.Q then
			shift(-1)
		elseif key == Enum.KeyCode.M then
			mousesteer = not mousesteer
		elseif key == Enum.KeyCode.R then
			if engine.stalled and (gearmode ~= "MANUAL" or trans.gear == 0 or cltval.Value >= 0.9) then
				engine:restart()
			end
		elseif key == Enum.KeyCode.F then
			leavecar()
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
			camrmb = true
			uis.MouseBehavior = Enum.MouseBehavior.LockCenter
		elseif key == Enum.KeyCode.N then
			tiredebug = not tiredebug
		elseif key == Enum.KeyCode.Z then
			car:SetAttribute("Indicator", car:GetAttribute("Indicator") == 1 and 0 or 1)
		elseif key == Enum.KeyCode.X then
			car:SetAttribute("Indicator", car:GetAttribute("Indicator") == 2 and 0 or 2)
		elseif key == Enum.KeyCode.C and driving then
			uivisible += 1
			if uivisible == 4 then
				uivisible = 1
			end
			local tachovis = false
			if uivisible == 1 or uivisible == 2 then
				tachovis = true
			end
			local controlsvis = false
			if uivisible == 1 then
				controlsvis = true
			end
			Tacho:Visibility(tachovis)
			
			player.PlayerGui:FindFirstChild("TachoUI").ControlsFrame.Visible = controlsvis
		end
	end))

	table.insert(conns, uis.InputEnded:Connect(function(input)
		if not driving then
			return
		end
		local key = input.KeyCode

		if key == Enum.KeyCode.W or key == Enum.KeyCode.S then
			updatepedals(key)
		elseif key == Enum.KeyCode.LeftShift then
			if gearmode == "MANUAL" then
				tweenval(cltval, 0, stats.clutchResponseTime / 2)
			end
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
			camrmb = false
			uis.MouseBehavior = Enum.MouseBehavior.Default
		end
	end))

	table.insert(conns, uis.InputChanged:Connect(function(input)
		if not driving then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseMovement and camrmb then
			camalpha -= input.Delta.X * 0.0085
			cambeta = math.clamp(cambeta - input.Delta.Y * 0.0085, -1.1, 1.3)
		elseif input.UserInputType == Enum.UserInputType.MouseWheel then
			camdist = math.clamp(camdist - input.Position.Z * 3, 7, 45)
		end
	end))

	table.insert(conns, prompt.Triggered:Connect(entercar))

	table.insert(conns, player.CharacterRemoving:Connect(function()
		if driving then
			leavecar()
		end
	end))

	table.insert(conns, car.AncestryChanged:Connect(function()
		if not car:IsDescendantOf(workspace) then
			destroy()
		end
	end))

	table.insert(conns, car.Destroying:Connect(destroy))

	task.delay(0.5, function()
		if not alive then
			return
		end

		mass.Anchored = false
		releasecontrols(true)

		table.insert(conns, rs.RenderStepped:Connect(step))

		if player.Character then
			player.Character:WaitForChild("Humanoid", 5)
			player.Character:WaitForChild("HumanoidRootPart", 5)
			entercar()
		else
			local cconn
			cconn = player.CharacterAdded:Connect(function(nc)
				if cconn then
					cconn:Disconnect()
				end
				nc:WaitForChild("Humanoid", 5)
				nc:WaitForChild("HumanoidRootPart", 5)
				entercar()
			end)
			table.insert(conns, cconn)
		end
	end)
end

return CarController
