	local function readWheelAttributes()
		for _, w in ipairs(wheelList) do
			local m = w.model
			if m:GetAttribute("RayStart") then
				w.rayStart = m:GetAttribute("RayStart")
				w.rayLength = m:GetAttribute("RayLength")
				w.tireRate = m:GetAttribute("TireRate")
				w.tireDamper = m:GetAttribute("TireDamper")
			else
				-- legacy rig: one tire spec on the car
				local tstart = car:GetAttribute("tirestart") or 1.2
				local tend = car:GetAttribute("tireend") or 1.52
				w.rayStart = tstart
				w.rayLength = tend + 0.35 - tstart
				w.tireRate = (car:GetAttribute("psi") or 950) * 300
				w.tireDamper = car:GetAttribute("damper") or 3900
			end
		end
	end

	local function applyStats(newStats)
		stats = newStats
		masskg = stats.massKg or (mass.AssemblyMass / KG_TO_RMU)
		local tires = stats.tires or {}
		tireLong.muload = tires.loadSensLong or LONG.muload
		tireLat.muload = tires.loadSensLat or LAT.muload
		tireLong.relax = tires.relaxLong or LONG.relax
		tireLat.relax = tires.relaxLat or LAT.relax

		if engine then
			engine:configure(stats.engine)
			clutch:configure(stats.clutch)
			trans:configure(stats.transmission)
			axlediff:configure(stats.transmission.differential)
		else
			engine = Engine.new(stats.engine)
			clutch = Clutch.new(stats.clutch)
			trans = Gearbox.new(stats.transmission)
			axlediff = Diff.new(stats.transmission.differential)
		end
		local layout = stats.transmission.type
		if layout == "AWD" then
			local awd = stats.transmission.awd or {}
			local cfg = { type = awd.centerDiff or "LIMITED" }
			if centerdiff then
				centerdiff:configure(cfg)
			else
				centerdiff = Diff.new(cfg)
			end
		else
			centerdiff = nil
		end

		table.clear(driven)
		if layout == "FWD" then
			driven.FL, driven.FR = true, true
		elseif layout == "AWD" then
			driven.FL, driven.FR, driven.RL, driven.RR = true, true, true, true
		else
			driven.RL, driven.RR = true, true
		end

		for _, w in ipairs(wheelList) do
			local r = w.model:GetAttribute("Radius")
			if r then
				w.radius = r * STUD
			else
				w.radius = stats.wheelRadiusMeters
			end
			w.inertia = stats.wheelInertia or 1.1
			w.rollres = stats.aero.rollingResistance or 0.015
		end
		readWheelAttributes()
	end
	applyStats(stats)
