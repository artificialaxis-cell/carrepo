local function togglecollide(char, enabled, cache)
	if not char then
		return
	end
	if enabled then
		for part, orig in pairs(cache) do
			if part.Parent then
				part.CanCollide = orig
			end
		end
		table.clear(cache)
	else
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				cache[part] = part.CanCollide
				part.CanCollide = false
			end
		end
	end
end

-- The humanoid keeps re-enabling collision on some limbs, so the seated driver needs
-- explicit no-collision pairs against the car's colliding parts.
local function ignoreCharacter(car, char)
	local holder = Instance.new("Folder")
	holder.Name = "DriverNoCollide"
	local mine = {}
	for _, part in ipairs(car:GetDescendants()) do
		if part:IsA("BasePart") and part.CanCollide then
			table.insert(mine, part)
		end
	end
	for _, limb in ipairs(char:GetDescendants()) do
		if limb:IsA("BasePart") then
			for _, part in ipairs(mine) do
				local c = Instance.new("NoCollisionConstraint")
				c.Part0 = part
				c.Part1 = limb
				c.Parent = holder
			end
		end
	end
	holder.Parent = car
	return holder
end

local function findCarSounds()
	local folder = ReplicatedStorage:FindFirstChild("CarSounds")
	if not folder then
		folder = ReplicatedStorage:WaitForChild("CarSounds", 3)
	end
	return folder
end

local function resolveSoundWith(folder, id)
	if type(id) == "number" then
		return id ~= 0 and ("rbxassetid://" .. id) or nil
	end
	if type(id) ~= "string" or id == "" or id == "rbxassetid://0" then
		return nil
	end
	if id:match("^rbxassetid://%d+$") or id:match("^rbxasset://") or id:match("^https?://") then
		return id
	end
	if id:match("^%d+$") then
		return "rbxassetid://" .. id
	end
	if not folder then
		return nil
	end
	local sound = folder:FindFirstChild(id, true)
	if not sound then
		local base = id:gsub("%.%w+$", "")
		sound = folder:FindFirstChild(base, true)
		if not sound then
			for _, ext in ipairs({ ".wav", ".mp3", ".ogg", ".flac" }) do
				sound = folder:FindFirstChild(base .. ext, true)
				if sound then
					break
				end
			end
		end
	end
	if sound and sound:IsA("Sound") and sound.SoundId ~= "" then
		return sound.SoundId
	end
	return nil
end

function CarController:HandleCar(car, initialStats)
	if typeof(car) ~= "Instance" or not car:IsA("Model") then
		warn("CarController:HandleCar expects a car Model")
		return
	end
	if handled[car] then
		return handled[car]
	end
	local player = Players.LocalPlayer
	if not player then
		warn("CarController:HandleCar must be called from a client script")
		return
	end

	for _, name in ipairs(REQUIRED) do
		if not car:FindFirstChild(name) then
			warn(("CarController: %s is missing '%s'"):format(car:GetFullName(), name))
			return
		end
	end
	for orig, clones in pairs(RENAMES) do
		for _, cname in ipairs(clones) do
			local child = car:FindFirstChild(cname, true)
			if child then
				child.Name = orig
			end
		end
	end

	local stats = initialStats or (_G.ReturnStats and _G.ReturnStats(car, car.Mass))
	if type(stats) ~= "table" then
		warn("CarController: no stats for " .. car:GetFullName())
		return
	end

	local wheelsFolder = car.Wheels
	local mass = car.Mass
	local primary = car.Primary
	local thrval, brkval, cltval, steerval = car.Throttle, car.Brake, car.Clutch, car.Steer
	local drivermass = car:FindFirstChild("DriverMass")
	local drag = mass:FindFirstChild("Drag")
	local massGravity = mass:FindFirstChild("GravityComp")
	local steerslide = primary:FindFirstChild("SteerSlide")
	local slideBase = steerslide and steerslide.Position
	local downF = primary:FindFirstChild("DownforceFront")
	local downR = primary:FindFirstChild("DownforceRear")
	local legacy = car:GetAttribute("Wheelbase") == nil
	if legacy and steerslide then
		slideBase = Vector3.new(0, -1.17, -7.216)
	end

	local ctl = { car = car }
	handled[car] = ctl

	local playerGui = player:FindFirstChildOfClass("PlayerGui")
	if playerGui and not playerGui:FindFirstChild("TachoUI") then
		pcall(Tacho.Create, Tacho)
		Tacho:Visibility(false)
	end

	-- raycast filter: the original maps keep drivable geometry in Map/Built
	local rayparams = RaycastParams.new()
	local includes = {}
	for _, name in ipairs({ "Map", "Built" }) do
		local folder = workspace:FindFirstChild(name)
		if folder then
			table.insert(includes, folder)
		end
	end
	if #includes > 0 then
		rayparams.FilterType = Enum.RaycastFilterType.Include
		rayparams.FilterDescendantsInstances = includes
	else
		rayparams.FilterType = Enum.RaycastFilterType.Exclude
		local list = { car }
		if player.Character then
			table.insert(list, player.Character)
		end
		local thrown = workspace:FindFirstChild("Thrown")
		if thrown then
			table.insert(list, thrown)
		end
		rayparams.FilterDescendantsInstances = list
	end
	rayparams.IgnoreWater = true

	----------------------------------------------------------------------------------
	-- per-car state
	----------------------------------------------------------------------------------

	local engine, clutch, trans, axlediff, centerdiff
	local driven = {}
	local wheels = {}
	local wheelList = {}
	local masskg
	local tireLong, tireLat = table.clone(LONG), table.clone(LAT)

	for _, name in ipairs(WHEELS) do
		local model = wheelsFolder:FindFirstChild(name)
		local bounds = model and model:FindFirstChild("Bounds")
		if bounds then
			local radiusStuds = model:GetAttribute("Radius") or bounds.Size.Y / 2
			local w = {
				name = name,
				front = name == "FL" or name == "FR",
				model = model,
				bounds = bounds,
