	local function updateloadtransfer(dt, frontstuds)
		local frontmps = frontstuds * 0.28
		local cgheight = stats.cgHeightMeters or stats.defaultCgHeightMeters
		local wheelbase = stats.wheelbaseMeters or stats.defaultWheelbaseMeters

		local longaccel = (frontmps - prevmps) / math.max(dt, 1 / 240)
		prevmps = frontmps

		local transfer = (masskg * longaccel * cgheight) / wheelbase
		frontdelta = -transfer * 0.5
		reardelta = transfer * 0.5
	end

	local function leavecar()
		if not driving then
			return
		end
		driving = false
		player.Character.HumanoidRootPart.Anchored = false
		stopcamera()
		Tacho:Visibility(false)
		local exitcf = entrycf
		if car:IsDescendantOf(workspace) and mass:IsDescendantOf(car) then
			local mcf = mass.CFrame
			local side = -1
			if drivermass then
				side = if mcf:PointToObjectSpace(drivermass.Position).X < 0 then -1 else 1
			end

			local halfwidth = car:GetExtentsSize().X * 0.5
			local r = Vector3.new(mcf.RightVector.X, 0, mcf.RightVector.Z)
			r = if r.Magnitude < 0.01 then Vector3.xAxis else r.Unit
			local l = Vector3.new(mcf.LookVector.X, 0, mcf.LookVector.Z)
			l = if l.Magnitude < 0.01 then -Vector3.zAxis else l.Unit

			local pos = mcf.Position + r * side * (halfwidth + 3) + Vector3.yAxis * 2
			exitcf = CFrame.lookAt(pos, pos + l)
		end

		releasecontrols(true)

		if diedconn then
			diedconn:Disconnect()
			diedconn = nil
		end

		togglecollide(char, true, collidecache)

		if root and root.Parent then
			root.Anchored = false
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
			root.CFrame = exitcf
		end

		char, hum, root = nil, nil, nil

		if alive and prompt.Parent then
			prompt.Enabled = true
		end
	end

