	local function startcamera()
		if camactive then
			return
		end
		camactive = true
		campvel = mass.AssemblyLinearVelocity
		camfov = cam.FieldOfView
		campos = nil
		camfocus = nil
		cam.CameraType = Enum.CameraType.Scriptable

		rs:BindToRenderStep(cambind, Enum.RenderPriority.Camera.Value + 1, function(dt)
			if not (car:IsDescendantOf(workspace) and mass.Parent) then
				camactive = false
				rs:UnbindFromRenderStep(cambind)
				return
			end

			if not camrmb then
				local look = mass.CFrame.LookVector
				local flat = Vector3.new(look.X, 0, look.Z)
				if flat.Magnitude > 0.02 then
					local target = math.atan2(-flat.X, -flat.Z)
					local diff = math.atan2(math.sin(target - camalpha), math.cos(target - camalpha))
					camalpha += diff * (1 - math.exp(-1.4 * dt))
				end
			end

			local vel = mass.AssemblyLinearVelocity
			local rawaccel = (vel - campvel) / math.max(dt, 1 / 240)
			campvel = vel

			local fwdaccel = math.clamp(rawaccel:Dot(mass.CFrame.LookVector), -60, 60)
			camaccel += (fwdaccel - camaccel) * (1 - math.exp(-3 * dt))
			fwdaccel = camaccel

			local kmh = vel.Magnitude * 0.28 * 3.6

			local slip = (car:GetAttribute("FRtotalSlip") or 0)
				+ (car:GetAttribute("FLtotalSlip") or 0)
				+ (car:GetAttribute("RRtotalSlip") or 0)
				+ (car:GetAttribute("RLtotalSlip") or 0)

			local targetfov = 68 + math.clamp(kmh / 260, 0, 1) * 10 + math.clamp(fwdaccel / 35, 0, 1) * 4
			camfov += (targetfov - camfov) * (1 - math.exp(-3 * dt))
			cam.FieldOfView = camfov

			local dist = camdist + math.clamp(kmh / 300, 0, 1) * 6
			local focus = mass.Position + Vector3.new(0, 2.6, 0)
			local orbit = CFrame.new(focus) * CFrame.Angles(0, camalpha, 0) * CFrame.Angles(cambeta, 0, 0)
			local desired = orbit * CFrame.new(0, 0, dist)

			desired += orbit.LookVector * (math.clamp(-fwdaccel / 30, -1, 1) * 1.2)

			local shake = math.clamp(math.max(math.clamp(slip, 0, 4) - 1.2, 0) * 0.25, 0, 1) * 0.12
			local t = os.clock()
			local shakeoffset = cam.CFrame.RightVector * math.noise(t * 7, camseed) * shake
				+ cam.CFrame.UpVector * math.noise(t * 8, camseed + 40) * shake

			campos = campos or desired.Position
			camfocus = camfocus or focus

			campos = campos:Lerp(desired.Position, 1 - math.exp(-6 * dt))
			camfocus = camfocus:Lerp(focus, 1 - math.exp(-8 * dt))

			cam.CFrame = CFrame.lookAt(campos + shakeoffset, camfocus)
		end)
	end

