local CORNERS = {
	FL = { front = true, side = -1 },
	FR = { front = true, side = 1 },
	RL = { front = false, side = -1 },
	RR = { front = false, side = 1 },
}
Chassis.CORNERS = CORNERS
Chassis.ORDER = { "FL", "FR", "RL", "RR" }

local function v3(x, y, z)
	return Vector3.new(x, y, z)
end

------------------------------------------------------------------------------------------
-- Front kinematics solver
--
-- Solves the knuckle pose for a given vertical wheel travel with the steering held
-- straight, from the actual constraints the chassis uses (two wishbone rods to the ball
-- joint, strut line through the tower). Used to place the inner tie-rod pivot so the
-- steering arm's path is a circle around it, i.e. no bump steer.
------------------------------------------------------------------------------------------

local function solveLinear(A, b)
	local n = #b
	for col = 1, n do
		local pivot, best = col, math.abs(A[col][col])
		for row = col + 1, n do
			if math.abs(A[row][col]) > best then
				pivot, best = row, math.abs(A[row][col])
			end
		end
		if best < 1e-12 then
			return nil
		end
		A[col], A[pivot] = A[pivot], A[col]
		b[col], b[pivot] = b[pivot], b[col]
		for row = col + 1, n do
			local f = A[row][col] / A[col][col]
			for k = col, n do
				A[row][k] -= f * A[col][k]
			end
			b[row] -= f * b[col]
		end
	end
	local x = {}
	for row = n, 1, -1 do
		local s = b[row]
		for k = row + 1, n do
			s -= A[row][k] * x[k]
		end
		x[row] = s / A[row][row]
	end
	return x
end

-- pts: corner points at design pose. Returns world-space (chassis) position of `point`
-- (a design-pose point on the knuckle) after vertical travel `delta`.
local function knucklePath(pts, delta, point)
	local C = pts.center
	local bj = pts.links[1].hub - C
	local hs = pts.hubStrut - C
	local arm = point - C
	local pickA, pickB = pts.links[1].body, pts.links[2].body
	local lenA, lenB = (pts.links[1].hub - pickA).Magnitude, (pts.links[2].hub - pickB).Magnitude
	local dir = pts.strutDir
	local ref = math.abs(dir.Z) < 0.95 and Vector3.zAxis or Vector3.xAxis
	local n1 = (ref - dir * ref:Dot(dir)).Unit
	local n2 = dir:Cross(n1).Unit
	local tower = pts.strutTop

	local function pose(x)
		return CFrame.new(C + Vector3.new(x[1], x[2], x[3])) * CFrame.Angles(x[4], x[5], x[6])
	end
	local function residual(x)
		local cf = pose(x)
		local p = cf.Position
		local hsW = cf:PointToWorldSpace(hs)
		local look = cf.LookVector
		return {
			(cf:PointToWorldSpace(bj) - pickA).Magnitude - lenA,
			(cf:PointToWorldSpace(bj) - pickB).Magnitude - lenB,
			(tower - hsW):Dot(cf:VectorToWorldSpace(n1)),
			(tower - hsW):Dot(cf:VectorToWorldSpace(n2)),
			p.Y - (C.Y + delta),
			look.X,
		}
	end

	local x = { 0, delta, 0, 0, 0, 0 }
	for _ = 1, 25 do
		local f = residual(x)
		local err = 0
		for i = 1, 6 do
			err += f[i] * f[i]
		end
		if err < 1e-14 then
			break
		end
		local J = {}
		for i = 1, 6 do
			J[i] = {}
		end
		for j = 1, 6 do
			local h = 1e-5
			local xp = table.clone(x)
			xp[j] += h
			local fp = residual(xp)
			for i = 1, 6 do
				J[i][j] = (fp[i] - f[i]) / h
			end
		end
		local rhs = {}
		for i = 1, 6 do
			rhs[i] = -f[i]
		end
		local step = solveLinear(J, rhs)
		if not step then
			return nil
		end
		for j = 1, 6 do
			x[j] += step[j]
		end
	end
	return pose(x):PointToWorldSpace(arm)
end

-- Pivot that keeps |pivot - path(delta)| constant through droop, ride and bump.
local function tieRodPivot(pts, nominal, droop, bump)
	local a0 = knucklePath(pts, 0, pts.steerArm)
	local a1 = knucklePath(pts, -droop, pts.steerArm)
	local a2 = knucklePath(pts, bump, pts.steerArm)
	if not (a0 and a1 and a2) then
		return nil
	end
	local u, v = a1 - a0, a2 - a0
	local normal = u:Cross(v)
	if normal.Magnitude < 1e-6 then
		-- straight path: any point in the plane normal to it works
		local d = (a2 - a1).Unit
		local tie = nominal - a0
		return a0 + (tie - d * tie:Dot(d)).Unit * tie.Magnitude
	end
	-- circumcentre of the three arm positions; pivots on the circle's axis are equidistant
	local uu, vv, uv = u:Dot(u), v:Dot(v), u:Dot(v)
	local denom = 2 * (uu * vv - uv * uv)
	local s = vv * (uu - uv) / denom
	local t = uu * (vv - uv) / denom
	local center = a0 + u * s + v * t
	local axis = normal.Unit
	local pivot = center + axis * (nominal - center):Dot(axis)
	local length = (pivot - a0).Magnitude
	local nominalLength = (nominal - a0).Magnitude
	if length > nominalLength * 2.5 or length < nominalLength * 0.4 then
		-- nearly straight path: an exact pivot would need an absurd tie rod, so settle
		-- for zero first-order bump steer at the nominal length
		local d = (a2 - a1).Unit
		local tie = nominal - a0
		return a0 + (tie - d * tie:Dot(d)).Unit * nominalLength
	end
	return pivot
end

-- All suspension points for one corner in chassis space.
function Chassis.corner(layout, name)
	local info = CORNERS[name]
	local wb = layout.rearZ - layout.frontZ
	local front = info.front
	local half = (front and layout.trackFront or layout.trackRear) / 2
	local r = front and layout.radiusFront or layout.radiusRear
	local inb = -info.side -- +1 points toward the centreline
	local C = v3(info.side * half, 0, front and -wb / 2 or wb / 2)

	-- keep inboard pickups on their own side of the car for narrow tracks
	local reach = math.max(half - 0.25, 0.2)
	local function inward(fraction)
		return inb * math.min(fraction * r, reach)
	end

	local pts = { center = C, radius = r, front = front, side = info.side }
	pts.hubStrut = C + v3(inward(0.3865), 0.2548 * r, 0)
	if front then
		pts.strutTop = C + v3(inward(0.5045), 1.154 * r, 0.217 * r)
		pts.links = {
			{ hub = C + v3(inward(0.152), -0.215 * r, 0), body = C + v3(inward(0.890), -0.067 * r, -0.147 * r) },
			{ hub = C + v3(inward(0.152), -0.215 * r, 0), body = C + v3(inward(0.819), -0.067 * r, 0.550 * r) },
		}
		pts.steerArm = C + v3(inward(0.103), 0.009 * r, 0.289 * r)
		pts.rackNominal = C + v3(inward(0.870), -0.009 * r, 0.366 * r)
		local axis = pts.strutTop - pts.links[1].hub
		local arm = pts.steerArm - pts.links[1].hub
		local along = axis.Unit * arm:Dot(axis.Unit)
		pts.steerArmLength = (arm - along).Magnitude
	else
		pts.strutTop = C + v3(inward(0.478), 1.221 * r, 0)
		pts.links = {
			{ hub = C + v3(inward(0.365), -0.031 * r, 0.303 * r), body = C + v3(inward(1.562), -0.016 * r, 0.291 * r) },
			{ hub = C + v3(inward(0.365), -0.031 * r, -0.303 * r), body = C + v3(inward(1.562), -0.016 * r, -0.306 * r) },
			{ hub = C + v3(inward(0.365), -0.210 * r, -0.303 * r), body = C + v3(inward(0.800), -0.144 * r, -1.238 * r) },
		}
	end
	local strut = pts.strutTop - pts.hubStrut
	pts.strutLength = strut.Magnitude
	pts.strutDir = strut.Unit
	pts.strutCos = math.abs(pts.strutDir.Y)
	if front then
		-- inner tie-rod pivot from the solved knuckle path (zero bump steer); fall back
		-- to the nominal point if the solver does not converge
		pts.rackEnd = tieRodPivot(pts, pts.rackNominal, 0.40 * r, 0.35 * r) or pts.rackNominal
	end
	return pts
end

-- Geometry summary handed to Spec.build.
function Chassis.geometry(layout)
	local fl = Chassis.corner(layout, "FL")
	local rl = Chassis.corner(layout, "RL")
	return {
		wheelbase = layout.rearZ - layout.frontZ,
		trackFront = layout.trackFront,
		trackRear = layout.trackRear,
		radiusFront = layout.radiusFront,
		radiusRear = layout.radiusRear,
		widthFront = layout.widthFront,
		widthRear = layout.widthRear,
		strutCosFront = fl.strutCos,
		strutCosRear = rl.strutCos,
		steerArm = fl.steerArmLength,
	}
end

-- Body frame relative to the chassis frame.
function Chassis.bodyOffset(layout)
	return CFrame.new(0, -layout.wheelY, -(layout.frontZ + layout.rearZ) / 2)
end

