-- Proportions of the stock car, used to estimate a layout from the body bounds alone.
local EST = {
	wheelbase = 0.6052,
	center = -0.0224,
	trackFront = 0.7472,
	trackRear = 0.7116,
	wheelY = -0.3673,
	radius = 0.0699,
	width = 0.80,
}

local FIELDS = { "frontZ", "rearZ", "trackFront", "trackRear", "wheelY", "radiusFront", "radiusRear", "widthFront", "widthRear" }
Chassis.FIELDS = FIELDS

local function copyLayout(t)
	local out = {}
	for key, value in pairs(t) do
		out[key] = value
	end
	return out
end
Chassis.copyLayout = copyLayout

function Chassis.estimate(bodySize, tireSize)
	bodySize = bodySize or Vector3.new(10.16, 6.36, 23.42)
	local L, W, H = bodySize.Z, bodySize.X, bodySize.Y
	local wb = EST.wheelbase * L
	local center = EST.center * L
	local radius, width
	if tireSize then
		local dims = { tireSize.X, tireSize.Y, tireSize.Z }
		table.sort(dims)
		width = dims[1]
		radius = (dims[2] + dims[3]) / 4
	else
		radius = EST.radius * L
		width = EST.width * radius
	end
	return {
		frontZ = center - wb / 2,
		rearZ = center + wb / 2,
		trackFront = EST.trackFront * W,
		trackRear = EST.trackRear * W,
		wheelY = EST.wheelY * H,
		radiusFront = radius,
		radiusRear = radius,
		widthFront = width,
		widthRear = width,
	}
end

-- Try to read the layout straight from where the wheel meshes sit. Accepts it only if
-- the pieces form a plausible rectangle of four wheels around the body.
function Chassis.detect(bodyFrame, wheelPieces, radius)
	radius = radius or 1.6
	local clusters = {}
	for _, piece in ipairs(wheelPieces) do
		local p = bodyFrame:PointToObjectSpace(piece.Position)
		local home
		for _, c in ipairs(clusters) do
			if (c.center - p).Magnitude < radius * 0.6 then
				home = c
				break
			end
		end
		if home then
			home.sum += p
			home.n += 1
			home.center = home.sum / home.n
		else
			table.insert(clusters, { sum = p, n = 1, center = p })
		end
	end
	if #clusters ~= 4 then
		return nil
	end
	local left, right = {}, {}
	for _, c in ipairs(clusters) do
		if c.center.X < -radius * 0.5 then
			table.insert(left, c.center)
		elseif c.center.X > radius * 0.5 then
			table.insert(right, c.center)
		end
	end
	if #left ~= 2 or #right ~= 2 then
		return nil
	end
	local function byZ(a, b)
		return a.Z < b.Z
	end
	table.sort(left, byZ)
	table.sort(right, byZ)
	local fl, rl, fr, rr = left[1], left[2], right[1], right[2]
	if (rl.Z - fl.Z) < radius * 2.2 or (rr.Z - fr.Z) < radius * 2.2 then
		return nil
	end
	if math.abs(fl.Z - fr.Z) > radius or math.abs(rl.Z - rr.Z) > radius then
		return nil
	end
	return {
		frontZ = (fl.Z + fr.Z) / 2,
		rearZ = (rl.Z + rr.Z) / 2,
		trackFront = fr.X - fl.X,
		trackRear = rr.X - rl.X,
		wheelY = (fl.Y + fr.Y + rl.Y + rr.Y) / 4,
	}
end

--[[
	Resolve a layout. Priority: saved profile > detected from wheel meshes > known body >
	estimate from body bounds. Radii come from the measured tire mesh unless the source
	specifies them.
	input = { bodyMeshId, bodySize, bodyFrame, wheelPieces, tireSize, profiles }
]]
function Chassis.resolve(input)
	local base = Chassis.estimate(input.bodySize, input.tireSize)
	local layout, source

	local profile = input.profiles and input.bodyMeshId and input.profiles[input.bodyMeshId]
	if profile then
		layout, source = profile, "profile"
	end
	if not layout and input.bodyFrame and input.wheelPieces and #input.wheelPieces > 0 then
		layout = Chassis.detect(input.bodyFrame, input.wheelPieces, base.radiusFront)
		source = layout and "detected" or nil
	end
	if not layout and input.bodyMeshId and Chassis.KNOWN[input.bodyMeshId] then
		layout, source = Chassis.KNOWN[input.bodyMeshId], "known"
	end
	if not layout then
		layout, source = base, "estimated"
	end

	local out = copyLayout(base)
	for _, key in ipairs(FIELDS) do
		if layout[key] ~= nil then
			out[key] = layout[key]
		end
	end
	out.source = source
	return out
end

