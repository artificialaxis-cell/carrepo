local function new(class, props, parent)
	local inst = Instance.new(class)
	for key, value in pairs(props) do
		inst[key] = value
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function invisiblePart(name, size, cf, parent, extra)
	local part = new("Part", {
		Name = name,
		Size = size,
		CFrame = cf,
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Anchored = false,
		CastShadow = false,
		Material = Enum.Material.SmoothPlastic,
		TopSurface = Enum.SurfaceType.Smooth,
		BottomSurface = Enum.SurfaceType.Smooth,
	})
	if extra then
		for key, value in pairs(extra) do
			part[key] = value
		end
	end
	part.Parent = parent
	return part
end

local function attachment(name, parent, worldCf)
	return new("Attachment", { Name = name, CFrame = parent.CFrame:ToObjectSpace(worldCf) }, parent)
end

local function weld(a, b, parent)
	return new("WeldConstraint", { Part0 = a, Part1 = b }, parent or a)
end

