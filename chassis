--[[
	Chassis
	-------
	Procedural chassis generation.

	Input is a *layout*: where the four wheels sit relative to the body mesh and how big they
	are. From that the generator derives every dependent point - strut towers, wishbone and
	link pickups, steering rack and tie rods, collision hull, mass and driver placement - as
	proportions of the wheel radius and track, so any body/wheel combination gets a chassis
	that fits it. Spring, damper and tire rates are applied separately (`applyTuning`) so they
	can be changed live without rebuilding.

	Coordinate frame used throughout ("chassis space"):
	  origin  = midpoint between the axles at wheel-centre height
	  +X      = right, +Y = up, -Z = forward (Roblox LookVector)

	The stock car's geometry was measured from the original hand-built rig and expressed in
	these proportions, so the default body reproduces the original suspension layout.
]]

local AssetService = game:GetService("AssetService")

local Chassis = {}

local Spec

function Chassis.setup(deps)
	Spec = deps.Spec
end

------------------------------------------------------------------------------------------
-- Measuring meshes
------------------------------------------------------------------------------------------

-- survives respawns: asset bounds never change
local meshSizes = _G.CarHubMeshSizes or {}
_G.CarHubMeshSizes = meshSizes

-- Measure many meshes at once (each lookup is a network round trip).
function Chassis.prefetch(meshIds)
	local pending = 0
	local done = Instance.new("BindableEvent")
	for _, id in ipairs(meshIds) do
		if meshSizes[id] == nil then
			pending += 1
			task.spawn(function()
				Chassis.meshSize(id)
				pending -= 1
				if pending == 0 then
					done:Fire()
				end
			end)
		end
	end
	if pending > 0 then
		done.Event:Wait()
	end
	done:Destroy()
end

-- Native size of a mesh asset. Yields the first time an id is seen.
function Chassis.meshSize(meshId)
	if not meshId or meshId == "" then
		return nil
	end
	local cached = meshSizes[meshId]
	if cached ~= nil then
		return cached or nil
	end
	local ok, part = pcall(AssetService.CreateMeshPartAsync, AssetService, meshId)
	if ok and part then
		meshSizes[meshId] = part.MeshSize
		part:Destroy()
	else
		meshSizes[meshId] = false
	end
	return meshSizes[meshId] or nil
end

-- Rendered size of a part, accounting for SpecialMesh scale.
function Chassis.visualSize(part)
	local mesh = part:FindFirstChildOfClass("SpecialMesh")
	if not mesh then
		return part.Size
	end
	if mesh.MeshType == Enum.MeshType.FileMesh then
		local native = Chassis.meshSize(mesh.MeshId)
		if native then
			return native * mesh.Scale
		end
		return nil
	end
	return part.Size * mesh.Scale
end

