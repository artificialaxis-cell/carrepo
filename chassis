-- Build
------------------------------------------------------------------------------------------

--[[
	Build a drivable chassis.
	  layout  - resolved layout (body space)
	  stats   - output of Spec.build for this geometry
	  origin  - world CFrame of the chassis frame
	  body    - optional { size = Vector3 } for collision hull sizing
	Returns the car Model (unparented).
]]
function Chassis.build(layout, stats, origin, body)
	local car = new("Model", { Name = "SuspensionGroup" })
	local wb = layout.rearZ - layout.frontZ
	local rAvg = (layout.radiusFront + layout.radiusRear) / 2
	local trackAvg = (layout.trackFront + layout.trackRear) / 2

	local primary = invisiblePart("Primary", Vector3.new(trackAvg * 0.7, rAvg * 0.4, wb * 1.2), origin, car, {
		Massless = true,
		CustomPhysicalProperties = PhysicalProperties.new(0.01, 0.3, 0.5, 1, 1),
	})
	car.PrimaryPart = primary

	new("Folder", { Name = "Aerodynamics" }, car)
	local suspension = new("Folder", { Name = "Suspension" }, car)
	local wheels = new("Folder", { Name = "Wheels" }, car)
	local colliders = new("Folder", { Name = "Colliders" }, car)
	for _, name in ipairs({ "Throttle", "Brake", "Clutch", "Steer" }) do
		new("NumberValue", { Name = name }, car)
	end

	-- sprung masses ------------------------------------------------------------------
	local massPart = invisiblePart("Mass", Vector3.new(trackAvg * 1.29, rAvg * 3.02, wb * 1.255), origin, car)
	weld(massPart, primary)
	local massAtt = new("Attachment", { Name = "Attachment" }, massPart)
	new("VectorForce", {
		Name = "Drag",
		Attachment0 = massAtt,
		RelativeTo = Enum.ActuatorRelativeTo.World,
		ApplyAtCenterOfMass = true,
		Force = Vector3.zero,
		Visible = false,
	}, massPart)
	new("VectorForce", {
		Name = "GravityComp",
		Attachment0 = massAtt,
		RelativeTo = Enum.ActuatorRelativeTo.World,
		ApplyAtCenterOfMass = true,
		Force = Vector3.zero,
		Visible = false,
	}, massPart)

	local driver = invisiblePart("DriverMass", Vector3.new(1.386, 2.74, 2.736) * rAvg, origin, car, {
		CustomPhysicalProperties = PhysicalProperties.new(4, 0.3, 0.5, 1, 1),
	})
	weld(driver, primary)

	-- downforce application points (one per axle)
	for _, axle in ipairs({ { "DownforceFront", -wb / 2 }, { "DownforceRear", wb / 2 } }) do
		local att = new("Attachment", { Name = axle[1] .. "Att", Position = Vector3.new(0, 0, axle[2]) }, primary)
		new("VectorForce", {
			Name = axle[1],
			Attachment0 = att,
			RelativeTo = Enum.ActuatorRelativeTo.World,
			Force = Vector3.zero,
			Visible = false,
		}, primary)
	end

	-- steering rack ------------------------------------------------------------------
	local fl = Chassis.corner(layout, "FL")
	local fr = Chassis.corner(layout, "FR")
	local rackCenter = (fl.rackEnd + fr.rackEnd) / 2
	local rackSpan = math.max(fr.rackEnd.X - fl.rackEnd.X, 0.4)
	local rack = invisiblePart("SteeringRack", Vector3.new(rackSpan, 0.38 * rAvg, 0.38 * rAvg), origin * CFrame.new(rackCenter), suspension)
	local slide = attachment("SteerSlide", primary, origin * CFrame.new(rackCenter))
	local slideRack = attachment("SteerSlide_2", rack, origin * CFrame.new(rackCenter))
	new("RigidConstraint", { Name = "Rack", Attachment0 = slide, Attachment1 = slideRack, Visible = false }, rack)
	local rackEnds = {
		FL = attachment("SteerFL", rack, origin * CFrame.new(fl.rackEnd)),
		FR = attachment("SteerFR", rack, origin * CFrame.new(fr.rackEnd)),
	}
	car:SetAttribute("SteerArm", fl.steerArmLength)

	-- corners --------------------------------------------------------------------------
	local rims = {}
	for _, name in ipairs(Chassis.ORDER) do
		local pts = Chassis.corner(layout, name)
		local r = pts.radius
		local width = pts.front and layout.widthFront or layout.widthRear
		local centerCf = origin * CFrame.new(pts.center)

		local model = new("Model", { Name = name }, wheels)
		local bounds = invisiblePart("Bounds", Vector3.new(width, r * 2, r * 2), centerCf, model, {
			Shape = Enum.PartType.Cylinder,
			CustomPhysicalProperties = PhysicalProperties.new(Spec.WHEEL_DENSITY, 0.7, 0, 100, 100),
		})
		model.PrimaryPart = bounds
		local rim = invisiblePart("Rim", Vector3.new(width * 1.05, r * 1.36, r * 1.36), centerCf, model, {
			Shape = Enum.PartType.Cylinder,
			CanCollide = true,
			Massless = true,
		})
		weld(rim, bounds)
		table.insert(rims, rim)
		new("NumberValue", { Name = "Roll" }, model)
		new("Folder", { Name = "Rotating" }, model)
		new("Folder", { Name = "Static" }, model)

		local forceAtt = new("Attachment", { Name = "ForceAtt", Position = Vector3.new(0, -r, 0) }, bounds)
		local smoke = new("ParticleEmitter", { Name = "TireSmoke" }, forceAtt)
		for key, value in pairs(SMOKE) do
			smoke[key] = value
		end
		new("Attachment", { Name = "SpinAtt" }, bounds)
		new("Attachment", { Name = "TIRESTART" }, bounds)
		new("Attachment", { Name = "TIREEND" }, bounds)
		local center = new("Attachment", { Name = "CenterAtt" }, bounds)
		for _, forceName in ipairs({ "TireForce", "FrictionForce" }) do
			new("VectorForce", {
				Name = forceName,
				Attachment0 = forceAtt,
				RelativeTo = Enum.ActuatorRelativeTo.World,
				Force = Vector3.zero,
				Visible = false,
			}, bounds)
		end
		new("VectorForce", {
			Name = "GravityComp",
			Attachment0 = center,
			RelativeTo = Enum.ActuatorRelativeTo.World,
			ApplyAtCenterOfMass = true,
			Force = Vector3.zero,
			Visible = false,
		}, bounds)

		model:SetAttribute("Radius", r)
		model:SetAttribute("Width", width)
		model:SetAttribute("Front", pts.front)

		-- hub (steering knuckle / upright)
		local hub = invisiblePart(name .. "Hub", Vector3.one * 0.38 * r, centerCf, suspension, { Massless = true })
		weld(bounds, hub, bounds)

		local dir = pts.strutDir
		local ref = math.abs(dir.Z) < 0.95 and Vector3.zAxis or Vector3.xAxis
		local n1 = (ref - dir * ref:Dot(dir)).Unit
		local n2 = dir:Cross(n1).Unit
		local strutA = attachment("StrutA", hub, origin * CFrame.fromMatrix(pts.hubStrut, n1, dir))
		local strutB = attachment("StrutB", hub, origin * CFrame.fromMatrix(pts.hubStrut, n2, dir))
		local tower = attachment(name .. "Tower", primary, origin * CFrame.new(pts.strutTop))

		-- the two planes intersect along the strut axis: the tower slides on that line
		new("PlaneConstraint", { Attachment0 = strutA, Attachment1 = tower, Visible = false }, hub)
		new("PlaneConstraint", { Attachment0 = strutB, Attachment1 = tower, Visible = false }, hub)
		local spring = new("SpringConstraint", {
			Name = "Spring",
			Attachment0 = strutA,
			Attachment1 = tower,
			LimitsEnabled = true,
			Coils = 5,
			Radius = 0.15 * r,
			Thickness = 0.075 * r,
			Color = ROD_COLOR,
			Visible = true,
			MaxForce = 1e7,
		}, hub)
		spring:SetAttribute("DesignLength", pts.strutLength)
		spring:SetAttribute("Front", pts.front)

		for i, link in ipairs(pts.links) do
			local a = attachment("LinkHub" .. i, hub, origin * CFrame.new(link.hub))
			local b = attachment(name .. "Link" .. i, primary, origin * CFrame.new(link.body))
			new("RodConstraint", {
				Attachment0 = a,
				Attachment1 = b,
				Length = (link.hub - link.body).Magnitude,
				Thickness = 0.075 * r,
				Color = ROD_COLOR,
				Visible = true,
			}, hub)
		end

		if pts.front then
			local arm = attachment("SteerArm", hub, origin * CFrame.new(pts.steerArm))
			local length = (pts.steerArm - pts.rackEnd).Magnitude
			new("SpringConstraint", {
				Name = "FlexibleSteerStrut",
				Attachment0 = rackEnds[name],
				Attachment1 = arm,
				LimitsEnabled = true,
				FreeLength = length,
				MinLength = length * 0.98,
				MaxLength = length * 1.02,
				Coils = 0,
				Radius = 0,
				Thickness = 0.075 * r,
				Color = BrickColor.new("Lemon metalic"),
				Visible = true,
				MaxForce = 1e7,
			}, hub)
		end
	end

	-- collision hull -----------------------------------------------------------------
	local bodyOffset = Chassis.bodyOffset(layout)
	local bodySize = body and body.size or Vector3.new(trackAvg * 1.34, rAvg * 3.9, wb * 1.65)
	local bodyCf = origin * bodyOffset
	local bottom = -bodySize.Y / 2
	local hulls = {
		{ "LowerHull", Vector3.new(bodySize.X * 0.94, bodySize.Y * 0.45, bodySize.Z * 0.96), CFrame.new(0, bottom + bodySize.Y * 0.375, 0) },
		{ "Cabin", Vector3.new(bodySize.X * 0.78, bodySize.Y * 0.32, bodySize.Z * 0.5), CFrame.new(0, bottom + bodySize.Y * 0.76, bodySize.Z * 0.05) },
	}
	for _, hull in ipairs(hulls) do
		local part = invisiblePart(hull[1], hull[2], bodyCf * hull[3], colliders, {
			CanCollide = true,
			Massless = true,
			CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.35, 0.1, 1, 1),
		})
		weld(part, primary)
		for _, rim in ipairs(rims) do
			new("NoCollisionConstraint", { Part0 = part, Part1 = rim }, part)
		end
	end

	-- record the design so tuning can be applied later
	car:SetAttribute("Wheelbase", wb)
	car:SetAttribute("TrackFront", layout.trackFront)
	car:SetAttribute("TrackRear", layout.trackRear)
	car:SetAttribute("RadiusFront", layout.radiusFront)
	car:SetAttribute("RadiusRear", layout.radiusRear)
	car:SetAttribute("WidthFront", layout.widthFront)
	car:SetAttribute("WidthRear", layout.widthRear)
	car:SetAttribute("StrutCosFront", fl.strutCos)
	car:SetAttribute("StrutCosRear", Chassis.corner(layout, "RL").strutCos)
	car:SetAttribute("WheelY", layout.wheelY)
	car:SetAttribute("AxleCenter", (layout.frontZ + layout.rearZ) / 2)

	Chassis.applyTuning(car, stats)
	return car
end

-- Geometry of a built car (same shape as Chassis.geometry).
function Chassis.geometryOf(car)
	local wb = car:GetAttribute("Wheelbase")
	if not wb then
		return nil
	end
	return {
		wheelbase = wb,
		trackFront = car:GetAttribute("TrackFront"),
		trackRear = car:GetAttribute("TrackRear"),
		radiusFront = car:GetAttribute("RadiusFront"),
		radiusRear = car:GetAttribute("RadiusRear"),
		widthFront = car:GetAttribute("WidthFront"),
		widthRear = car:GetAttribute("WidthRear"),
		strutCosFront = car:GetAttribute("StrutCosFront"),
		strutCosRear = car:GetAttribute("StrutCosRear"),
		steerArm = car:GetAttribute("SteerArm"),
	}
end

------------------------------------------------------------------------------------------
-- Live tuning: springs, tires, mass placement, collision
------------------------------------------------------------------------------------------

local function placeMasses(car, stats)
	local primary = car:FindFirstChild("Primary")
	local massPart = car:FindFirstChild("Mass")
	local driver = car:FindFirstChild("DriverMass")
	if not (primary and massPart) then
		return
	end
	local wb = car:GetAttribute("Wheelbase")
	local rAvg = (car:GetAttribute("RadiusFront") + car:GetAttribute("RadiusRear")) / 2
	local trackAvg = (car:GetAttribute("TrackFront") + car:GetAttribute("TrackRear")) / 2
	local frame = primary.CFrame

	local target = stats.massKg * Spec.KG_TO_RMU
	local others, moment = 0, Vector3.zero
	local function add(part, localPos)
		if part then
			local m = part:GetMass()
			others += m
			moment += localPos * m
		end
	end

	if driver then
		local side = stats.chassis.driverSide == "Left" and -1 or 1
		local localPos = Vector3.new(side * 0.231 * trackAvg, 1.59 * rAvg, -0.072 * wb)
		local w = driver:FindFirstChildOfClass("WeldConstraint")
		if w then
			w.Enabled = false
		end
		driver.CFrame = frame * CFrame.new(localPos)
		if w then
			w.Enabled = true
		end
		add(driver, localPos)
	end
	local rack = car:FindFirstChild("Suspension") and car.Suspension:FindFirstChild("SteeringRack")
	if rack then
		add(rack, frame:PointToObjectSpace(rack.Position))
	end

	local own = math.max(target - others, target * 0.2)
	local volume = massPart.Size.X * massPart.Size.Y * massPart.Size.Z
	local density = math.clamp(own / volume, 0.01, 100)
	massPart.CustomPhysicalProperties = PhysicalProperties.new(density, 0.3, 0.5, 1, 1)
	own = massPart:GetMass()

	local total = own + others
	local cgZ = wb / 2 - stats.weightFront * wb
	local cgY = -rAvg + stats.cgHeightMeters / Spec.STUD
	local cg = Vector3.new(0, cgY, cgZ)
	local localPos = (cg * total - moment) / own

	local w = massPart:FindFirstChildOfClass("WeldConstraint")
	if w then
		w.Enabled = false
	end
	massPart.CFrame = frame * CFrame.new(localPos)
	if w then
		w.Enabled = true
	end
end

function Chassis.applyTuning(car, stats)
	local susp = stats.suspension
	local rideHeight = stats.chassis.rideHeight or 0

	local suspension = car:FindFirstChild("Suspension")
	if suspension then
		for _, inst in ipairs(suspension:GetDescendants()) do
			if inst:IsA("SpringConstraint") and inst.Name == "Spring" then
				local axle = inst:GetAttribute("Front") and susp.front or susp.rear
				local design = inst:GetAttribute("DesignLength")
				local cos = axle.strutCos
				local preload = axle.staticForce / axle.spring
				inst.Stiffness = axle.spring
				inst.Damping = axle.damper
				inst.FreeLength = design + rideHeight * cos + preload
				inst.MinLength = math.max(design + (rideHeight - axle.bump) * cos, 0.05)
				inst.MaxLength = design + (rideHeight + axle.droop) * cos
			end
		end
	end

	local wheels = car:FindFirstChild("Wheels")
	if wheels then
		for _, model in ipairs(wheels:GetChildren()) do
			local axle = model:GetAttribute("Front") and susp.front or susp.rear
			local r = model:GetAttribute("Radius")
			if r then
				local start = 0.674 * r
				model:SetAttribute("RayStart", start)
				model:SetAttribute("RayLength", r + axle.tireDeflection - start)
				model:SetAttribute("TireRate", axle.tireRate)
				model:SetAttribute("TireDamper", axle.tireDamper)
			end
			local bounds = model:FindFirstChild("Bounds")
			local hub = suspension and suspension:FindFirstChild(model.Name .. "Hub")
			local tie = hub and hub:FindFirstChild("FlexibleSteerStrut")
			if tie and bounds then
				local scale = bounds:GetMass() / 747
				tie.Stiffness = 1.457e6 * scale
				tie.Damping = 42336 * scale
			end
		end
	end

	-- moving the mass re-welds the body; only do it when something it depends on changed
	local massKey = ("%.3f|%.4f|%.4f|%s"):format(stats.massKg, stats.weightFront, stats.cgHeightMeters, tostring(stats.chassis.driverSide))
	if car:GetAttribute("MassKey") ~= massKey then
		car:SetAttribute("MassKey", massKey)
		placeMasses(car, stats)
	end

	local colliders = car:FindFirstChild("Colliders")
	if colliders then
		for _, part in ipairs(colliders:GetChildren()) do
			if part:IsA("BasePart") then
				part.CanCollide = stats.chassis.bodyCollision ~= false
			end
		end
	end
end

return Chassis
