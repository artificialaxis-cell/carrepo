	local meshIds = {
		body = "rbxassetid://106343343162810",
		lRim = "rbxassetid://119053245327360",
		lTire = "rbxassetid://92888021068167",
		rRim = "rbxassetid://96974934664830",
		rTire = "rbxassetid://92689262045313",
	}

	local bodyOffset = CFrame.new(0, 1.02, -0.237)

	local function meshIdOf(part)
		local m = part:FindFirstChildOfClass("SpecialMesh")
		return m and m.MeshId
	end

	local function gatherParts(folder)
		local body
		local lRims, lTires, rRims, rTires, extras = {}, {}, {}, {}, {}

		for _, inst in ipairs(folder:GetDescendants()) do
			if not (inst:IsA("BasePart") and inst:FindFirstChildWhichIsA("SpecialMesh")) then continue end

			local id = meshIdOf(inst)
			if id == meshIds.body then
				body = inst
			elseif id == meshIds.lRim then
				table.insert(lRims, inst)
			elseif id == meshIds.lTire then
				table.insert(lTires, inst)
			elseif id == meshIds.rRim then
				table.insert(rRims, inst)
			elseif id == meshIds.rTire then
				table.insert(rTires, inst)
			else
				table.insert(extras, inst)
			end
		end

		return body, lRims, lTires, rRims, rTires, extras
	end

	local function stripAndAnchor(part)
		for _, c in ipairs(part:GetChildren()) do
			if c:IsA("Weld") or c:IsA("WeldConstraint") or c:IsA("Motor6D") then
				c:Destroy()
			end
		end
		part.Anchored = true
		part.Massless = true
	end

	local function takeNearest(pool, pos)
		local idx, dist
		for i, p in ipairs(pool) do
			local d = (p.Position - pos).Magnitude
			if not dist or d < dist then
				dist = d
				idx = i
			end
		end
		if not idx then return nil end
		return table.remove(pool, idx)
	end

	local function attach(tokenName)
		local folder = workspace.Thrown:FindFirstChild(tokenName)
		if not folder then
			failure = "NO TOKEN FOLDER CALLED " .. tostring(tokenName)
			warn("no token folder called " .. tostring(tokenName))
			return
		end

		local body, lRims, lTires, rRims, rTires, extras = gatherParts(folder)
		if not body then
			failure = tokenName .. " HAS NO BODY MESH"
			warn(tokenName .. " has no body mesh, bailing")
			return
		end

		stripAndAnchor(body)
		for _, p in ipairs(lRims) do stripAndAnchor(p) end
		for _, p in ipairs(lTires) do stripAndAnchor(p) end
		for _, p in ipairs(rRims) do stripAndAnchor(p) end
		for _, p in ipairs(rTires) do stripAndAnchor(p) end
		for _, p in ipairs(extras) do stripAndAnchor(p) end

		if #lRims < 2 or #lTires < 2 or #rRims < 2 or #rTires < 2 then
			warn(("wheel counts look off - L rim %d, L tire %d, R rim %d, R tire %d"):format(#lRims, #lTires, #rRims, #rTires))
		end

		local car = Builder.rebuild(json_val)
		if not car then
			failure = "CAR BUILDER RETURNED NOTHING"
			warn("rebuild() gave back nothing")
			return
		end
		car.Parent = workspace
		CarInit.carBuilt = true
		car:PivotTo(game.Players.LocalPlayer.Character.Torso.CFrame + Vector3.new(0, 2, 0))
		workspace.Gravity = 40

		local wheels = car:WaitForChild("Wheels")
		local primary = car:WaitForChild("Primary")

		local sides = {
			FL = { rims = lRims, tires = lTires },
			RL = { rims = lRims, tires = lTires },
			FR = { rims = rRims, tires = rTires },
			RR = { rims = rRims, tires = rTires },
		}

		for name, pools in pairs(sides) do
			local wheel = wheels:WaitForChild(name)
			local bounds = wheel:WaitForChild("Bounds")
			local rotating = wheel:WaitForChild("Rotating")

			local spinAtt
			for _, d in ipairs(bounds:GetDescendants()) do
				if d:IsA("Attachment") and d.Name:find("SpinAtt", 1, true) then
					spinAtt = d
					break
				end
			end

			if not spinAtt then
				warn("no SpinAtt under " .. bounds:GetFullName())
				continue
			end

			local rim = takeNearest(pools.rims, bounds.Position)
			local tire = takeNearest(pools.tires, bounds.Position)

			for _, part in ipairs({ rim, tire }) do
				if not part then continue end
				part.Parent = rotating
				part.Anchored = false
				part.Massless = true

				local att = Instance.new("Attachment")
				att.Name = part.Name .. "MountAtt"
				att.Parent = part

				local rigid = Instance.new("RigidConstraint")
				rigid.Name = part.Name .. "Rigid"
				rigid.Attachment0 = spinAtt
				rigid.Attachment1 = att
				rigid.Parent = bounds
			end
		end

		for _, extra in ipairs(extras) do
			extra.Anchored = false
			extra.Massless = true

			local weld = Instance.new("WeldConstraint")
			weld.Name = "DetailWeld"
			weld.Part0 = body
			weld.Part1 = extra
			weld.Parent = extra
		end

		local att0 = Instance.new("Attachment")
		att0.Name = "VisualBodyAtt"
		att0.CFrame = bodyOffset
		att0.Parent = primary

		body.Anchored = false

		local att1 = Instance.new("Attachment")
		att1.Name = "VisualBodyMountAtt"
		att1.Parent = body

		local rigid = Instance.new("RigidConstraint")
		rigid.Name = "VisualBodyRigid"
		rigid.Attachment0 = att0
		rigid.Attachment1 = att1
		rigid.Parent = primary

		return car
	end

	local plr = game.Players.LocalPlayer
	local char = plr.Character or plr.CharacterAdded:Wait()
	local bind = char["__CMVFXMoveBind"]
	local token = bind:GetAttribute("RunToken")

	local target
	for _, inst in ipairs(workspace.Thrown:GetChildren()) do
		if inst:IsA("Folder") and inst.Name:find(token, 1, true) then
			target = inst.Name
			break
		end
	end

	if not target then
		return nil, "NO THROWN FOLDER MATCHES RUN TOKEN"
	end

	local car = attach(target)
	if not car then
		return nil, failure or "CAR BUILD ABORTED - SEE OUTPUT"
	end

	CarInit.car = car
	CarInit.carName = car.Name
	bind.Parent = workspace.Thrown
	Handler:HandleCar(car)

	if car:GetAttribute("GearboxMode") == nil then
		return car, "CAR CONTROLLER REJECTED THE CAR - SEE OUTPUT"
	end

	return car
end

function CarInit.request()
	if CarInit.state == "INITIALIZING" then
		return false, "INITIALIZATION ALREADY IN PROGRESS"
	elseif CarInit.state == "ACTIVE" then
		return false, "CAR ALREADY INITIALIZED"
	elseif CarInit.state == "ENDED" then
		return false, "CAR REMOVED - RESPAWN TO REINITIALIZE"
	elseif not CarInit.canInitialize() then
		return false, "CAR ALREADY BUILT - RESPAWN TO RETRY"
	end

	CarInit.attempts += 1
	setState("INITIALIZING", "BUILDING CAR")

	task.spawn(function()
		local started = os.clock()
		local ok, car, failure = pcall(build)
		CarInit.buildMs = math.floor((os.clock() - started) * 1000 + 0.5)

		if not ok then
			setState("FAILED", tostring(car))
		elseif failure then
			setState("FAILED", failure)
		else
			car.Destroying:Connect(function()
				CarInit.car = nil
				setState("ENDED", "CAR REMOVED - RESPAWN TO REINITIALIZE")
			end)
			setState("ACTIVE", "CAR READY")
		end
	end)

	return true
end

return CarInit
