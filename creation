CarInit.car = nil
CarInit.carName = nil
CarInit.carBuilt = false
CarInit.attempts = 0
CarInit.buildMs = nil
CarInit.loader = RunService:IsStudio() and "STUDIO MODULES" or "REMOTE SOURCE"
CarInit.log = {}
CarInit.changed = Instance.new("BindableEvent")

local origin = os.clock()

local function setState(state, message)
	CarInit.state = state
	CarInit.message = message
	table.insert(CarInit.log, string.format("%7.2f  %s  %s", os.clock() - origin, state, message))
	if #CarInit.log > 24 then
		table.remove(CarInit.log, 1)
	end
	CarInit.changed:Fire(state)
end

function CarInit.canInitialize()
	return CarInit.state == "IDLE" or (CarInit.state == "FAILED" and not CarInit.carBuilt)
end

