------------------------------------------------------------------------------------------
-- Line graph built from rotated frames
------------------------------------------------------------------------------------------

local function graph(parent, height, order)
	local frame = new("Frame", {
		Parent = parent,
		Size = UDim2.new(1, 0, 0, height),
		LayoutOrder = order or 0,
		ClipsDescendants = true,
	})
	local plot = new("Frame", { Parent = frame, Size = UDim2.new(1, -40, 1, -20), Position = UDim2.fromOffset(32, 4) })
	local grid = {}
	for i = 0, 3 do
		grid[i] = new("Frame", {
			Parent = plot,
			BackgroundColor3 = C.lineSoft,
			BackgroundTransparency = 0,
			Size = UDim2.new(1, 0, 0, 1),
			Position = UDim2.new(0, 0, i / 3, 0),
		})
	end
	local segs = {}
	local labels = {}
	local api = {}

	local function label(key, value, pos, opts)
		local l = labels[key]
		if not l then
			l = text(frame, "", { size = 11, mono = true, color = C.mute, height = 14 })
			labels[key] = l
		end
		l.Text = value
		l.Position = pos
		l.Size = UDim2.fromOffset(opts and opts.w or 40, 14)
		l.TextXAlignment = opts and opts.align or Enum.TextXAlignment.Left
		l.TextColor3 = opts and opts.color or C.mute
	end

	-- series = { {points = {{x,y}...}, color, width} }, ranges in data units
	function api.draw(series, xr, yr, axis)
		local w, h = plot.AbsoluteSize.X, plot.AbsoluteSize.Y
		if w < 2 or h < 2 then
			task.defer(function()
				if plot.AbsoluteSize.X >= 2 then
					api.draw(series, xr, yr, axis)
				end
			end)
			return
		end
		local used = 0
		for _, s in ipairs(series) do
			local pts = s.points
			for i = 1, #pts - 1 do
				used += 1
				local seg = segs[used]
				if not seg then
					seg = new("Frame", { Parent = plot, BackgroundTransparency = 0, AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 2 })
					segs[used] = seg
				end
				local x1 = (pts[i][1] - xr[1]) / (xr[2] - xr[1]) * w
				local y1 = h - (pts[i][2] - yr[1]) / (yr[2] - yr[1]) * h
				local x2 = (pts[i + 1][1] - xr[1]) / (xr[2] - xr[1]) * w
				local y2 = h - (pts[i + 1][2] - yr[1]) / (yr[2] - yr[1]) * h
				local dx, dy = x2 - x1, y2 - y1
				local len = math.sqrt(dx * dx + dy * dy)
				seg.Visible = true
				seg.BackgroundColor3 = s.color
				seg.BackgroundTransparency = s.transparency or 0
				seg.Size = UDim2.fromOffset(len + 1, s.width or 2)
				seg.Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2)
				seg.Rotation = math.deg(math.atan2(dy, dx))
			end
		end
		for i = used + 1, #segs do
			segs[i].Visible = false
		end
		if axis then
			for i = 0, 3 do
				local v = yr[2] - (yr[2] - yr[1]) * i / 3
				label("y" .. i, axis.y and axis.y(v) or string.format("%d", v), UDim2.new(0, 0, 0, 4 + h * i / 3 - 7), { w = 28, align = Enum.TextXAlignment.Right })
			end
			for i = 0, 2 do
				local v = xr[1] + (xr[2] - xr[1]) * i / 2
				local x = 32 + w * i / 2
				label("x" .. i, axis.x and axis.x(v) or string.format("%d", v), UDim2.new(0, x - (i == 2 and 40 or i == 1 and 20 or 0), 1, -14), {
					w = 40,
					align = i == 2 and Enum.TextXAlignment.Right or i == 1 and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left,
				})
			end
		end
	end
	api.instance = frame
	return api
end

