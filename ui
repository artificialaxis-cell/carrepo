local function text(parent, value, opts)
	opts = opts or {}
	local lbl = new("TextLabel", {
		Parent = parent,
		Text = value or "",
		FontFace = opts.mono and mono(opts.weight) or font(opts.weight),
		TextSize = opts.size or 14,
		TextColor3 = opts.color or C.text,
		TextXAlignment = opts.align or Enum.TextXAlignment.Left,
		TextYAlignment = opts.valign or Enum.TextYAlignment.Center,
		TextWrapped = opts.wrap or false,
		TextTruncate = opts.wrap and Enum.TextTruncate.None or Enum.TextTruncate.AtEnd,
		RichText = opts.rich or false,
		Size = opts.sizeUDim or UDim2.new(1, 0, 0, opts.height or 18),
		Position = opts.position,
		AutomaticSize = opts.auto,
		LayoutOrder = opts.order or 0,
		ZIndex = opts.z or 1,
		AnchorPoint = opts.anchor,
		Visible = opts.visible ~= false,
	})
	return lbl
end

local function round(value, step)
	if not step or step <= 0 then
		return value
	end
	return math.floor(value / step + 0.5) * step
end

local function decimalsFor(step)
	if not step or step >= 1 then
		return 0
	elseif step >= 0.1 then
		return 1
	elseif step >= 0.01 then
		return 2
	elseif step >= 0.001 then
		return 3
	end
	return 4
end

local function formatNumber(value, param)
	if type(value) ~= "number" then
		return tostring(value)
	end
	if param and param.display == "percent" then
		local d = param.step and param.step < 0.01 and 1 or 0
		return string.format("%." .. d .. "f", value * 100)
	end
	return string.format("%." .. decimalsFor(param and param.step) .. "f", value)
end

local function parseNumber(textValue, param)
	local n = tonumber((textValue or ""):gsub("[%%%s,]", ""))
	if not n then
		return nil
	end
	if param and param.display == "percent" then
		return n / 100
	end
	return n
end

local function shortId(id)
	return (id or ""):match("(%d+)$") or id or "?"
end

local function bind(signal, fn)
	local c = signal:Connect(fn)
	table.insert(UI._links, c)
	return c
end

