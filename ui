	local tierPick = segmented(header, { "basic", "advanced" }, { "Basic", "Advanced" }, ui.tier, nil, { size = UDim2.new(0.45, -6, 0, 30), position = UDim2.new(0.55, 6, 0, 18) })
	local search = input(header, { placeholder = "Search parameters", size = UDim2.new(1, 0, 0, 30), position = UDim2.fromOffset(0, 56) })
	search.Parent = header
	local resultNote = text(header, "", { size = 11, color = C.mute, position = UDim2.fromOffset(0, 90), height = 14 })

	-- section chips
	local chipBar = new("ScrollingFrame", {
		Parent = page,
		Size = UDim2.new(1, 0, 0, 34),
		Position = UDim2.fromOffset(0, 112),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		ScrollingDirection = Enum.ScrollingDirection.X,
		ScrollBarThickness = 0,
		BackgroundTransparency = 1,
	}, { padding(2, PAD, 4, PAD), hlist(6) })
	local sectionList = { { id = "overview", label = "Overview" } }
	for _, s in ipairs(Spec.sections) do
		table.insert(sectionList, s)
	end
	table.insert(sectionList, { id = "expert", label = "Expert" })
	local chips = {}

	local bodyHolder = new("Frame", { Parent = page, Size = UDim2.new(1, 0, 1, -146 - 58), Position = UDim2.fromOffset(0, 146), ClipsDescendants = true })
	new("Frame", { Parent = page, BackgroundColor3 = C.lineSoft, BackgroundTransparency = 0, Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 0, 146) })

	-- footer: configs
	local footer = new("Frame", { Parent = page, BackgroundColor3 = C.panel, BackgroundTransparency = 0, Size = UDim2.new(1, 0, 0, 58), Position = UDim2.new(0, 0, 1, -58) }, { padding(12, PAD, 14, PAD) })
	new("Frame", { Parent = footer, BackgroundColor3 = C.lineSoft, BackgroundTransparency = 0, Size = UDim2.new(1, 2 * PAD, 0, 1), Position = UDim2.new(0, -PAD, 0, -12) })
	local footerRow = new("Frame", { Parent = footer, Size = UDim2.fromScale(1, 1) }, { hlist(6) })
	local configName = input(footerRow, { placeholder = "Config name", size = UDim2.new(1, -244, 1, 0), order = 1 })
	local saveBtn = button(footerRow, "Save", { size = UDim2.fromOffset(52, 32), order = 2, textSize = 13 })
	local loadBtn = button(footerRow, "Load", { size = UDim2.fromOffset(52, 32), order = 3, textSize = 13 })
	local shareBtn = button(footerRow, "Share", { size = UDim2.fromOffset(58, 32), order = 4, textSize = 13 })
	local resetBtn = button(footerRow, "Reset", { style = "danger", size = UDim2.fromOffset(58, 32), order = 5, textSize = 13 })

	local body -- current scrolling frame
	local rowRefs = {} -- id -> refresh fn
	local derivedRefs = {} -- refresh fns that depend on everything
	local currentSection = ui.section

	local function sectionModified(id)
		if id == "overview" then
			return Tuning.modifiedCount() > 0
		elseif id == "expert" then
			local n = 0
			for _ in pairs(Tuning.state.raw) do
				n += 1
			end
			return n > 0
		end
		return Tuning.modifiedCount(id) > 0
	end

	local function paintChips(animate)
		for id, chip in pairs(chips) do
			local on = id == currentSection
			local t = animate and 0.16 or 0
			tween(chip.button, { BackgroundColor3 = on and C.text or C.raised, TextColor3 = on and C.panel or C.dim }, t)
			chip.dot.Visible = sectionModified(id)
			chip.dot.BackgroundColor3 = on and C.accent or C.accent
		end
	end

	-- row builders -------------------------------------------------------------------

	local function paramValueChanged(param)
		local fn = rowRefs[param.id]
		if fn then
			fn()
		end
	end

	local function numberRow(parent, param, order)
		local slider = sliderRow(parent, {
			label = param.label,
			unit = param.display == "percent" and "%" or param.unit,
			min = param.min,
			max = param.max,
			step = param.step,
			value = Tuning.get(param.id),
			order = order,
			hint = param.hint,
			param = param,
			onChange = function(v)
				Tuning.set(param.id, v)
			end,
			onReset = function()
				Tuning.reset(param.id)
			end,
		})
		rowRefs[param.id] = function()
			slider.set(Tuning.get(param.id), Tuning.isModified(param.id), Tuning.isAuto(param.id))
		end
		rowRefs[param.id]()
	end

	local function simpleRow(parent, param, order, height)
		local row = new("Frame", { Parent = parent, Size = UDim2.new(1, 0, 0, height or 34), LayoutOrder = order })
		local marker = new("Frame", { Parent = row, BackgroundColor3 = C.accent, BackgroundTransparency = 0, Size = UDim2.fromOffset(2, 14), Position = UDim2.fromOffset(-8, 9), Visible = false }, { corner(1) })
		local lbl = text(row, param.label, { size = 13, weight = W.medium, color = C.dim, sizeUDim = UDim2.new(0.42, 0, 0, 32) })
		attachTooltip(lbl, param.hint)
		local reset = iconButton(row, "Reset", { size = UDim2.fromOffset(42, 24), position = UDim2.new(1, -42, 0, 4), textSize = 11, visible = false })
		bind(reset.Activated, function()
			Tuning.reset(param.id)
		end)
		return row, function(modified)
			marker.Visible = modified
			reset.Visible = modified
			lbl.TextColor3 = modified and C.text or C.dim
		end
	end

	local function boolRow(parent, param, order)
		local row, mark = simpleRow(parent, param, order)
		local sw = toggle(row, Tuning.get(param.id) == true, function(v)
			Tuning.set(param.id, v)
		end, { anchor = Vector2.new(1, 0.5), position = UDim2.new(1, -50, 0, 16) })
		rowRefs[param.id] = function()
			sw.set(Tuning.get(param.id) == true)
			mark(Tuning.isModified(param.id))
		end
		rowRefs[param.id]()
	end

	local function enumRow(parent, param, order)
		local row, mark = simpleRow(parent, param, order)
		local control
		if #param.options <= 3 then
			control = segmented(row, param.options, param.labels, Tuning.get(param.id), function(v)
				Tuning.set(param.id, v)
			end, { size = UDim2.new(0.58, -50, 0, 28), position = UDim2.new(0.42, 0, 0, 3), textSize = 12 })
		else
			control = dropdown(row, function()
				local out = {}
				for i, o in ipairs(param.options) do
					table.insert(out, { value = o, label = param.labels and param.labels[i] or o })
				end
				return out
			end, Tuning.get(param.id), function(v)
				Tuning.set(param.id, v)
			end, { size = UDim2.new(0.58, -50, 0, 28), position = UDim2.new(0.42, 0, 0, 3) })
		end
		rowRefs[param.id] = function()
			control.set(Tuning.get(param.id))
			mark(Tuning.isModified(param.id))
		end
		rowRefs[param.id]()
	end

	local function packRow(parent, param, order)
		local row, mark = simpleRow(parent, param, order)
		local function options()
			local out = { { value = "auto", label = "Automatic", sub = "best match" } }
			for _, pack in ipairs(Tuning.packs()) do
				table.insert(out, { value = pack.key, label = pack.label, sub = #pack.layers .. " loops" })
			end
			return out
		end
		local control = dropdown(row, options, Tuning.get(param.id), function(v)
			Tuning.set(param.id, v)
		end, { size = UDim2.new(0.58, -50, 0, 28), position = UDim2.new(0.42, 0, 0, 3), popupWidth = 300, empty = "No engine loops in CarSounds" })
		rowRefs[param.id] = function()
			control.set(Tuning.get(param.id))
			mark(Tuning.isModified(param.id))
		end
		rowRefs[param.id]()
	end

	local function soundRow(parent, param, order)
		local row, mark = simpleRow(parent, param, order)
		local box = input(row, { size = UDim2.new(0.58, -50, 0, 28), position = UDim2.new(0.42, 0, 0, 3), placeholder = "Name or asset id", textSize = 12 })
		local function show()
			local v = Tuning.get(param.id)
			box.Text = (v == "rbxassetid://0" or v == nil) and "" or tostring(v)
		end
		local suggestionToken = 0
		bind(box.Focused, function()
			suggestionToken += 1
		end)
		bind(box:GetPropertyChangedSignal("Text"), function()
			if not box:IsFocused() then
				return
			end
			suggestionToken += 1
			local mine = suggestionToken
			task.delay(0.15, function()
				if mine ~= suggestionToken or not box:IsFocused() then
					return
				end
				local found = Tuning.searchSounds(box.Text, 8)
				if #found == 0 then
					if closePopup then
						closePopup()
					end
					return
				end
				openPopup(box, function(list)
					for i, name in ipairs(found) do
						menuItem(list, name, false, function()
							Tuning.set(param.id, name)
							show()
						end, function()
							if closePopup then
								closePopup()
							end
						end, i)
					end
					return #found
				end)
			end)
		end)
		bind(box.FocusLost, function(enter)
			task.delay(0.15, function()
				if box:IsFocused() then
					return
				end
				if box.Text ~= "" and not Tuning.set(param.id, box.Text) then
					UI.notify("warn", "Unknown sound: " .. box.Text)
				elseif box.Text == "" then
					Tuning.set(param.id, "rbxassetid://0")
				end
				show()
			end)
		end)
		rowRefs[param.id] = function()
			if not box:IsFocused() then
				show()
			end
			mark(Tuning.isModified(param.id))
		end
		rowRefs[param.id]()
	end

	local function gearsRow(parent, param, order)
		local holder = new("Frame", { Parent = parent, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order }, { vlist(6) })
		local headRow, mark = simpleRow(holder, param, 1, 30)
		local list = new("Frame", { Parent = holder, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2 }, { vlist(4) })
		local gen = new("Frame", { Parent = holder, BackgroundColor3 = C.raised, BackgroundTransparency = 0, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3 }, { corner(6), padding(10), vlist(8) })
		text(gen, "GENERATE A SET", { size = 11, weight = W.bold, color = C.mute, height = 14, order = 0 })
		local genRow = new("Frame", { Parent = gen, Size = UDim2.new(1, 0, 0, 44), LayoutOrder = 1 }, { hlist(6, Enum.VerticalAlignment.Top) })
		local function genField(label, value, i)
			local f = new("Frame", { Parent = genRow, Size = UDim2.new(0.25, -5, 1, 0), LayoutOrder = i })
			text(f, label, { size = 11, color = C.mute, height = 14 })
			local b = input(f, { text = value, mono = true, size = UDim2.new(1, 0, 0, 26), position = UDim2.fromOffset(0, 16), textSize = 12, align = Enum.TextXAlignment.Center })
			return b
		end
		local gears = Tuning.get(param.id)
		local gCount = genField("Gears", tostring(#gears), 1)
		local gFirst = genField("1st", string.format("%.2f", gears[1]), 2)
		local gTop = genField("Top", string.format("%.2f", gears[#gears]), 3)
		local gSpread = genField("Spacing", "0.8", 4)
		attachTooltip(gSpread, "0 = even steps, higher = tighter top gears")
		local genBtn = button(gen, "Generate", { size = UDim2.new(1, 0, 0, 30), order = 2, textSize = 13 })
		bind(genBtn.instance.Activated, function()
			local n, first, topR, spread = tonumber(gCount.Text), tonumber(gFirst.Text), tonumber(gTop.Text), tonumber(gSpread.Text)
			if not (n and first and topR and spread) or first <= topR then
				UI.notify("warn", "1st must be a larger ratio than top")
				return
			end
			Tuning.set(param.id, Spec.generateGears(n, first, topR, spread))
		end)

		local function render()
			for _, child in ipairs(list:GetChildren()) do
				if child:IsA("GuiObject") then
					child:Destroy()
				end
			end
			local values = Tuning.get(param.id)
			local readouts = Tuning.readouts()
			local speeds = readouts and readouts.gearSpeeds or {}
			local top = 1
			for _, s in ipairs(speeds) do
				top = math.max(top, s)
			end
			for i, ratio in ipairs(values) do
				local r = new("Frame", { Parent = list, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = i })
				text(r, "Gear " .. i, { size = 13, color = C.dim, sizeUDim = UDim2.new(0, 56, 1, 0) })
				local b = input(r, { text = string.format("%.2f", ratio), mono = true, align = Enum.TextXAlignment.Center, size = UDim2.fromOffset(64, 26), position = UDim2.fromOffset(60, 1), textSize = 12 })
				local barBg = new("Frame", { Parent = r, BackgroundColor3 = C.raised, BackgroundTransparency = 0, Size = UDim2.new(1, -218, 0, 6), Position = UDim2.new(0, 134, 0.5, -3) }, { corner(3) })
				local bar = new("Frame", { Parent = barBg, BackgroundColor3 = C.accent, BackgroundTransparency = 0.15, Size = UDim2.new(0, 0, 1, 0) }, { corner(3) })
				tween(bar, { Size = UDim2.new((speeds[i] or 0) / top, 0, 1, 0) }, 0.3)
				text(r, speeds[i] and string.format("%d km/h", speeds[i]) or "", { size = 12, mono = true, color = C.mute, align = Enum.TextXAlignment.Right, position = UDim2.new(1, -78, 0, 0), sizeUDim = UDim2.new(0, 50, 1, 0) })
				local del = iconButton(r, "×", { size = UDim2.fromOffset(24, 24), position = UDim2.new(1, -24, 0, 2), visible = #values > 1 })
				bind(del.Activated, function()
					local copy = table.clone(values)
					table.remove(copy, i)
					Tuning.set(param.id, copy)
				end)
				bind(b.FocusLost, function()
					local v = tonumber(b.Text)
					if v and v > 0 then
						local copy = table.clone(values)
						copy[i] = v
						Tuning.set(param.id, copy)
					else
						b.Text = string.format("%.2f", ratio)
					end
				end)
			end
			if #values < 10 then
				local add = button(list, "Add gear", { style = "ghost", size = UDim2.new(1, 0, 0, 26), order = 99, textSize = 12 })
				bind(add.instance.Activated, function()
					local copy = table.clone(values)
					table.insert(copy, math.floor(copy[#copy] * 0.82 * 100 + 0.5) / 100)
					Tuning.set(param.id, copy)
				end)
			end
			mark(Tuning.isModified(param.id))
		end
		rowRefs[param.id] = render
		table.insert(derivedRefs, render)
		render()
	end

	local function curveRow(parent, param, order)
		local holder = new("Frame", { Parent = parent, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order }, { vlist(6) })
		local _, mark = simpleRow(holder, param, 1, 30)
		local list = new("Frame", { Parent = holder, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2 }, { vlist(4) })
		local function render()
			for _, child in ipairs(list:GetChildren()) do
				if child:IsA("GuiObject") then
					child:Destroy()
				end
			end
			local custom = Tuning.get(param.id)
			if Tuning.get("engine.curveMode") ~= "Custom" or type(custom) ~= "table" then
				text(list, "Switch Curve to Custom to edit points. The shaped curve is copied as a starting point.", { size = 12, color = C.mute, wrap = true, auto = Enum.AutomaticSize.Y, height = 0, order = 1 })
				mark(Tuning.isModified(param.id))
				return
			end
			for i, p in ipairs(custom) do
				local r = new("Frame", { Parent = list, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = i })
				local rpmBox = input(r, { text = tostring(math.floor(p.rpm)), mono = true, align = Enum.TextXAlignment.Center, size = UDim2.new(0.5, -34, 0, 26), textSize = 12 })
				local tqBox = input(r, { text = string.format("%.0f", p.torque), mono = true, align = Enum.TextXAlignment.Center, size = UDim2.new(0.5, -34, 0, 26), position = UDim2.new(0.5, -28, 0, 0), textSize = 12 })
				text(r, "Nm", { size = 11, color = C.mute, position = UDim2.new(1, -56, 0, 0), sizeUDim = UDim2.new(0, 24, 1, 0) })
				local del = iconButton(r, "×", { size = UDim2.fromOffset(24, 24), position = UDim2.new(1, -24, 0, 1), visible = #custom > 2 })
				local function commit()
					local copy = {}
					for j, q in ipairs(custom) do
						copy[j] = { rpm = q.rpm, torque = q.torque }
					end
					copy[i] = { rpm = tonumber(rpmBox.Text) or p.rpm, torque = tonumber(tqBox.Text) or p.torque }
					if not Tuning.set(param.id, copy) then
						UI.notify("warn", "Each rpm can only appear once")
						render()
					end
				end
				bind(rpmBox.FocusLost, commit)
				bind(tqBox.FocusLost, commit)
				bind(del.Activated, function()
					local copy = {}
					for j, q in ipairs(custom) do
						if j ~= i then
							table.insert(copy, { rpm = q.rpm, torque = q.torque })
						end
					end
					Tuning.set(param.id, copy)
				end)
			end
			local add = button(list, "Add point", { style = "ghost", size = UDim2.new(1, 0, 0, 26), order = 999, textSize = 12 })
			bind(add.instance.Activated, function()
				local copy = {}
				for j, q in ipairs(custom) do
					copy[j] = { rpm = q.rpm, torque = q.torque }
				end
				local last = copy[#copy]
				table.insert(copy, { rpm = last.rpm + 500, torque = last.torque * 0.9 })
				Tuning.set(param.id, copy)
			end)
			mark(Tuning.isModified(param.id))
		end
		rowRefs[param.id] = render
		rowRefs["engine.curveMode#curve"] = render
		render()
	end

	-- graphs ---------------------------------------------------------------------------

	local function torqueGraph(parent, order)
		local wrap = card(parent, { order = order })
		vlist(6).Parent = wrap
		local legend = new("Frame", { Parent = wrap, Size = UDim2.new(1, 0, 0, 18), LayoutOrder = 1 })
		local tLabel = text(legend, "", { size = 12, weight = W.semibold, color = C.accent, sizeUDim = UDim2.new(0.5, 0, 1, 0) })
		local pLabel = text(legend, "", { size = 12, weight = W.semibold, color = C.text, align = Enum.TextXAlignment.Right, position = UDim2.new(0.5, 0, 0, 0), sizeUDim = UDim2.new(0.5, 0, 1, 0) })
		local g = graph(wrap, 150, 2)
		local function render()
			local r = Tuning.readouts()
			if not r then
				return
			end
			local idle, red = Tuning.get("engine.idle"), Tuning.get("engine.redline")
			local tq, pw = {}, {}
			local maxT, maxP = 1, 1
			for i = 0, 48 do
				local rpm = idle + (red - idle) * i / 48
				local t = Spec.torqueAt(r.points, rpm)
				local p = t * rpm / 9549 * 1.341
				tq[#tq + 1] = { rpm, t }
				pw[#pw + 1] = { rpm, p }
				maxT, maxP = math.max(maxT, t), math.max(maxP, p)
			end
			local top = math.max(maxT, maxP) * 1.12
			g.draw({
				{ points = pw, color = C.text, width = 2, transparency = 0.15 },
				{ points = tq, color = C.accent, width = 2 },
			}, { idle, red }, { 0, top }, {
				x = function(v)
					return string.format("%.1fk", v / 1000)
				end,
				y = function(v)
					return string.format("%d", v)
				end,
			})
			tLabel.Text = string.format("%d Nm @ %d", r.peakTorque, r.peakTorqueRpm)
			pLabel.Text = string.format("%d hp @ %d", r.peakPowerHp, r.peakPowerRpm)
		end
		table.insert(derivedRefs, render)
		render()
	end

	local function overview(parent)
		local specs = card(parent, { order = 1 })
		vlist(10).Parent = specs
		sectionLabel(specs, "At a glance", 0)
		local grid = new("Frame", { Parent = specs, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1 }, {
			new("UIGridLayout", { CellSize = UDim2.new(1 / 3, -8, 0, 52), CellPadding = UDim2.fromOffset(12, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
		})
		local cells = {}
		local function stat(key, label, i)
			local f = new("Frame", { Parent = grid, LayoutOrder = i })
			text(f, label, { size = 11, weight = W.bold, color = C.mute, height = 14 })
			cells[key] = text(f, "-", { size = 20, weight = W.bold, mono = true, position = UDim2.fromOffset(0, 16), height = 24 })
			cells[key .. "Sub"] = text(f, "", { size = 11, color = C.mute, position = UDim2.fromOffset(0, 38), height = 14 })
		end
		stat("power", "POWER", 1)
		stat("torque", "TORQUE", 2)
		stat("mass", "MASS", 3)
		stat("ptw", "HP / TONNE", 4)
		stat("top", "TOP SPEED", 5)
		stat("drive", "DRIVE", 6)
		local function render()
			local r, stats = Tuning.readouts()
			if not r then
				return
			end
			cells.power.Text = string.format("%d", r.peakPowerHp)
			cells.powerSub.Text = string.format("hp @ %d rpm", r.peakPowerRpm)
			cells.torque.Text = string.format("%d", r.peakTorque)
			cells.torqueSub.Text = string.format("Nm @ %d rpm", r.peakTorqueRpm)
			cells.mass.Text = string.format("%d", r.mass)
			cells.massSub.Text = string.format("kg · %d%% front", Tuning.get("chassis.weightFront") * 100)
			cells.ptw.Text = string.format("%d", r.powerToWeight)
			cells.ptwSub.Text = "hp per tonne"
			cells.top.Text = string.format("%d", r.topSpeedKmh)
			cells.topSub.Text = "km/h, drag limited"
			cells.drive.Text = stats.transmission.type
			local diffs = { OPEN = "Open", LIMITED = "LSD", TORSEN = "Torsen", CLUTCH_LSD = "Clutch LSD", LOCKED = "Locked", WELDED = "Welded" }
			cells.driveSub.Text = (diffs[stats.transmission.differential.type] or "") .. " · " .. #Tuning.get("gearbox.gears") .. "-speed"
		end
		table.insert(derivedRefs, render)
		render()

		torqueGraph(parent, 2)

		local chassisCard = card(parent, { order = 3 })
		vlist(4).Parent = chassisCard
		sectionLabel(chassisCard, "Derived chassis values", 0)
		local springs = keyValue(chassisCard, "Spring rate F / R", 1)
		local corners = keyValue(chassisCard, "Corner mass F / R", 2)
		local brakes = keyValue(chassisCard, "Brake torque F / R", 3)
		local inertia = keyValue(chassisCard, "Wheel inertia", 4)
		local clutch = keyValue(chassisCard, "Clutch capacity", 5)
		local function renderDerived()
			local r, stats = Tuning.readouts()
			if not r then
				return
			end
			springs.Text = string.format("%.0f / %.0f N/mm", r.springFront, r.springRear)
			corners.Text = string.format("%.0f / %.0f kg", r.cornerFront, r.cornerRear)
			brakes.Text = string.format("%.0f / %.0f Nm", r.brakeFront, r.brakeRear)
			inertia.Text = string.format("%.3f kg·m²", stats.wheelInertia)
			clutch.Text = string.format("%.0f Nm", stats.clutch.maxTorque)
		end
		table.insert(derivedRefs, renderDerived)
		renderDerived()

		local note = card(parent, { order = 4 })
		text(note, "Springs, dampers, brake torques, clutch capacity and the engine sound crossfades are derived from the values you set, so changing mass or wheel size keeps the car balanced. Anything marked AUTO follows its inputs until you override it.", {
			size = 12,
			color = C.dim,
			wrap = true,
			auto = Enum.AutomaticSize.Y,
			height = 0,
		})
	end

	local function expert(parent)
		local info = card(parent, { order = 0 })
		text(info, "Direct overrides on the final physics table. Use these for values without a friendly control; they win over everything else.", { size = 12, color = C.dim, wrap = true, auto = Enum.AutomaticSize.Y, height = 0 })
		local listHolder = new("Frame", { Parent = parent, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1 }, { vlist(2) })
		local function render()
			for _, child in ipairs(listHolder:GetChildren()) do
				if child:IsA("GuiObject") then
					child:Destroy()
				end
			end
			local rows = Tuning.rawRows(search.Text)
			local limit = 160
			for i, r in ipairs(rows) do
				if i > limit then
					text(listHolder, (#rows - limit) .. " more - refine the search", { size = 12, color = C.mute, height = 24, order = i })
					break
				end
				local row = new("Frame", { Parent = listHolder, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = i })
				text(row, r.id, { size = 12, mono = true, color = r.overridden and C.text or C.dim, sizeUDim = UDim2.new(1, -166, 1, 0) })
				local box = input(row, { text = tostring(r.value), mono = true, align = Enum.TextXAlignment.Right, size = UDim2.fromOffset(112, 24), position = UDim2.new(1, -158, 0, 2), textSize = 12 })
				local reset = iconButton(row, "Reset", { size = UDim2.fromOffset(42, 24), position = UDim2.new(1, -42, 0, 2), textSize = 11, visible = r.overridden })
				bind(box.FocusLost, function()
					local v
					if r.kind == "number" then
						v = tonumber(box.Text)
					elseif r.kind == "boolean" then
						v = box.Text:lower() == "true"
					else
						v = box.Text
					end
					if v == nil then
						box.Text = tostring(r.value)
						return
					end
					if v ~= r.value then
						Tuning.setRaw(r.path, v)
					end
				end)
				bind(reset.Activated, function()
					Tuning.clearRaw(r.id)
				end)
			end
			if #rows == 0 then
				text(listHolder, "No matching values.", { size = 13, color = C.mute, height = 28 })
			end
		end
		rowRefs["#expert"] = render
		render()
	end

	-- section rendering ---------------------------------------------------------------

	local function matches(param, needle)
		if needle == "" then
			return true
		end
		return param.label:lower():find(needle, 1, true) ~= nil or param.id:lower():find(needle, 1, true) ~= nil
			or (param.group or ""):lower():find(needle, 1, true) ~= nil
	end

	local function render(animate)
		if closePopup then
			closePopup()
		end
		table.clear(rowRefs)
		table.clear(derivedRefs)
		local old = body
		body = scrollPage(bodyHolder)
		body.Position = UDim2.fromOffset(0, animate and 10 or 0)
		if animate then
			tween(body, { Position = UDim2.fromOffset(0, 0) }, 0.26)
		end
		if old then
			old:Destroy()
		end

		local needle = search.Text:lower():gsub("^%s+", ""):gsub("%s+$", "")
		local tier = ui.tier
		resultNote.Text = ""

		if currentSection == "overview" and needle == "" then
			overview(body)
			return
		elseif currentSection == "expert" then
			expert(body)
			return
		end

		-- parameters (searching spans every section)
		local groups, order = {}, {}
		local shown, hidden = 0, 0
		for _, param in ipairs(Spec.params) do
			local inSection = needle ~= "" or param.section == currentSection
			if inSection and matches(param, needle) then
				if tier == "advanced" or param.tier == "basic" or needle ~= "" or Tuning.isModified(param.id) then
					local key = (needle ~= "" and (param.section .. " · ") or "") .. (param.group or "")
					if not groups[key] then
						groups[key] = {}
						table.insert(order, key)
					end
					table.insert(groups[key], param)
					shown += 1
				else
					hidden += 1
				end
			end
		end
		if needle ~= "" then
			resultNote.Text = shown .. " match" .. (shown == 1 and "" or "es")
		end

		local o = 0
		if currentSection == "engine" and needle == "" then
			o += 1
			torqueGraph(body, o)
		end
		for _, key in ipairs(order) do
			o += 1
			local group = card(body, { order = o })
			vlist(6).Parent = group
			local sectionReset
			if needle == "" then
				sectionReset = new("TextButton", { Text = "Reset", FontFace = font(W.semibold), TextSize = 12, TextColor3 = C.mute, Size = UDim2.fromOffset(44, 20), AutoButtonColor = false })
			end
			sectionLabel(group, key ~= "" and key or "General", 0, sectionReset)
			if sectionReset then
				local ids = {}
				for _, p in ipairs(groups[key]) do
					table.insert(ids, p.id)
				end
				local function paintReset()
					local any = false
					for _, id in ipairs(ids) do
						if Tuning.isModified(id) then
							any = true
						end
					end
					sectionReset.Visible = any
				end
				bind(sectionReset.Activated, function()
					for _, id in ipairs(ids) do
						Tuning.reset(id)
					end
				end)
				table.insert(derivedRefs, paintReset)
				paintReset()
			end
			for i, param in ipairs(groups[key]) do
				local kind = param.kind
				if kind == "number" then
					numberRow(group, param, i)
				elseif kind == "bool" then
					boolRow(group, param, i)
				elseif kind == "enum" then
					enumRow(group, param, i)
				elseif kind == "pack" then
					packRow(group, param, i)
				elseif kind == "sound" then
					soundRow(group, param, i)
				elseif kind == "gears" then
					gearsRow(group, param, i)
				elseif kind == "curve" then
					curveRow(group, param, i)
				end
			end
		end
		if shown == 0 then
			text(body, needle ~= "" and "Nothing matches that search." or "Everything here is advanced. Switch Detail to Advanced to see it.", { size = 13, color = C.mute, height = 40, wrap = true, order = 1 })
		elseif hidden > 0 and needle == "" then
			o += 1
			local more = button(body, ("Show %d advanced setting%s"):format(hidden, hidden == 1 and "" or "s"), { style = "ghost", order = o, size = UDim2.new(1, 0, 0, 32), textSize = 13 })
			bind(more.instance.Activated, function()
				ui.tier = "advanced"
				tierPick.set("advanced")
				render(true)
			end)
		end
	end

	for i, s in ipairs(sectionList) do
		local b = new("TextButton", {
			Parent = chipBar,
			Text = s.label,
			FontFace = font(W.semibold),
			TextSize = 13,
			TextColor3 = C.dim,
			BackgroundColor3 = C.raised,
			BackgroundTransparency = 0,
			Size = UDim2.fromOffset(0, 28),
			AutomaticSize = Enum.AutomaticSize.X,
			AutoButtonColor = false,
			LayoutOrder = i,
		}, { corner(14), padding(0, 12, 0, 12) })
		local dot = new("Frame", { Parent = b, BackgroundColor3 = C.accent, BackgroundTransparency = 0, Size = UDim2.fromOffset(5, 5), Position = UDim2.new(1, -2, 0, 4), Visible = false }, { corner(3) })
		bind(b.MouseEnter, function()
			if s.id ~= currentSection then
				tween(b, { BackgroundColor3 = C.hover }, 0.1)
			end
		end)
		bind(b.MouseLeave, function()
			if s.id ~= currentSection then
				tween(b, { BackgroundColor3 = C.raised }, 0.16)
			end
		end)
		bind(b.Activated, function()
			if currentSection == s.id and search.Text == "" then
				return
			end
			currentSection = s.id
			ui.section = s.id
			search.Text = ""
			paintChips(true)
			render(true)
		end)
		chips[s.id] = { button = b, dot = dot }
	end

	tierPick.setHandler(function(v)
		ui.tier = v
		render(true)
	end)

	local searchToken = 0
	bind(search:GetPropertyChangedSignal("Text"), function()
		searchToken += 1
		local mine = searchToken
		task.delay(0.18, function()
			if mine == searchToken then
				render(false)
			end
		end)
	end)

	-- live updates: targeted row refresh + coalesced derived refresh
	local derivedQueued = false
	bind(Tuning.changed.Event, function(id)
		if id == "configs" then
			return
		end
		if id == nil or id == "sounds" then
			presetPick.set(Tuning.presetName())
			if activeTab == "Tune" then
				render(false)
			end
			paintChips(false)
			return
		end
		if type(id) == "string" and id:sub(1, 4) == "raw:" then
			local fn = rowRefs["#expert"]
			if fn then
				fn()
			end
		else
			local param = Spec.byId[id]
			if param then
				paramValueChanged(param)
			end
			if id == "engine.curveMode" then
				if Tuning.get("engine.curveMode") == "Custom" and Tuning.get("engine.curve") == nil then
					local r = Tuning.readouts()
					if r then
						local copy = {}
						for i, p in ipairs(r.points) do
							copy[i] = { rpm = math.floor(p.rpm + 0.5), torque = math.floor(p.torque + 0.5) }
						end
						Tuning.set("engine.curve", copy)
					end
				end
				local fn = rowRefs["engine.curveMode#curve"]
				if fn then
					fn()
				end
			end
			-- auto values can depend on this one
			for pid, fn in pairs(rowRefs) do
				local p = Spec.byId[pid]
				if p and p.auto and Tuning.isAuto(pid) then
					fn()
				end
			end
		end
		paintChips(false)
		if not derivedQueued then
			derivedQueued = true
			task.delay(0.08, function()
				derivedQueued = false
				for _, fn in ipairs(derivedRefs) do
					fn()
				end
			end)
		end
	end)

	bind(saveBtn.instance.Activated, function()
		local ok, msg = Tuning.save(configName.Text)
		UI.notify(ok and "ok" or "warn", msg or (ok and "Saved" or "Could not save"))
	end)
	bind(loadBtn.instance.Activated, function()
		openPopup(loadBtn.instance, function(list)
			local names = Tuning.list()
			for i, name in ipairs(names) do
				menuItem(list, name, false, function()
					local ok, msg = Tuning.load(name)
					configName.Text = name
					UI.notify(ok and "ok" or "warn", ok and ("Loaded " .. name) or msg)
				end, function()
					if closePopup then
						closePopup()
					end
				end, i)
			end
			if #names == 0 then
				text(list, "  No saved configs yet", { size = 13, color = C.mute, height = 30, z = 53 })
				return 1
			end
			return #names
		end, 220)
	end)
	bind(shareBtn.instance.Activated, function()
		local exportText = Tuning.export()
		local field
		modal("Share tune", function(b)
			text(b, "Copy this to share the tune, or paste one here and import it.", { size = 13, color = C.dim, wrap = true, auto = Enum.AutomaticSize.Y, height = 0, order = 1, z = 62 })
			field = input(b, { text = exportText, multiline = true, mono = true, size = UDim2.new(1, 0, 0, 150), order = 2, textSize = 11, z = 62 })
		end, {
			{ label = "Close", style = "ghost" },
			{
				label = "Import",
				style = "primary",
				onClick = function()
					if field.Text == exportText then
						UI.notify("info", "Paste a tune first")
						return
					end
					local ok, err = Tuning.import(field.Text)
					UI.notify(ok and "ok" or "warn", ok and "Tune imported" or err)
				end,
			},
		})
	end)
	bind(resetBtn.instance.Activated, function()
		modal("Reset the tune?", function(b)
			text(b, ("This clears %d change%s and returns to the %s preset."):format(Tuning.modifiedCount(), Tuning.modifiedCount() == 1 and "" or "s", Tuning.presetName()), { size = 13, color = C.dim, wrap = true, auto = Enum.AutomaticSize.Y, height = 0, z = 62 })
		end, {
			{ label = "Cancel", style = "ghost" },
			{
				label = "Reset",
				style = "danger",
				onClick = function()
					Tuning.resetAll()
					UI.notify("ok", "Tune reset")
				end,
			},
		})
	end)

	paintChips(false)
	local built = false
	return function()
		if not built then
			built = true
			render(false)
		end
	end
end

