	local row = new("Frame", { Parent = box, Size = UDim2.new(1, 0, 0, 34), LayoutOrder = 3, ZIndex = 62 }, { hlist(8, nil, Enum.HorizontalAlignment.Right) })
	local function close()
		tween(scale, { Scale = 0.97 }, 0.12)
		tween(scrim, { BackgroundTransparency = 1 }, 0.15).Completed:Once(function()
			scrim:Destroy()
		end)
		box.Visible = false
	end
	for i, a in ipairs(actions) do
		local b = button(row, a.label, { style = a.style, size = UDim2.fromOffset(0, 34), auto = Enum.AutomaticSize.X, order = i, z = 63 })
		b.instance.Activated:Connect(function()
			if not a.keepOpen then
				close()
			end
			if a.onClick then
				a.onClick(close)
			end
		end)
	end
	return close
end

