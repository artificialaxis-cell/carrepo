			tween(b, { TextColor3 = C.dim }, 0.16)
		end)
		bind(b.Activated, onClick)
		return b
	end
	link("Reconnect", 1, function()
		if Net then
			Net.reconnect()
		end
	end)
	local loop
	if RunService:IsStudio() and Net then
		loop = link("Loopback test: off", 2, function()
			Net.loopback(not Net.isLoopback())
		end)
		attachTooltip(loop, "Mirrors your own car back as a fake peer so replication can be tested without a relay.")
	end

	return function()
		local meta = LINK_STATES[Connection.status] or LINK_STATES.DISCONNECTED
		dot.BackgroundColor3 = meta[2]
		state.Text = meta[1]
		latency.Text = Connection.latency and string.format("%d ms", Connection.latency * 1000) or ""
		detail.Text = Connection.detail ~= "" and Connection.detail or ""
		if loop then
			loop.Text = "Loopback test: " .. (Net.isLoopback() and "on" or "off")
		end
		for _, child in ipairs(list:GetChildren()) do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		for i, entry in ipairs(Connection.players) do
			local r = new("Frame", { Parent = list, Size = UDim2.new(1, 0, 0, 26), LayoutOrder = i })
			text(r, entry.name, { size = 13, color = entry.present and C.text or C.mute, sizeUDim = UDim2.new(1, -60, 1, 0) })
			text(r, entry.hasCar and "car" or "-", { size = 12, color = entry.hasCar and C.accent or C.faint, align = Enum.TextXAlignment.Right, position = UDim2.new(1, -60, 0, 0), sizeUDim = UDim2.new(0, 60, 1, 0) })
		end
		if #Connection.players == 0 then
			text(list, Connection.status == "CONNECTED" and "No other hub users in this server." or "", { size = 12, color = C.faint, height = 26 })
		end
	end
end

