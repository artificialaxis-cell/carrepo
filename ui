-- hover/press feedback on a background
local function interactive(button, base, hover, press)
	button.AutoButtonColor = false
	button.BackgroundColor3 = base
	local over = false
	bind(button.MouseEnter, function()
		over = true
		tween(button, { BackgroundColor3 = hover }, 0.12)
	end)
	bind(button.MouseLeave, function()
		over = false
		tween(button, { BackgroundColor3 = base }, 0.18)
	end)
	bind(button.MouseButton1Down, function()
		tween(button, { BackgroundColor3 = press or hover }, 0.06)
	end)
	bind(button.MouseButton1Up, function()
		tween(button, { BackgroundColor3 = over and hover or base }, 0.14)
	end)
	return function(newBase, newHover, newPress)
		base, hover, press = newBase, newHover or hover, newPress or press
		tween(button, { BackgroundColor3 = over and hover or base }, 0.14)
	end
end

local BUTTON_STYLES = {
	primary = { C.accent, C.accentHover, rgb(222, 122, 44), C.accentText },
	secondary = { C.raised, C.hover, C.press, C.text },
	ghost = { C.panel, C.raised, C.hover, C.dim },
	danger = { C.raised, rgb(70, 38, 36), rgb(84, 42, 40), C.bad },
}

local function button(parent, label, opts)
	opts = opts or {}
	local style = BUTTON_STYLES[opts.style or "secondary"]
	local btn = new("TextButton", {
		Parent = parent,
		Text = label,
		FontFace = font(opts.weight or W.semibold),
		TextSize = opts.textSize or 14,
		TextColor3 = style[4],
		Size = opts.size or UDim2.new(1, 0, 0, 34),
		Position = opts.position,
		AnchorPoint = opts.anchor,
		LayoutOrder = opts.order or 0,
		AutomaticSize = opts.auto,
		ZIndex = opts.z or 1,
		BackgroundTransparency = 0,
	}, { corner(opts.radius or 6) })
	if opts.auto then
		padding(0, 12, 0, 12).Parent = btn
	end
	local restyle = interactive(btn, style[1], style[2], style[3])
	local scale = new("UIScale", { Parent = btn })
	bind(btn.MouseButton1Down, function()
		tween(scale, { Scale = 0.97 }, 0.08)
	end)
	bind(btn.MouseButton1Up, function()
		tween(scale, { Scale = 1 }, 0.2, Enum.EasingStyle.Back)
	end)
	bind(btn.MouseLeave, function()
		tween(scale, { Scale = 1 }, 0.16)
	end)
	if opts.onClick then
		bind(btn.Activated, opts.onClick)
	end
	local api = { instance = btn }
	function api.setStyle(name)
		local s = BUTTON_STYLES[name]
		restyle(s[1], s[2], s[3])
		tween(btn, { TextColor3 = s[4] }, 0.14)
	end
	function api.setText(value)
		btn.Text = value
	end
	function api.setEnabled(enabled)
		btn.Active = enabled
		btn.AutoButtonColor = false
		tween(btn, { TextTransparency = enabled and 0 or 0.55 }, 0.14)
	end
	return api
end

