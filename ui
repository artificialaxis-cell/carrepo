	local partsTools = new("Frame", { Size = UDim2.fromOffset(170, 22) }, { hlist(6, nil, Enum.HorizontalAlignment.Right) })
	sectionLabel(partsCard, "Meshes", 0, partsTools)
	local autoBtn = button(partsTools, "Auto-assign", { style = "ghost", size = UDim2.fromOffset(0, 22), auto = Enum.AutomaticSize.X, textSize = 12, order = 1 })
	local rescanBtn = button(partsTools, "Rescan", { style = "ghost", size = UDim2.fromOffset(0, 22), auto = Enum.AutomaticSize.X, textSize = 12, order = 2 })
	local partList = new("Frame", { Parent = partsCard, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1 }, { vlist(2) })
	local roleBar = segmented(partsCard, ROLE_ORDER, ROLE_LABELS, nil, nil, { order = 2, textSize = 12 })
	local roleHint = text(partsCard, "Select a mesh to assign its role.", { size = 12, color = C.mute, order = 3, wrap = true, auto = Enum.AutomaticSize.Y, height = 0 })

	-- layout --------------------------------------------------------------------------
	local layoutCard = card(scroll, { order = 3 })
	vlist(6).Parent = layoutCard
	local layoutTools = new("Frame", { Size = UDim2.fromOffset(190, 22) }, { hlist(6, nil, Enum.HorizontalAlignment.Right) })
	sectionLabel(layoutCard, "Wheel layout", 0, layoutTools)
	local saveProfileBtn = button(layoutTools, "Save profile", { style = "ghost", size = UDim2.fromOffset(0, 22), auto = Enum.AutomaticSize.X, textSize = 12, order = 1 })
	local redetectBtn = button(layoutTools, "Re-detect", { style = "ghost", size = UDim2.fromOffset(0, 22), auto = Enum.AutomaticSize.X, textSize = 12, order = 2 })
	local summary = text(layoutCard, "", { size = 12, mono = true, color = C.dim, order = 1, height = 16 })
	local sliders = {}
	for i, field in ipairs(LAYOUT_FIELDS) do
		sliders[field.key] = sliderRow(layoutCard, {
			label = field.label,
			unit = "st",
			min = field.min,
			max = field.max,
			step = field.step,
			value = 0,
			order = i + 1,
			hint = field.hint,
			param = { step = field.step },
			onChange = function(v)
				local layout = CarInit.layout
				if layout then
					layoutSet(CarInit, layout, field.key, v)
				end
			end,
		})
	end
	local dirtyNote = text(layoutCard, "Layout changed - rebuild the chassis to apply it to the running car.", { size = 12, color = C.warn, order = 50, wrap = true, auto = Enum.AutomaticSize.Y, height = 0, visible = false })
	local rebuildBtn = button(layoutCard, "Rebuild chassis", { style = "primary", order = 51 })
	rebuildBtn.instance.Visible = false
	bind(rebuildBtn.instance.Activated, function()
		local ok, why = CarInit.rebuild()
		if not ok then
			UI.notify("info", why)
		end
	end)

	-- preview contents ----------------------------------------------------------------
	local selected
	local previewParts = {}
	local rows = {}

	local function line(a, b, color, thickness)
		local len = (b - a).Magnitude
		if len < 1e-3 then
			return
		end
		new("Part", {
			Parent = overlayModel,
			Anchored = true,
			Material = Enum.Material.SmoothPlastic,
			Color = color,
			Size = Vector3.new(thickness, thickness, len),
			CFrame = CFrame.lookAt((a + b) / 2, b),
			Transparency = 0.05,
		})
	end

	local function drawChassis()
		overlayModel:ClearAllChildren()
		local layout = CarInit.layout
		if not (layout and showChassis) then
			return
		end
		local origin = CFrame.new(0, layout.wheelY, (layout.frontZ + layout.rearZ) / 2)
		local col = C.accent
		local soft = rgb(214, 216, 222)
		local t = math.max(layout.radiusFront * 0.05, 0.06)
		local function P(v)
			return origin:PointToWorldSpace(v)
		end
		for _, name in ipairs(Chassis.ORDER) do
			local pts = Chassis.corner(layout, name)
			line(P(pts.hubStrut), P(pts.strutTop), col, t * 1.6)
			for _, link in ipairs(pts.links) do
				line(P(link.hub), P(link.body), soft, t)
			end
			if pts.steerArm and pts.rackEnd then
				line(P(pts.steerArm), P(pts.rackEnd), rgb(226, 178, 72), t)
			end
			local width = pts.front and layout.widthFront or layout.widthRear
			new("Part", {
				Parent = overlayModel,
				Anchored = true,
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(width * 1.02, pts.radius * 2, pts.radius * 2),
				CFrame = CFrame.new(P(pts.center)),
				Color = col,
				Transparency = 0.82,
				Material = Enum.Material.SmoothPlastic,
			})
		end
		local fl, fr = Chassis.corner(layout, "FL"), Chassis.corner(layout, "FR")
		local rl, rr = Chassis.corner(layout, "RL"), Chassis.corner(layout, "RR")
		line(P(fl.center), P(fr.center), soft, t * 0.8)
		line(P(rl.center), P(rr.center), soft, t * 0.8)
		if fl.rackEnd then
			line(P(fl.rackEnd), P(fr.rackEnd), rgb(226, 178, 72), t * 1.4)
		end
	end

	local function paintSelection()
		for part, info in pairs(previewParts) do
			local dim = selected ~= nil and info.id ~= selected
			part.LocalTransparencyModifier = dim and 0.85 or 0
		end
	end

	local function rebuildPreview()
		stage:ClearAllChildren()
		table.clear(previewParts)
		local scan = CarInit.scan
		local layout = CarInit.layout
		if not scan or not scan.folder then
			emptyLabel.Text = "No VFX car found for the run token."
			emptyLabel.Visible = true
			drawChassis()
			return
		end
		local body
		for _, id in ipairs(scan.order) do
			if CarInit.roleOf(id) == "BODY" then
				body = scan.groups[id].parts[1]
			end
		end
		local bodyFrame = body and body.CFrame or CFrame.new()
		local placedWheels = {}
		local count = 0
		for _, id in ipairs(scan.order) do
			local group = scan.groups[id]
			local role, side = CarInit.roleOf(id)
			for _, part in ipairs(group.parts) do
				local isWheel = role == "TIRE" or role == "RIM" or role == "WHEEL"
				if not (isWheel and layout) then
					local copy = part:Clone()
					if copy then
						for _, child in ipairs(copy:GetChildren()) do
							if not (child:IsA("SpecialMesh") or child:IsA("SurfaceAppearance") or child:IsA("Decal") or child:IsA("Texture")) then
								child:Destroy()
							end
						end
						copy.Anchored = true
						copy.CFrame = bodyFrame:ToObjectSpace(part.CFrame)
						copy.Parent = stage
						previewParts[copy] = { id = id }
						count += 1
					end
				end
			end
			-- wheels are drawn where the layout puts them
			if layout and (role == "TIRE" or role == "RIM" or role == "WHEEL") then
				local template = group.parts[1]
				for _, name in ipairs(Chassis.ORDER) do
					local info = Chassis.CORNERS[name]
					local wantSide = info.side < 0 and "L" or "R"
					local partSide = side or (bodyFrame:PointToObjectSpace(template.Position).X < 0 and "L" or "R")
					local key = name .. role
					if partSide == wantSide and not placedWheels[key] then
						placedWheels[key] = true
						local half = (info.front and layout.trackFront or layout.trackRear) / 2
						local copy = template:Clone()
						for _, child in ipairs(copy:GetChildren()) do
							if not (child:IsA("SpecialMesh") or child:IsA("SurfaceAppearance") or child:IsA("Decal") or child:IsA("Texture")) then
								child:Destroy()
							end
						end
						copy.Anchored = true
						copy.CFrame = CFrame.new(info.side * half, layout.wheelY, info.front and layout.frontZ or layout.rearZ)
						copy.Parent = stage
						previewParts[copy] = { id = id }
						count += 1
					end
				end
			end
		end
		emptyLabel.Visible = count == 0
		emptyLabel.Text = count == 0 and "The VFX folder has no mesh parts." or ""
		if layout then
			local size = layout.bodySize or Vector3.new(10, 6, 23)
			focus = Vector3.new(0, layout.wheelY * 0.4, (layout.frontZ + layout.rearZ) / 4)
			distance = math.clamp(size.Magnitude * 1.25, zoomLow, zoomHigh)
			placeCamera()
		end
		paintSelection()
		drawChassis()
	end

	local function paintRows()
		for id, row in pairs(rows) do
			local role = CarInit.roleOf(id)
			local color = role and ROLE_COLORS[role] or C.faint
			tween(row.button, { BackgroundColor3 = id == selected and C.hover or C.surface }, 0.14)
			row.dot.BackgroundColor3 = color
			row.tag.Text = role and (role:sub(1, 1) .. role:sub(2):lower()) or "Unassigned"
			row.tag.TextColor3 = role and color or C.mute
		end
		local role = selected and CarInit.roleOf(selected)
		roleBar.set(selected and (role or "NONE") or nil)
		roleHint.Text = selected and ("Mesh " .. shortId(selected) .. (CarInit.hasCustom() and "" or " · using built-in roles; any change switches to a custom definition"))
			or "Select a mesh to assign its role. Tire + rim, or one wheel mesh per corner."
	end

	local function buildRows()
		for _, child in ipairs(partList:GetChildren()) do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		table.clear(rows)
		local scan = CarInit.scan
		if not scan or #scan.order == 0 then
			text(partList, scan and scan.folder and "No mesh parts found." or "No VFX folder yet. Trigger the car move, then Rescan.", { size = 13, color = C.mute, height = 28, wrap = true })
			return
		end
		for i, id in ipairs(scan.order) do
			local group = scan.groups[id]
			local b = new("TextButton", {
				Parent = partList,
				Text = "",
				Size = UDim2.new(1, 0, 0, 30),
				BackgroundColor3 = C.surface,
				BackgroundTransparency = 0,
				AutoButtonColor = false,
				LayoutOrder = i,
			}, { corner(6) })
			local dot = new("Frame", { Parent = b, Size = UDim2.fromOffset(8, 8), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 10, 0.5, 0), BackgroundTransparency = 0 }, { corner(4) })
			local size = group.size
			text(b, shortId(id), { size = 13, mono = true, weight = W.medium, position = UDim2.fromOffset(26, 0), sizeUDim = UDim2.new(0.45, -26, 1, 0) })
			text(b, ("×%d%s"):format(#group.parts, size and string.format("  %.1f×%.1f×%.1f", size.X, size.Y, size.Z) or ""), { size = 12, mono = true, color = C.mute, position = UDim2.new(0.45, 0, 0, 0), sizeUDim = UDim2.new(0.33, 0, 1, 0) })
			local tag = text(b, "", { size = 12, weight = W.semibold, align = Enum.TextXAlignment.Right, position = UDim2.new(0.78, 0, 0, 0), sizeUDim = UDim2.new(0.22, -10, 1, 0) })
			bind(b.MouseEnter, function()
				if id ~= selected then
					tween(b, { BackgroundColor3 = C.raised }, 0.1)
				end
			end)
			bind(b.MouseLeave, function()
				tween(b, { BackgroundColor3 = id == selected and C.hover or C.surface }, 0.16)
			end)
			bind(b.Activated, function()
				selected = selected ~= id and id or nil
				paintRows()
				paintSelection()
			end)
			rows[id] = { button = b, dot = dot, tag = tag }
		end
		paintRows()
	end

	local function refreshLayout()
		local layout = CarInit.layout
		for _, field in ipairs(LAYOUT_FIELDS) do
			local slider = sliders[field.key]
			slider.instance.Visible = layout ~= nil
			if layout then
				slider.set(layoutGet(layout, field.key), false, false)
			end
		end
		if layout then
			local S = 0.28
			summary.Text = string.format("wb %.2f m · track %.2f/%.2f m · tire Ø %.2f m", (layout.rearZ - layout.frontZ) * S, layout.trackFront * S, layout.trackRear * S, layout.radiusFront * 2 * S)
			sourceChip.Text = SOURCE_LABELS[layout.source] or "Layout"
		else
			summary.Text = "Layout resolves once a body mesh is assigned."
			sourceChip.Text = "No layout"
		end
		local dirty = CarInit.layoutDirty and CarInit.canRebuild()
		dirtyNote.Visible = dirty
		rebuildBtn.instance.Visible = dirty
	end

	local scanning = false
	local function rescan(forceLayout)
		if scanning then
			return
		end
		scanning = true
		task.spawn(function()
			local ok, err = pcall(function()
				if CarInit.canInitialize() or not CarInit.scan then
					CarInit.scanFolder()
				end
				CarInit.resolveLayout(forceLayout)
			end)
			scanning = false
			if not ok then
				warn("Build preview: " .. tostring(err))
			end
			buildRows()
			refreshLayout()
			rebuildPreview()
		end)
	end

	bind(autoBtn.instance.Activated, function()
		if not CarInit.canInitialize() then
			UI.notify("info", "Roles are locked once the car is built")
			return
		end
		if CarInit.autoAssign() then
			UI.notify("ok", "Roles assigned from mesh shapes")
		else
			UI.notify("warn", "Could not tell the parts apart - assign them by hand")
		end
	end)
	bind(rescanBtn.instance.Activated, function()
		rescan(true)
	end)
	bind(saveProfileBtn.instance.Activated, function()
		if CarInit.saveProfile() then
			UI.notify("ok", Tuning.hasFiles() and "Layout saved for this body" or "Layout saved for this session")
		else
			UI.notify("info", "Nothing to save yet")
		end
	end)
	bind(redetectBtn.instance.Activated, function()
		task.spawn(function()
			CarInit.forgetProfile()
			refreshLayout()
			rebuildPreview()
		end)
	end)
	bind(chassisToggle.Activated, function()
		showChassis = not showChassis
		Tuning.state.ui.showChassis = showChassis
		tween(chassisToggle, { BackgroundColor3 = showChassis and C.accent or C.panel, TextColor3 = showChassis and C.accentText or C.dim }, 0.16)
		drawChassis()
	end)

	roleBar.setHandler(function(role)
		if not selected then
			UI.notify("info", "Select a mesh first")
			roleBar.set(nil)
			return
		end
		if not CarInit.canInitialize() then
			UI.notify("info", "Roles are locked once the car is built")
			paintRows()
			return
		end
		if not CarInit.hasCustom() then
			-- seed the custom definition with the built-in roles so nothing is lost
			for _, id in ipairs(CarInit.scan and CarInit.scan.order or {}) do
				local r = CarInit.roleOf(id)
				CarInit.roles[id] = r
			end
		end
		CarInit.setRole(selected, role ~= "NONE" and role or nil)
	end)

	local pendingLayout = false
	bind(CarInit.layoutChanged.Event, function()
		refreshLayout()
		if pendingLayout then
			return
		end
		pendingLayout = true
		task.delay(0.05, function()
			pendingLayout = false
			rebuildPreview()
		end)
	end)
	bind(CarInit.rolesChanged.Event, function()
		paintRows()
		task.spawn(function()
			pcall(CarInit.resolveLayout, true)
			refreshLayout()
			rebuildPreview()
		end)
	end)
	bind(CarInit.changed.Event, function()
		refreshLayout()
	end)

	local loaded = false
	return function()
		if not loaded then
			loaded = true
			rescan(false)
		else
			refreshLayout()
		end
	end
end

