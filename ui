local closePopup

local function openPopup(anchor, build, width)
	if closePopup then
		closePopup()
	end
	local catcher = new("TextButton", {
		Parent = overlay,
		Text = "",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 50,
		AutoButtonColor = false,
	})
	local abs, size = anchor.AbsolutePosition, anchor.AbsoluteSize
	local scale = gui:FindFirstChildOfClass("UIScale")
	local s = scale and scale.Scale or 1
	local pop = new("Frame", {
		Parent = overlay,
		BackgroundColor3 = C.raised,
		BackgroundTransparency = 0,
		Position = UDim2.fromOffset(abs.X / s, (abs.Y + size.Y + 4) / s),
		Size = UDim2.fromOffset((width or size.X) / s, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		ZIndex = 51,
	}, { corner(8), stroke(C.line), padding(4) })
	local list = new("ScrollingFrame", {
		Parent = pop,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.None,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = C.faint,
		ZIndex = 52,
	}, { vlist(2) })
	local count = build(list)
	list.Size = UDim2.new(1, 0, 0, math.min(count, 8) * 30 + math.max(math.min(count, 8) - 1, 0) * 2)
	local scaleObj = new("UIScale", { Parent = pop, Scale = 0.96 })
	pop.BackgroundTransparency = 1
	tween(pop, { BackgroundTransparency = 0 }, 0.12)
	tween(scaleObj, { Scale = 1 }, 0.16)
	local closing = false
	local function close()
		if closing then
			return
		end
		closing = true
		closePopup = nil
		catcher:Destroy()
		tween(scaleObj, { Scale = 0.97 }, 0.1)
		local t = tween(pop, { BackgroundTransparency = 1 }, 0.1)
		for _, d in ipairs(pop:GetDescendants()) do
			if d:IsA("TextButton") or d:IsA("TextLabel") then
				tween(d, { TextTransparency = 1, BackgroundTransparency = 1 }, 0.08)
			end
		end
		t.Completed:Once(function()
			pop:Destroy()
		end)
	end
	closePopup = close
	catcher.Activated:Connect(close)
	return close
end

local function menuItem(list, label, selected, onPick, close, order, sub)
	local b = new("TextButton", {
		Parent = list,
		Text = "",
		Size = UDim2.new(1, -4, 0, 30),
		BackgroundTransparency = 0,
		LayoutOrder = order or 0,
		ZIndex = 53,
	}, { corner(5) })
	interactive(b, C.raised, C.hover, C.press)
	text(b, label, {
		size = 13,
		weight = selected and W.semibold or W.medium,
		color = selected and C.text or C.dim,
		position = UDim2.fromOffset(10, 0),
		sizeUDim = UDim2.new(1, sub and -90 or -30, 1, 0),
		z = 54,
	})
	if sub then
		text(b, sub, { size = 12, color = C.mute, align = Enum.TextXAlignment.Right, position = UDim2.new(1, -86, 0, 0), sizeUDim = UDim2.new(0, 76, 1, 0), z = 54 })
	end
	if selected then
		new("Frame", {
			Parent = b,
			BackgroundColor3 = C.accent,
			BackgroundTransparency = 0,
			Size = UDim2.fromOffset(3, 14),
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 2, 0.5, 0),
			ZIndex = 54,
		}, { corner(2) })
	end
	b.Activated:Connect(function()
		close()
		onPick()
	end)
	return b
end

local function dropdown(parent, getOptions, value, onChange, opts)
	opts = opts or {}
	local btn = new("TextButton", {
		Parent = parent,
		Text = "",
		Size = opts.size or UDim2.new(1, 0, 0, 30),
		Position = opts.position,
		AnchorPoint = opts.anchor,
		LayoutOrder = opts.order or 0,
		BackgroundTransparency = 0,
	}, { corner(6), stroke(C.line) })
	interactive(btn, C.raised, C.hover, C.press)
	local lbl = text(btn, "", { size = 13, weight = W.medium, position = UDim2.fromOffset(10, 0), sizeUDim = UDim2.new(1, -34, 1, 0) })
	-- chevron drawn from two bars (font glyph coverage for arrows is unreliable)
	local chevron = new("Frame", { Parent = btn, Size = UDim2.fromOffset(10, 6), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -16, 0.5, 0) })
	for i, rot in ipairs({ 40, -40 }) do
		new("Frame", {
			Parent = chevron,
			BackgroundColor3 = C.mute,
			BackgroundTransparency = 0,
			Size = UDim2.fromOffset(7, 2),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(i == 1 and 0.3 or 0.7, 0, 0.5, 0),
			Rotation = rot,
		}, { corner(1) })
	end
	local current = value
	local function labelFor(v)
		for _, o in ipairs(getOptions()) do
			if o.value == v then
				return o.label
			end
		end
		return tostring(v or (opts.placeholder or "-"))
	end
	local function render()
		lbl.Text = labelFor(current)
		lbl.TextColor3 = current == nil and C.faint or C.text
	end
	render()
	bind(btn.Activated, function()
		openPopup(btn, function(list)
			local options = getOptions()
			for i, o in ipairs(options) do
				menuItem(list, o.label, o.value == current, function()
					current = o.value
					render()
					if onChange then
						onChange(o.value)
					end
				end, function()
					if closePopup then
						closePopup()
					end
				end, i, o.sub)
			end
			if #options == 0 then
				text(list, opts.empty or "Nothing here yet", { size = 13, color = C.mute, height = 30, z = 53 })
				return 1
			end
			return #options
		end, opts.popupWidth)
	end)
	return {
		instance = btn,
		set = function(v)
			current = v
			render()
		end,
		refresh = render,
	}
end

local function attachTooltip(target, message)
	if not message or message == "" then
		return
	end
	local token = 0
	bind(target.MouseEnter, function()
		token += 1
		local mine = token
		task.delay(0.45, function()
			if mine ~= token or not tooltipLabel then
				return
			end
			tooltipLabel.Text = message
			local abs = target.AbsolutePosition
			local scale = gui:FindFirstChildOfClass("UIScale")
			local s = scale and scale.Scale or 1
			tooltipLabel.Parent.Position = UDim2.fromOffset(abs.X / s, (abs.Y + target.AbsoluteSize.Y + 6) / s)
			tooltipLabel.Parent.Visible = true
			tooltipLabel.Parent.BackgroundTransparency = 1
			tooltipLabel.TextTransparency = 1
			tween(tooltipLabel.Parent, { BackgroundTransparency = 0 }, 0.14)
			tween(tooltipLabel, { TextTransparency = 0 }, 0.14)
		end)
	end)
	bind(target.MouseLeave, function()
		token += 1
		if tooltipLabel then
			tooltipLabel.Parent.Visible = false
		end
	end)
end

