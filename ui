		end
	end)

	-- telemetry
	local tele = card(scroll, { order = 2 })
	vlist(12).Parent = tele
	local top = new("Frame", { Parent = tele, Size = UDim2.new(1, 0, 0, 56), LayoutOrder = 1 })
	local speed = text(top, "0", { size = 44, weight = W.bold, mono = true, sizeUDim = UDim2.new(0.5, 0, 0, 46) })
	text(top, "km/h", { size = 12, color = C.mute, position = UDim2.fromOffset(0, 42), height = 14 })
	local gear = text(top, "N", { size = 44, weight = W.bold, mono = true, align = Enum.TextXAlignment.Right, position = UDim2.new(0.5, 0, 0, 0), sizeUDim = UDim2.new(0.5, 0, 0, 46) })
	local box = text(top, "Manual", { size = 12, color = C.mute, align = Enum.TextXAlignment.Right, position = UDim2.new(0.5, 0, 0, 42), sizeUDim = UDim2.new(0.5, 0, 0, 14) })

	local rpmRow = new("Frame", { Parent = tele, Size = UDim2.new(1, 0, 0, 30), LayoutOrder = 2 })
