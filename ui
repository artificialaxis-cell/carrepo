-- Shell
------------------------------------------------------------------------------------------

local TAB_NAMES = { "Drive", "Build", "Tune", "Link" }
local MARGIN = 10
local TAB_WIDTH = 64
local HEADER = 78

-- Per-view default panel sizes. Build opens nearly full-screen; Link is a small card.
local DEFAULT_SIZES = {
	Drive = UDim2.new(0, 360, 1, -2 * MARGIN),
	Build = UDim2.new(1, -2 * MARGIN, 1, -2 * MARGIN),
	Tune = UDim2.new(0, 410, 1, -2 * MARGIN),
	Link = UDim2.new(0, 320, 0, 300),
}
local MIN_SIZE = Vector2.new(300, 220)
local uiScale

local function logicalScreen()
	local s = uiScale and uiScale.Scale or 1
	local abs = gui and gui.AbsoluteSize or Vector2.new(1280, 720)
	return abs / s
end

local function sizeFor(name)
	local saved = deps.Tuning.state.ui.sizes and deps.Tuning.state.ui.sizes[name]
	if saved then
		local screen = logicalScreen()
		local w = math.clamp(saved[1], MIN_SIZE.X, math.max(screen.X - 2 * MARGIN, MIN_SIZE.X))
		local h = math.clamp(saved[2], MIN_SIZE.Y, math.max(screen.Y - 2 * MARGIN, MIN_SIZE.Y))
		return UDim2.fromOffset(w, h)
	end
	return DEFAULT_SIZES[name] or DEFAULT_SIZES.Drive
end

local function selectTab(name, animate)
	if activeTab == name then
		return
	end
	local previous = activeTab
	activeTab = name
	if closePopup then
		closePopup()
	end
	deps.Tuning.state.ui.tab = name
	for i, tabName in ipairs(TAB_NAMES) do
		local tab = tabs[tabName]
		local on = tabName == name
		tween(tab.button, { TextColor3 = on and C.text or C.mute }, animate and 0.16 or 0)
		if on then
			local target = UDim2.new(0, PAD + (i - 1) * TAB_WIDTH + 2, 1, -2)
			if animate then
				tween(tabs.indicator, { Position = target }, 0.26)
			else
				tabs.indicator.Position = target
			end
		end
	end
	local size = sizeFor(name)
	if animate then
		tween(panel, { Size = size }, 0.32)
	else
		panel.Size = size
	end
	local page = pages[name]
	if previous and pages[previous] then
		pages[previous].frame.Visible = false
	end
	page.frame.Visible = true
	if animate then
		page.frame.Position = UDim2.fromOffset(0, 6)
		tween(page.frame, { Position = UDim2.fromOffset(0, 0) }, 0.24)
	end
	if page.refresh then
		page.refresh()
	end
end

local function setStatus()
	local CarInit = deps.CarInit
	local meta = STATE_LABELS[CarInit.state] or STATE_LABELS.IDLE
	local label = meta[1]
	if CarInit.state == "ACTIVE" then
		local t = CarInit.telemetry()
		label = t and t.driving and "Driving" or "Parked"
	end
	statusText.Text = label
	tween(statusDot, { BackgroundColor3 = meta[2] }, 0.2)
end

-- Bottom-left grip (the panel hangs from the top-right corner).
local function resizeGrip()
	local grip = new("TextButton", {
		Parent = panel,
		Text = "",
		AutoButtonColor = false,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.fromOffset(18, 18),
		ZIndex = 20,
	})
	for i = 1, 2 do
		new("Frame", {
			Parent = grip,
			BackgroundColor3 = C.faint,
			BackgroundTransparency = 0,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(4 + i * 3, 11 - i * 3),
			Size = UDim2.fromOffset(i * 6, 1),
			Rotation = 45,
			ZIndex = 21,
		})
	end
	attachTooltip(grip, "Drag to resize · double-click to reset")
	local lastClick = 0
	bind(grip.InputBegan, function(io)
		if io.UserInputType ~= Enum.UserInputType.MouseButton1 and io.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		local now = os.clock()
		if now - lastClick < 0.3 then
			local sizes = deps.Tuning.state.ui.sizes
			if sizes then
				sizes[activeTab] = nil
			end
			tween(panel, { Size = sizeFor(activeTab) }, 0.28)
			return
		end
		lastClick = now
		local scale = uiScale and uiScale.Scale or 1
		local start = io.Position
		local startSize = panel.AbsoluteSize / scale
		local move = UserInputService.InputChanged:Connect(function(change)
			if change.UserInputType ~= Enum.UserInputType.MouseMovement and change.UserInputType ~= Enum.UserInputType.Touch then
				return
			end
			local d = (change.Position - start) / scale
			local screen = logicalScreen()
			local w = math.clamp(startSize.X - d.X, MIN_SIZE.X, screen.X - 2 * MARGIN)
			local h = math.clamp(startSize.Y + d.Y, MIN_SIZE.Y, screen.Y - 2 * MARGIN)
			panel.Size = UDim2.fromOffset(w, h)
		end)
		local ended
		ended = io.Changed:Connect(function()
			if io.UserInputState == Enum.UserInputState.End then
				move:Disconnect()
				ended:Disconnect()
				local s = panel.AbsoluteSize / (uiScale and uiScale.Scale or 1)
				local ui = deps.Tuning.state.ui
				ui.sizes = ui.sizes or {}
				ui.sizes[activeTab] = { math.floor(s.X + 0.5), math.floor(s.Y + 0.5) }
			end
		end)
	end)
end

function UI.build(modules)
	deps = modules
	-- `parentGui` lets the panel be previewed outside a play session
	local playerGui = modules.parentGui or Players.LocalPlayer:WaitForChild("PlayerGui")
	local old = playerGui:FindFirstChild("HubUI")
	if old then
		old:Destroy()
	end

	-- respect the top bar instead of offsetting by hand (the old double offset pushed
	-- the panel off the bottom of the screen)
	gui = new("ScreenGui", {
		Name = "HubUI",
		ResetOnSpawn = false,
		DisplayOrder = 100,
		IgnoreGuiInset = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	})
	pcall(function()
		gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	end)
	gui.Parent = playerGui
	uiScale = new("UIScale", { Parent = gui })
	local function rescale()
		local vp = gui.AbsoluteSize
		if vp.X < 2 then
			vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 800)
		end
		uiScale.Scale = math.clamp(math.min(vp.Y / 820, vp.X / 1100), 0.7, 1)
	end
	rescale()
	bind(gui:GetPropertyChangedSignal("AbsoluteSize"), function()
		rescale()
		if panel and activeTab then
			panel.Size = sizeFor(activeTab)
		end
	end)

	panel = new("CanvasGroup", {
		Parent = gui,
		Name = "Panel",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 40, 0, MARGIN),
		Size = DEFAULT_SIZES.Drive,
		BackgroundColor3 = C.panel,
		BackgroundTransparency = 0,
		Visible = false,
		GroupTransparency = 1,
	}, { corner(3), stroke(C.lineSoft) })

	-- header: title + status on one line, text tabs below
	local header = new("Frame", { Parent = panel, Size = UDim2.new(1, 0, 0, HEADER) })
	local brand = new("Frame", { Parent = header, Size = UDim2.new(1, -2 * PAD + 6, 0, 24), Position = UDim2.fromOffset(PAD, 12) })
	text(brand, "Car Hub", { size = 15, weight = W.bold, sizeUDim = UDim2.new(0, 90, 1, 0) })
	local status = new("Frame", { Parent = brand, Size = UDim2.new(1, -150, 1, 0), Position = UDim2.fromOffset(90, 0) }, { hlist(6) })
	statusDot = new("Frame", { Parent = status, BackgroundColor3 = C.mute, BackgroundTransparency = 0, Size = UDim2.fromOffset(6, 6), LayoutOrder = 1 }, { corner(3) })
	statusText = new("TextLabel", { Parent = status, Text = "", FontFace = font(W.medium), TextSize = 12, TextColor3 = C.mute, Size = UDim2.fromOffset(0, 24), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = 2 })
	iconButton(brand, "×", { anchor = Vector2.new(1, 0.5), position = UDim2.new(1, 0, 0.5, 0), size = UDim2.fromOffset(24, 24), textSize = 18, onClick = function()
		UI.toggle()
	end })

	local tabBar = new("Frame", { Parent = header, Size = UDim2.new(1, 0, 0, 32), Position = UDim2.fromOffset(0, HEADER - 32) })
	new("Frame", { Parent = tabBar, BackgroundColor3 = C.lineSoft, BackgroundTransparency = 0, Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 1, -1) })
	for i, name in ipairs(TAB_NAMES) do
		local b = new("TextButton", {
			Parent = tabBar,
			Text = name,
			FontFace = font(W.semibold),
			TextSize = 13,
			TextColor3 = C.mute,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(0, TAB_WIDTH, 1, -2),
			Position = UDim2.new(0, PAD + (i - 1) * TAB_WIDTH + 2, 0, 0),
			AutoButtonColor = false,
		})
		bind(b.MouseEnter, function()
			if activeTab ~= name then
				tween(b, { TextColor3 = C.dim }, 0.1)
			end
		end)
		bind(b.MouseLeave, function()
			if activeTab ~= name then
				tween(b, { TextColor3 = C.mute }, 0.16)
			end
		end)
		bind(b.Activated, function()
			selectTab(name, true)
		end)
		tabs[name] = { button = b, width = b.TextBounds.X }
	end
	tabs.indicator = new("Frame", {
		Parent = tabBar,
		BackgroundColor3 = C.accent,
		BackgroundTransparency = 0,
		Size = UDim2.fromOffset(18, 2),
		Position = UDim2.new(0, PAD + 2, 1, -2),
		ZIndex = 2,
	})

	content = new("Frame", { Parent = panel, Size = UDim2.new(1, 0, 1, -HEADER - 4), Position = UDim2.fromOffset(0, HEADER + 4), ClipsDescendants = true })
	local builders = { Drive = buildDrive, Build = buildBuild, Tune = buildTune, Link = buildLink }
	for _, name in ipairs(TAB_NAMES) do
		local frame = new("Frame", { Parent = content, Name = name, Size = UDim2.fromScale(1, 1), Visible = false })
		local refresh, tick = builders[name](frame)
		pages[name] = { frame = frame, refresh = refresh }
		if tick then
			tickers[name] = tick
		end
	end
	resizeGrip()

	overlay = new("Frame", { Parent = gui, Name = "Overlay", Size = UDim2.fromScale(1, 1), ZIndex = 50 })
	local tip = new("Frame", {
		Parent = overlay,
		BackgroundColor3 = C.raised,
		BackgroundTransparency = 0,
		Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		Visible = false,
		ZIndex = 70,
	}, { corner(3), stroke(C.line), padding(6, 9, 6, 9), new("UISizeConstraint", { MaxSize = Vector2.new(260, 400) }) })
	tooltipLabel = new("TextLabel", {
		Parent = tip,
		Text = "",
		FontFace = font(W.medium),
		TextSize = 12,
		TextColor3 = C.text,
		TextWrapped = true,
		AutomaticSize = Enum.AutomaticSize.XY,
		Size = UDim2.fromOffset(0, 0),
		ZIndex = 71,
	}, { new("UISizeConstraint", { MaxSize = Vector2.new(242, 400) }) })

	toastHost = new("Frame", {
		Parent = gui,
		Name = "Toasts",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -24),
		Size = UDim2.fromOffset(600, 200),
		ZIndex = 80,
	}, {
		new("UIListLayout", {
			FillDirection = Enum.FillDirection.Vertical,
			SortOrder = Enum.SortOrder.LayoutOrder,
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 6),
		}),
	})

	selectTab(deps.Tuning.state.ui.tab or "Drive", false)

	bind(deps.CarInit.changed.Event, function(state)
		setStatus()
		if state == "INITIALIZING" then
			UI.notify("info", deps.CarInit.message)
		elseif state == "ACTIVE" then
			UI.notify("ok", deps.CarInit.message)
		elseif state == "FAILED" then
			UI.notify("fail", deps.CarInit.message)
		elseif state == "ENDED" then
			UI.notify("info", deps.CarInit.message)
		end
	end)
	bind(deps.Connection.changed.Event, function()
		if visible and activeTab == "Link" then
			pages.Link.refresh()
		end
	end)
	local statusClock = 0
	bind(RunService:IsRunning() and RunService.RenderStepped or RunService.Heartbeat, function()
		if not visible then
			return
		end
		local tick = tickers[activeTab]
		if tick then
			tick()
		end
		local now = os.clock()
		if now - statusClock > 0.5 then
			statusClock = now
			setStatus()
		end
	end)
	setStatus()
end

function UI.select(name)
	if pages[name] then
		selectTab(name, visible)
	end
end

local panelTween
function UI.toggle()
	if not panel then
		return
	end
	visible = not visible
	if panelTween then
		panelTween:Cancel()
	end
	if closePopup then
		closePopup()
	end
	local shown = UDim2.new(1, -MARGIN, 0, MARGIN)
	local away = UDim2.new(1, 20, 0, MARGIN)
	if visible then
		panel.Visible = true
		panel.Position = away
		panel.GroupTransparency = 1
		panelTween = tween(panel, { Position = shown, GroupTransparency = 0 }, 0.3)
		local page = pages[activeTab]
		if page and page.refresh then
			page.refresh()
		end
		setStatus()
	else
		panelTween = tween(panel, { Position = away, GroupTransparency = 1 }, 0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
		panelTween.Completed:Once(function(state)
			if state == Enum.PlaybackState.Completed and not visible then
				panel.Visible = false
			end
		end)
	end
end

function UI.destroy()
	for _, link in ipairs(UI._links) do
		link:Disconnect()
	end
	table.clear(UI._links)
	if gui then
		gui:Destroy()
	end
	gui, panel, overlay, toastHost = nil, nil, nil, nil
end

return UI
