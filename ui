local function toggle(parent, value, onChange, opts)
	opts = opts or {}
	local track = new("TextButton", {
		Parent = parent,
		Text = "",
		Size = UDim2.fromOffset(34, 20),
		Position = opts.position,
		AnchorPoint = opts.anchor,
		BackgroundColor3 = value and C.accent or C.raised,
		BackgroundTransparency = 0,
		AutoButtonColor = false,
		LayoutOrder = opts.order or 0,
	}, { corner(10), stroke(C.line, value and 1 or 0) })
	local knob = new("Frame", {
		Parent = track,
		Size = UDim2.fromOffset(14, 14),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, value and 17 or 3, 0.5, 0),
		BackgroundColor3 = value and C.accentText or C.dim,
		BackgroundTransparency = 0,
	}, { corner(7) })
	local state = value
	local function render(animate)
		local t = animate and 0.2 or 0
		tween(track, { BackgroundColor3 = state and C.accent or C.raised }, t)
		tween(track:FindFirstChildOfClass("UIStroke"), { Transparency = state and 1 or 0 }, t)
		tween(knob, { Position = UDim2.new(0, state and 17 or 3, 0.5, 0), BackgroundColor3 = state and C.accentText or C.dim }, t)
	end
	bind(track.Activated, function()
		state = not state
		render(true)
		if onChange then
			onChange(state)
		end
	end)
	return {
		instance = track,
		set = function(v)
			if v ~= state then
				state = v
				render(true)
			end
		end,
	}
end

-- Segmented control with a sliding highlight.
local function segmented(parent, options, labels, value, onChange, opts)
	opts = opts or {}
	local holder = new("Frame", {
		Parent = parent,
		BackgroundColor3 = C.raised,
		BackgroundTransparency = 0,
		Size = opts.size or UDim2.new(1, 0, 0, 30),
		Position = opts.position,
		AnchorPoint = opts.anchor,
		LayoutOrder = opts.order or 0,
	}, { corner(7), padding(2) })
	local n = #options
	local highlight = new("Frame", {
		Parent = holder,
		BackgroundColor3 = C.hover,
		BackgroundTransparency = 0,
		Size = UDim2.new(1 / n, 0, 1, 0),
		ZIndex = 1,
	}, { corner(5), stroke(C.line) })
	local buttons = {}
	local current = value
	local function place(animate)
		local index = table.find(options, current)
		highlight.Visible = index ~= nil
		if index then
			local target = UDim2.new((index - 1) / n, 0, 0, 0)
			if animate then
				tween(highlight, { Position = target }, 0.24)
			else
				highlight.Position = target
			end
		end
		for i, b in ipairs(buttons) do
			tween(b, { TextColor3 = options[i] == current and C.text or C.mute }, animate and 0.18 or 0)
		end
	end
	for i, option in ipairs(options) do
		local b = new("TextButton", {
			Parent = holder,
			Text = labels and labels[i] or tostring(option),
			FontFace = font(W.semibold),
			TextSize = opts.textSize or 13,
			TextColor3 = C.mute,
			Size = UDim2.new(1 / n, 0, 1, 0),
			Position = UDim2.new((i - 1) / n, 0, 0, 0),
			ZIndex = 2,
			AutoButtonColor = false,
			TextTruncate = Enum.TextTruncate.AtEnd,
		})
		bind(b.MouseEnter, function()
			if options[i] ~= current then
				tween(b, { TextColor3 = C.dim }, 0.12)
			end
		end)
		bind(b.MouseLeave, function()
			if options[i] ~= current then
				tween(b, { TextColor3 = C.mute }, 0.18)
			end
		end)
		bind(b.Activated, function()
			if current == option then
				return
			end
			current = option
			place(true)
			if onChange then
				onChange(option)
			end
		end)
		buttons[i] = b
	end
	place(false)
	return {
		instance = holder,
		set = function(v)
			if v ~= current then
				current = v
				place(true)
			end
		end,
		-- for controls created before the handler's dependencies exist
		setHandler = function(fn)
			onChange = fn
		end,
	}
end

-- Text input with focus ring.
local function input(parent, opts)
	opts = opts or {}
	local box = new("TextBox", {
		Parent = parent,
		Text = opts.text or "",
		PlaceholderText = opts.placeholder or "",
		PlaceholderColor3 = C.faint,
		ClearTextOnFocus = false,
		FontFace = opts.mono and mono(W.medium) or font(W.medium),
		TextSize = opts.textSize or 13,
		TextColor3 = C.text,
		TextXAlignment = opts.align or Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundColor3 = C.raised,
		BackgroundTransparency = 0,
		Size = opts.size or UDim2.new(1, 0, 0, 30),
		Position = opts.position,
		AnchorPoint = opts.anchor,
		LayoutOrder = opts.order or 0,
		MultiLine = opts.multiline or false,
		TextWrapped = opts.multiline or false,
		TextYAlignment = opts.multiline and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center,
		ZIndex = opts.z or 1,
	}, { corner(6), padding(opts.multiline and 8 or 0, 9, opts.multiline and 8 or 0, 9) })
	local ring = stroke(C.line)
	ring.Parent = box
	bind(box.Focused, function()
		tween(ring, { Color = C.accent }, 0.14)
	end)
	bind(box.FocusLost, function()
		tween(ring, { Color = C.line }, 0.2)
	end)
	return box, ring
end

