	local action = button(hero, "Build car", { style = "primary", order = 2, size = UDim2.new(1, 0, 0, 38) })
	local keyHint = text(action.instance, "N", { size = 12, weight = W.bold, mono = true, color = C.accentText, align = Enum.TextXAlignment.Right, position = UDim2.new(1, -40, 0, 0), sizeUDim = UDim2.new(0, 28, 1, 0) })
	keyHint.TextTransparency = 0.45
	bind(action.instance.Activated, function()
