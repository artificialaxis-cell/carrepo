}

local function layoutGet(layout, key)
	if key == "wheelbase" then
		return layout.rearZ - layout.frontZ
	elseif key == "center" then
		return (layout.frontZ + layout.rearZ) / 2
	end
	return layout[key]
end

local function layoutSet(CarInit, layout, key, value)
	if key == "wheelbase" then
		local c = (layout.frontZ + layout.rearZ) / 2
		CarInit.setLayoutField("frontZ", c - value / 2)
		CarInit.setLayoutField("rearZ", c + value / 2)
	elseif key == "center" then
		local wb = layout.rearZ - layout.frontZ
		CarInit.setLayoutField("frontZ", value - wb / 2)
		CarInit.setLayoutField("rearZ", value + wb / 2)
	else
		CarInit.setLayoutField(key, value)
	end
end

-- Compact slider row used by both Build and Tune.
local function sliderRow(parent, opts)
	local row = new("Frame", { Parent = parent, Size = UDim2.new(1, 0, 0, 52), LayoutOrder = opts.order or 0 })
	local marker = new("Frame", {
		Parent = row,
		BackgroundColor3 = C.accent,
		BackgroundTransparency = 0,
		Size = UDim2.fromOffset(2, 14),
		Position = UDim2.fromOffset(-8, 4),
		Visible = false,
	}, { corner(1) })
	local lbl = text(row, opts.label, { size = 13, weight = W.medium, color = C.dim, sizeUDim = UDim2.new(1, -170, 0, 22) })
	attachTooltip(lbl, opts.hint)
	local unit = text(row, opts.unit or "", { size = 12, color = C.mute, align = Enum.TextXAlignment.Right, position = UDim2.new(1, -168, 0, 0), sizeUDim = UDim2.new(0, 36, 0, 22) })
	local tag = text(row, "AUTO", { size = 10, weight = W.bold, color = C.info, align = Enum.TextXAlignment.Right, position = UDim2.new(1, -208, 0, 0), sizeUDim = UDim2.new(0, 36, 0, 22), visible = false })
	local box = input(row, { mono = true, align = Enum.TextXAlignment.Right, size = UDim2.fromOffset(76, 24), position = UDim2.new(1, -126, 0, -1), textSize = 13 })
	local reset = iconButton(row, "Reset", { size = UDim2.fromOffset(42, 24), position = UDim2.new(1, -42, 0, -1), textSize = 11, visible = false })
	attachTooltip(reset, "Reset")

	local track = new("TextButton", { Parent = row, Text = "", AutoButtonColor = false, Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 28) })
	local rail = new("Frame", { Parent = track, BackgroundColor3 = C.raised, BackgroundTransparency = 0, Size = UDim2.new(1, 0, 0, 4), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0) }, { corner(2) })
	local fill = new("Frame", { Parent = rail, BackgroundColor3 = C.accent, BackgroundTransparency = 0, Size = UDim2.new(0, 0, 1, 0) }, { corner(2) })
	local knob = new("Frame", {
		Parent = track,
		BackgroundColor3 = C.text,
		BackgroundTransparency = 0,
		Size = UDim2.fromOffset(14, 14),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		ZIndex = 2,
	}, { corner(7) })
	local knobScale = new("UIScale", { Parent = knob })

	local min, max, step = opts.min, opts.max, opts.step
	local current = opts.value
	local dragging = false

	local function fraction(v)
		return math.clamp((v - min) / math.max(max - min, 1e-9), 0, 1)
	end
	local function render(v, animate)
		local f = fraction(v)
		if animate then
			tween(fill, { Size = UDim2.new(f, 0, 1, 0) }, 0.2)
			tween(knob, { Position = UDim2.new(f, 0, 0.5, 0) }, 0.2)
		else
			fill.Size = UDim2.new(f, 0, 1, 0)
			knob.Position = UDim2.new(f, 0, 0.5, 0)
		end
		if not box:IsFocused() then
			box.Text = opts.format and opts.format(v) or formatNumber(v, opts.param)
		end
	end

	local function fromX(x)
		local abs, size = rail.AbsolutePosition.X, rail.AbsoluteSize.X
		local f = math.clamp((x - abs) / math.max(size, 1), 0, 1)
		return round(min + f * (max - min), step)
	end

	bind(track.InputBegan, function(io)
		if io.UserInputType ~= Enum.UserInputType.MouseButton1 and io.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		dragging = true
		tween(knobScale, { Scale = 1.25 }, 0.12)
		local v = fromX(io.Position.X)
		current = v
		render(v, false)
		opts.onChange(v)
	end)
	bind(UserInputService.InputChanged, function(io)
		if dragging and (io.UserInputType == Enum.UserInputType.MouseMovement or io.UserInputType == Enum.UserInputType.Touch) then
			local v = fromX(io.Position.X)
			if v ~= current then
				current = v
				render(v, false)
				opts.onChange(v)
			end
		end
	end)
	bind(UserInputService.InputEnded, function(io)
		if dragging and (io.UserInputType == Enum.UserInputType.MouseButton1 or io.UserInputType == Enum.UserInputType.Touch) then
			dragging = false
			tween(knobScale, { Scale = 1 }, 0.18)
			if opts.onCommit then
				opts.onCommit(current)
			end
		end
	end)
	bind(box.FocusLost, function()
		local v = opts.parse and opts.parse(box.Text) or parseNumber(box.Text, opts.param)
		if v then
			current = v
			opts.onChange(v)
			if opts.onCommit then
				opts.onCommit(v)
			end
		end
		render(current, true)
	end)
	if opts.onReset then
		bind(reset.Activated, opts.onReset)
	end

	local api = { instance = row }
	function api.set(v, modified, auto)
		if not dragging and v ~= nil then
			current = v
			render(v, true)
		end
		reset.Visible = modified == true
		marker.Visible = modified == true
		lbl.TextColor3 = modified and C.text or C.dim
		tag.Visible = auto == true
		unit.Position = UDim2.new(1, -168, 0, 0)
	end
	render(current, false)
	return api
end

