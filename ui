	-- wide panels: viewport fills the left, controls get a fixed column on the right
	local SIDE = 360
	local function relayout()
		local width = page.AbsoluteSize.X / (gui:FindFirstChildOfClass("UIScale") and gui:FindFirstChildOfClass("UIScale").Scale or 1)
		if width >= 760 then
			view.Parent = page
			view.Size = UDim2.new(1, -SIDE - PAD * 2, 1, -12)
			view.Position = UDim2.fromOffset(PAD, 0)
			scroll.Size = UDim2.new(0, SIDE + PAD, 1, 0)
			scroll.Position = UDim2.new(1, -SIDE - PAD, 0, 0)
			local pad = scroll:FindFirstChildOfClass("UIPadding")
			pad.PaddingLeft = UDim.new(0, 0)
		else
			view.Parent = scroll
			view.Size = UDim2.new(1, 0, 0, 232)
			view.Position = UDim2.new()
			scroll.Size = UDim2.fromScale(1, 1)
			scroll.Position = UDim2.new()
			local pad = scroll:FindFirstChildOfClass("UIPadding")
			pad.PaddingLeft = UDim.new(0, PAD)
		end
	end
	bind(page:GetPropertyChangedSignal("AbsoluteSize"), relayout)
	task.defer(relayout)

	local yaw, pitch, distance = math.rad(-140), math.rad(-16), 30
	local zoomLow, zoomHigh = 8, 120
	local focus = Vector3.zero
	local function placeCamera()
		camera.CFrame = CFrame.new(focus) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0) * CFrame.new(0, 0, distance)
	end
	placeCamera()

	bind(viewport.InputBegan, function(io)
		if io.UserInputType ~= Enum.UserInputType.MouseButton1 and io.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		local last = io.Position
		local move
		move = UserInputService.InputChanged:Connect(function(change)
			if change.UserInputType == Enum.UserInputType.MouseMovement or change.UserInputType == Enum.UserInputType.Touch then
				local d = change.Position - last
				last = change.Position
				yaw -= d.X * 0.01
				pitch = math.clamp(pitch - d.Y * 0.008, -1.35, 0.3)
				placeCamera()
			end
		end)
		local ended
		ended = io.Changed:Connect(function()
			if io.UserInputState == Enum.UserInputState.End then
				move:Disconnect()
				ended:Disconnect()
			end
		end)
	end)
	bind(viewport.InputChanged, function(io)
		if io.UserInputType == Enum.UserInputType.MouseWheel then
			distance = math.clamp(distance * (1 - io.Position.Z * 0.1), zoomLow, zoomHigh)
			placeCamera()
		end
