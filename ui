		return new("Frame", { Parent = track, BackgroundColor3 = color, BackgroundTransparency = 0, Size = UDim2.new(0, 0, 1, 0) }, { corner(3) })
	end
	local thrBar = pedalBar("THROTTLE", C.good, 1)
	local brkBar = pedalBar("BRAKE", C.bad, 2)
	local cltBar = pedalBar("CLUTCH", C.info, 3)

	local lower = new("Frame", { Parent = tele, Size = UDim2.new(1, 0, 0, 96), LayoutOrder = 4 })
	local tires = new("Frame", { Parent = lower, Size = UDim2.fromOffset(64, 74) })
	local cells = {}
	for i, name in ipairs({ "FL", "FR", "RL", "RR" }) do
		local col = (i - 1) % 2
		local row = (i - 1) // 2
		cells[name] = new("Frame", {
			Parent = tires,
			BackgroundColor3 = C.raised,
			BackgroundTransparency = 0,
			Size = UDim2.fromOffset(16, 28),
			Position = UDim2.fromOffset(col * 40 + 4, row * 42 + 2),
		}, { corner(4) })
	end
	new("Frame", { Parent = tires, BackgroundColor3 = C.lineSoft, BackgroundTransparency = 0, Size = UDim2.fromOffset(20, 62), Position = UDim2.fromOffset(22, 6) }, { corner(4) })
	local stats = new("Frame", { Parent = lower, Size = UDim2.new(1, -84, 1, 0), Position = UDim2.fromOffset(84, 0) }, { vlist(2) })
	local longG = keyValue(stats, "Long. g", 1)
	local latG = keyValue(stats, "Lat. g", 2)
	local aids = keyValue(stats, "Steer", 3)
	local simCost = keyValue(stats, "Sim cost", 4)

	local idleNote = text(tele, "Telemetry appears once the car is built.", { size = 13, color = C.mute, order = 5, height = 18 })

	-- facts
	local facts = card(scroll, { order = 3 })
	vlist(4).Parent = facts
	sectionLabel(facts, "Session", 0)
	local fSource = keyValue(facts, "Loader", 1)
	local fLayout = keyValue(facts, "Layout", 2)
	local fBuild = keyValue(facts, "Build time", 3)
	local fAttempts = keyValue(facts, "Attempts", 4)
	local fTune = keyValue(facts, "Tune", 5)

	-- controls
	local controls = card(scroll, { order = 4 })
	vlist(6).Parent = controls
	sectionLabel(controls, "Controls", 0)
	local grid = new("Frame", { Parent = controls, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1 }, {
		new("UIGridLayout", { CellSize = UDim2.new(0.5, -6, 0, 26), CellPadding = UDim2.fromOffset(12, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	for i, entry in ipairs(CONTROLS) do
		local cell = new("Frame", { Parent = grid, LayoutOrder = i })
		local key = new("TextLabel", {
			Parent = cell,
			Text = entry[1],
			FontFace = mono(W.medium),
			TextSize = 11,
			TextColor3 = C.text,
			BackgroundColor3 = C.raised,
			BackgroundTransparency = 0,
			Size = UDim2.fromOffset(52, 20),
			Position = UDim2.fromOffset(0, 3),
		}, { corner(4), stroke(C.line) })
		text(cell, entry[2], { size = 12, color = C.dim, position = UDim2.fromOffset(60, 0), sizeUDim = UDim2.new(1, -60, 1, 0) })
	end

	-- log
	local logCard = card(scroll, { order = 5 })
	vlist(6).Parent = logCard
	local logOpen = Tuning.state.ui.logOpen == true
	local logToggle = new("TextButton", { Parent = nil, Text = logOpen and "Hide" or "Show", FontFace = font(W.semibold), TextSize = 12, TextColor3 = C.dim, Size = UDim2.fromOffset(44, 20) })
	sectionLabel(logCard, "Event log", 0, logToggle)
	local logBody = text(logCard, "", { size = 12, mono = true, color = C.dim, wrap = true, auto = Enum.AutomaticSize.Y, height = 0, order = 1, valign = Enum.TextYAlignment.Top, rich = true })
	logBody.Visible = logOpen
	bind(logToggle.Activated, function()
		logOpen = not logOpen
		Tuning.state.ui.logOpen = logOpen
		logToggle.Text = logOpen and "Hide" or "Show"
		logBody.Visible = logOpen
	end)

	local LOG_COLORS = { FAILED = "#E45C52", ACTIVE = "#66BE8C", INITIALIZING = "#E2B248", INFO = "#70787C" }
	local function refresh()
		local state = CarInit.state
		local meta = STATE_LABELS[state] or STATE_LABELS.IDLE
		local layout = CarInit.layout
		title.Text = CarInit.car and "Car active" or state == "ENDED" and "Car removed" or "No car"
		subtitle.Text = CarInit.message
		subtitle.TextColor3 = state == "FAILED" and C.bad or C.dim

		local canBuild = CarInit.canInitialize()
		local canRebuild = CarInit.canRebuild() and CarInit.layoutDirty
		if state == "INITIALIZING" then
			action.setText("Building…")
			action.setStyle("secondary")
			action.setEnabled(false)
			keyHint.Visible = false
		elseif canRebuild then
			action.setText("Rebuild chassis")
			action.setStyle("primary")
			action.setEnabled(true)
			keyHint.Visible = false
		elseif canBuild then
			action.setText(state == "FAILED" and "Retry build" or "Build car")
			action.setStyle("primary")
			action.setEnabled(true)
			keyHint.Visible = true
		else
			action.setText(state == "ACTIVE" and "Car is running" or "Respawn to build again")
			action.setStyle("secondary")
			action.setEnabled(false)
			keyHint.Visible = false
		end

		fSource.Text = CarInit.loader
		fLayout.Text = layout and (layout.source or "-") or "-"
		fBuild.Text = CarInit.buildMs and (CarInit.buildMs .. " ms") or "-"
		fAttempts.Text = tostring(CarInit.attempts)
		local changes = Tuning.modifiedCount()
		fTune.Text = Tuning.presetName() .. (changes > 0 and (" + " .. changes) or "")

		local lines = {}
		for i = math.max(1, #CarInit.log - 14), #CarInit.log do
			local e = CarInit.log[i]
			local color = LOG_COLORS[e.state] or "#A3A6AD"
			table.insert(lines, string.format('<font color="#707780">%6.2f</font>  <font color="%s">%s</font>', e.t, color, e.message:gsub("&", "&amp;"):gsub("<", "&lt;")))
		end
		logBody.Text = #lines > 0 and table.concat(lines, "\n") or '<font color="#707780">Nothing yet</font>'
	end

	local lastTick = 0
	local function tick()
		local now = os.clock()
		if now - lastTick < 1 / 15 then
			return
		end
		lastTick = now
		local t = CarInit.telemetry()
		local live = t ~= nil
		idleNote.Visible = not live
		top.Visible, rpmRow.Visible, pedals.Visible, lower.Visible = live, live, live, live
		if not t then
			return
		end
		speed.Text = string.format("%d", math.floor(t.kmh + 0.5))
		gear.Text = t.gear < 0 and "R" or t.gear == 0 and "N" or tostring(t.gear)
		gear.TextColor3 = t.shifting and C.mute or C.text
		local names = { MANUAL = "Manual", ASSISTED = "Assisted", AUTOMATIC = "Automatic" }
		box.Text = (names[t.gearbox] or t.gearbox) .. (t.stalled and " · stalled" or "")
		box.TextColor3 = t.stalled and C.bad or C.mute
		local maxRpm = math.max(t.redline * 1.08, 1000)
		rpmText.Text = string.format("%d rpm", math.floor(t.rpm / 10 + 0.5) * 10)
		rpmFill.Size = UDim2.new(math.clamp(t.rpm / maxRpm, 0, 1), 0, 1, 0)
		rpmFill.BackgroundColor3 = t.rpm >= t.redline * 0.97 and C.bad or C.text
		redZone.Position = UDim2.new(t.redline / maxRpm, 0, 0, 0)
		redZone.Size = UDim2.new(1 - t.redline / maxRpm, 0, 1, 0)
		thrBar.Size = UDim2.new(t.throttle, 0, 1, 0)
		brkBar.Size = UDim2.new(t.brake, 0, 1, 0)
		cltBar.Size = UDim2.new(t.clutch, 0, 1, 0)
		for name, cell in pairs(cells) do
			local s = math.clamp((t.slip[name] or 0), 0, 1.2) / 1.2
			cell.BackgroundColor3 = C.raised:Lerp(s > 0.5 and C.bad or C.warn, math.clamp(s * 1.6, 0, 1))
		end
		longG.Text = string.format("%+.2f", t.longG)
		latG.Text = string.format("%+.2f", t.latG)
		aids.Text = string.format("%+.2f%s", t.steer, t.tcs and " · TC" or "")
		simCost.Text = t.simMs and string.format("%.2f ms", t.simMs) or "-"
	end

	bind(CarInit.changed.Event, refresh)
	if CarInit.logged then
		bind(CarInit.logged.Event, function()
			if visible and activeTab == "Drive" then
				refresh()
			end
		end)
	end
	bind(CarInit.layoutChanged.Event, refresh)
	bind(Tuning.changed.Event, function()
		if activeTab == "Drive" then
			refresh()
		end
	end)
	refresh()
	return refresh, tick
end

