	local rpmTrack = new("Frame", { Parent = rpmRow, BackgroundColor3 = C.raised, BackgroundTransparency = 0, Size = UDim2.new(1, 0, 0, 8), Position = UDim2.fromOffset(0, 20) }, { corner(4) })
	local redZone = new("Frame", { Parent = rpmTrack, BackgroundColor3 = C.bad, BackgroundTransparency = 0.7, Size = UDim2.new(0.1, 0, 1, 0), Position = UDim2.new(0.9, 0, 0, 0) }, { corner(4) })
	local rpmFill = new("Frame", { Parent = rpmTrack, BackgroundColor3 = C.text, BackgroundTransparency = 0, Size = UDim2.new(0, 0, 1, 0), ZIndex = 2 }, { corner(4) })

	local pedals = new("Frame", { Parent = tele, Size = UDim2.new(1, 0, 0, 36), LayoutOrder = 3 }, { hlist(10) })
	local function pedalBar(name, color, i)
		local f = new("Frame", { Parent = pedals, Size = UDim2.new(1 / 3, -7, 1, 0), LayoutOrder = i })
		text(f, name, { size = 11, weight = W.bold, color = C.mute, height = 14 })
