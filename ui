local TOAST_COLORS = { ok = C.good, fail = C.bad, info = C.info, warn = C.warn }

function UI.notify(kind, message)
	if not toastHost then
		return
	end
	local item = new("Frame", {
		Parent = toastHost,
		BackgroundColor3 = C.surface,
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(0, 38),
		AutomaticSize = Enum.AutomaticSize.X,
		LayoutOrder = -os.clock() * 1000,
	}, { corner(8), padding(0, 14, 0, 12), hlist(10) })
	local line = item:FindFirstChildOfClass("UIListLayout")
	line.VerticalAlignment = Enum.VerticalAlignment.Center
	local s = stroke(C.line, 1)
	s.Parent = item
	local dot = new("Frame", {
		Parent = item,
		BackgroundColor3 = TOAST_COLORS[kind] or C.info,
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(8, 8),
		LayoutOrder = 1,
	}, { corner(4) })
	local lbl = new("TextLabel", {
		Parent = item,
		Text = message,
		FontFace = font(W.medium),
		TextSize = 14,
		TextColor3 = C.text,
		TextTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 38),
		LayoutOrder = 2,
	})
	local scale = new("UIScale", { Parent = item, Scale = 0.94 })
	tween(item, { BackgroundTransparency = 0 }, 0.2)
	tween(s, { Transparency = 0 }, 0.2)
	tween(dot, { BackgroundTransparency = 0 }, 0.2)
	tween(lbl, { TextTransparency = 0 }, 0.2)
	tween(scale, { Scale = 1 }, 0.26, Enum.EasingStyle.Back)

	local items = {}
	for _, child in ipairs(toastHost:GetChildren()) do
		if child:IsA("Frame") then
			table.insert(items, child)
		end
	end
	if #items > 3 then
		table.sort(items, function(a, b)
			return a.LayoutOrder > b.LayoutOrder
		end)
		items[1]:Destroy()
	end
	task.delay(3.4, function()
		if not item.Parent then
			return
		end
		tween(item, { BackgroundTransparency = 1 }, 0.25)
		tween(s, { Transparency = 1 }, 0.25)
		tween(dot, { BackgroundTransparency = 1 }, 0.25)
		tween(scale, { Scale = 0.96 }, 0.25)
		tween(lbl, { TextTransparency = 1 }, 0.25).Completed:Once(function()
			item:Destroy()
		end)
	end)
end

