local function new(class, props, parent)
	local inst = Instance.new(class)
	if inst:IsA("GuiObject") then
		inst.BorderSizePixel = 0
	end
	for key, value in pairs(props) do
		inst[key] = value
	end
	inst.Parent = parent
	return inst
end

local function text(class, props, parent)
	local base = {
		BackgroundTransparency = 1,
		TextSize = 11,
		TextColor3 = Color3.fromRGB(196, 205, 216),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}
	for key, value in pairs(props) do
		base[key] = value
	end
	local weight = base.Bold and Enum.FontWeight.Bold or Enum.FontWeight.Regular
	base.Bold = nil
	base.FontFace = Font.new(Font.fromEnum(Enum.Font.RobotoMono).Family, weight)
	return new(class, base, parent)
end

local function button(props, parent, onClick)
	local base = {
		AutoButtonColor = false,
		BackgroundTransparency = 0,
		BackgroundColor3 = Color3.fromRGB(24, 30, 39),
		BorderSizePixel = 1,
		BorderColor3 = Color3.fromRGB(48, 57, 70),
		TextXAlignment = Enum.TextXAlignment.Center,
	}
	for key, value in pairs(props) do
		base[key] = value
	end
	local btn = text("TextButton", base, parent)
	btn.MouseEnter:Connect(function()
		btn.BorderColor3 = Color3.fromRGB(98, 160, 230)
	end)
	btn.MouseLeave:Connect(function()
		btn.BorderColor3 = base.BorderColor3
	end)
	if onClick then
		btn.Activated:Connect(onClick)
	end
	return btn
end

